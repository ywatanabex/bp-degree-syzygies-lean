alias alg_incidence_projective_zero_scheme := Multigraph.incidenceProjectiveZeroScheme_comparison

/-- **`alg:incidence-vector-bundle` (zero-scheme embedding)** Proved. The independent
zero-scheme comparison preserves the actual projective embedding. -/
alias alg_incidence_projective_zero_embedding := Multigraph.incidenceProjectiveZeroIso_hom_ι

/-- **`alg:incidence-vector-bundle` (independent zero-chart pullbacks)** Proved. The
independent full quotient zero charts are actual chart base changes of the global zero scheme. -/
alias alg_incidence_projective_zero_charts := Multigraph.incidenceProjectiveZeroChart_isPullback

/-- **`alg:incidence-vector-bundle` (projective-zero global functions)** Proved. The actual
structure-sheaf global sections of the independent projective zero scheme are the original ring. -/
alias alg_projective_zero_global_sections := Multigraph.incidenceProjectiveZeroGlobalSections_comparison

