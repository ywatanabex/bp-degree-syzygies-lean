import Mathlib.Algebra.Category.ModuleCat.ProjectiveDimension
import Mathlib.CategoryTheory.Abelian.Projective.Ext
import Mathlib.LinearAlgebra.Basis.Basic
import Mathlib.RingTheory.Ideal.Operations
import Mathlib.RingTheory.Ideal.Maps

/-!
# Projective dimension from actual projective resolutions

A finite projective resolution gives Ext vanishing. A nonzero top-degree map
to the residue field that is not a boundary gives nonzero Ext. For a free
resolution whose differentials lie in a coefficient maximal ideal, the top
nonzero term therefore determines projective dimension.
-/

namespace BPFixedPoints.ResolutionTools

open CategoryTheory CategoryTheory.Limits CategoryTheory.Abelian

universe u v

section Abelian

variable {C : Type u} [Category.{v} C] [Abelian C]
variable {X : C} (P : ProjectiveResolution X)

/-- An actual projective resolution of length n gives projective dimension at most n. -/
theorem projectiveDimension_le_of_bounded (n : ℕ)
    (hbounded : ∀ i, n < i → IsZero (P.complex.X i)) :
    projectiveDimension X ≤ (n : WithBot ℕ∞) := by
  let := HasExt.standard C
  apply (projectiveDimension_le_iff X n).mpr
  apply HasProjectiveDimensionLT.mk
  intro i hi Y α
  obtain ⟨f, hf, rfl⟩ := P.extMk_surjective α (i + 1) rfl
  have hfzero : f = 0 := (hbounded i (by omega)).eq_of_src _ _
  subst f
  exact P.extMk_zero (i + 1) rfl

/-- Projective dimension of a finite projective resolution with a nonboundary nonzero top functional. -/
theorem projectiveDimension_eq_of_bounded_of_detector (n : ℕ)
    (hbounded : ∀ i, n < i → IsZero (P.complex.X i))
    (hX : ¬ IsZero X) (Y : C) (f : P.complex.X n ⟶ Y) (hf : f ≠ 0)
    (hboundary : ∀ p, p + 1 = n → ∀ g : P.complex.X p ⟶ Y,
      P.complex.d n p ≫ g = 0) :
    projectiveDimension X = (n : WithBot ℕ∞) := by
  apply le_antisymm (projectiveDimension_le_of_bounded P n hbounded)
  cases n with
  | zero => exact (projectiveDimension_ge_zero_iff X).mpr hX
  | succ n =>
    let := HasExt.standard C
    apply (projectiveDimension_ge_iff X (n + 1)).mpr
    intro hlt
    have hc : P.complex.d (n + 1 + 1) (n + 1) ≫ f = 0 :=
      (hbounded (n + 1 + 1) (by omega)).eq_of_src _ _
    have hz : P.extMk f (n + 1 + 1) rfl hc = 0 :=
      Ext.eq_zero_of_hasProjectiveDimensionLT _ (n + 1) le_rfl
    obtain ⟨g, hg⟩ := (P.extMk_eq_zero_iff f (n + 1 + 1) rfl hc n rfl).mp hz
    exact hf (hg.symm.trans (hboundary n rfl g))

end Abelian

section Modules

variable {R k : Type u} [CommRing R] [CommRing k] [Nontrivial k] [Algebra R k]

omit [Nontrivial k] in
/-- A linear map to a residue ring vanishes on the submodule generated by the kernel of the coefficient map. -/
theorem residue_linearMap_eq_zero {M : Type u} [AddCommGroup M] [Module R M]
    (f : M →ₗ[R] k) {x : M}
    (hx : x ∈ RingHom.ker (algebraMap R k) • (⊤ : Submodule R M)) : f x = 0 := by
  have hle : RingHom.ker (algebraMap R k) • (⊤ : Submodule R M) ≤ LinearMap.ker f := by
    refine Submodule.smul_le.mpr ?_
    intro a ha y _
    change f (a • y) = 0
    rw [map_smul, Algebra.smul_def, RingHom.mem_ker.mp ha, zero_mul]
  exact hle hx

/-- For a free resolution whose differentials vanish over the residue ring, the highest nonzero term determines projective dimension. -/
theorem projectiveDimension_eq_of_bounded_minimal {M : ModuleCat.{u} R} [Nontrivial M]
    (P : ProjectiveResolution M) (n : ℕ)
    (hbounded : ∀ i, n < i → IsZero (P.complex.X i))
    [Module.Free R (P.complex.X n)] [Nontrivial (P.complex.X n)]
    (hminimal : ∀ p, p + 1 = n →
      LinearMap.range (P.complex.d n p).hom ≤
        RingHom.ker (algebraMap R k) • (⊤ : Submodule R (P.complex.X p))) :
    projectiveDimension M = (n : WithBot ℕ∞) := by
  classical
  let b := Module.Free.chooseBasis R (P.complex.X n)
  let i := Classical.choice b.index_nonempty
  let f : P.complex.X n ⟶ ModuleCat.of R k :=
    ModuleCat.ofHom ((Algebra.linearMap R k).comp (b.coord i))
  have hf : f ≠ 0 := by
    intro h
    have he := congrArg (fun g : P.complex.X n ⟶ ModuleCat.of R k => g (b i)) h
    simp [f, Module.Basis.coord_apply] at he
  refine projectiveDimension_eq_of_bounded_of_detector P n hbounded ?_ _ f hf ?_
  · simpa only [ModuleCat.isZero_iff_subsingleton, not_subsingleton_iff_nontrivial]
      using (inferInstance : Nontrivial M)
  · intro p hp g
    ext x
    exact residue_linearMap_eq_zero g.hom (hminimal p hp ⟨x, rfl⟩)

end Modules

end BPFixedPoints.ResolutionTools
