import BPFixedPoints.StrongField.AnalyticDivision
import BPFixedPoints.StrongField.PowerMap

/-!
# The analytic local algebra at a state (`sf:boundary-algebra`)

This file proves the analytic content of Proposition `sf:boundary-algebra` for the state chart of
`StrongField/PowerMap.lean`, using the analytic germ algebra ℂ{w} = `analyticGerms V` and the
monomial division of `StrongField/AnalyticDivision.lean`.

**Chart coordinate w** (the Lean π of `IsPowerMapChart`). The state chart is cut out over the
parameter space by (−1)^{k_i} w_i^{r_i} − p_i, so its special fiber p = 0 has the ideal
`stateFiberIdeal G S` = (p_i) ⊂ ℂ{w} generated by the parameter germs
p_i = (−1)^{k_i} w_i^{r_i} (`powerMapGerm`). This ideal is (w_i^{r_i}) (`stateFiberIdeal_eq`), and
* `stateFiberEquiv : ℂ{w}/(p_i) ≃ₐ[ℂ] 𝓑_{S,0}` is induced by polynomial evaluation and sends w_i to
  X_i (`stateFiberEquiv_mk_coord`);
* the fiber algebra has dimension and length wt(S) (`finrank_stateFiber`, `length_stateFiber`) and
  is local for a state (`isLocalRing_stateFiber`);
* for a state, the p_i, each vertex listed once, form a regular sequence in ℂ{w}
  (`isRegular_powerMapGerm`): the special fiber is a complete intersection;
* along the i-th boundary direction t ↦ t e_i, p_i vanishes to analytic order exactly r_i
  (`analyticOrderAt_powerMap_single`).

**Vertex coordinate f = Φ(w).** For a power-map chart Φ, `IsPowerMapChart.germEquiv` is the algebra
isomorphism ℂ{f} ≃ ℂ{w}, φ ↦ φ ∘ Φ (Φ is analytic with analytic inverse and Φ(0) = 0). It maps the
ideal generated by the parameter germs p_i ∘ Φ⁻¹ (`IsPowerMapChart.vertexFiberIdeal`) onto
`stateFiberIdeal`, so `IsPowerMapChart.vertexFiberEquiv : ℂ{f}/(p_i ∘ Φ⁻¹) ≃ₐ[ℂ] 𝓑_{S,0}`, with
dimension and length wt(S) and locality. Along f = t e_i, p_i(Φ⁻¹(t e_i)) has analytic order
exactly r_i (`IsPowerMapChart.analyticOrderAt_vertexParam_single`).

Scope: the ramification index is the analytic vanishing order of p_i along one boundary direction;
no scheme-theoretic ramification theory is used. Only the special fiber p = 0 is treated here; the
free monomial basis over the convergent parameter ring ℂ{p}, used in the supplement's proof, is in
`AnalyticFamily.lean`. The regular-sequence statement is proved in the chart coordinate w, not transported to
the vertex coordinate.
-/

namespace BPFixedPoints

set_option linter.unusedSectionVars false

open Filter Topology MvPolynomial BoundaryAlgebra

namespace Multigraph

open BP

variable {V E : Type*} [DecidableEq V] [DecidableEq E] [Fintype V] [Fintype E] (G : Multigraph V E)

section StateChart

variable (S : Finset E)

/-- Each component p_i = (−1)^{k_i} w_i^{r_i} of the power map is analytic. -/
theorem analyticAt_powerMap (i : V) (π : V → ℂ) :
    AnalyticAt ℂ (fun π => G.powerMap S π i) π :=
  analyticAt_const.fun_mul ((analyticAt_coord i π).pow _)

/-- The parameter germ p_i = (−1)^{k_i} w_i^{r_i} of the state chart, in the chart coordinate
w (the Lean π of `IsPowerMapChart`). -/
noncomputable def powerMapGerm (i : V) : analyticGerms V :=
  germOf (fun π => G.powerMap S π i) (G.analyticAt_powerMap S i 0)

/-- The sign (−1)^{k_i}, as a unit of ℂ{w}. -/
noncomputable def powerMapUnit (i : V) : (analyticGerms V)ˣ :=
  Units.map (algebraMap ℂ (analyticGerms V)).toMonoidHom
    (Units.mk0 ((-1) ^ G.deg S i) (pow_ne_zero _ (neg_ne_zero.2 one_ne_zero)))

/-- p_i = (−1)^{k_i} w_i^{r_i} in ℂ{w}. -/
theorem powerMapGerm_eq (i : V) :
    G.powerMapGerm S i = (G.powerMapUnit S i : analyticGerms V) * coord i ^ G.rS S i := rfl

/-- The ideal (p_i : i ∈ V) of the special fiber p = 0 of the state chart, in the chart
coordinate w: the chart is cut out by (−1)^{k_i} w_i^{r_i} − p_i, so its fiber over p = 0 is cut
out by the germs (−1)^{k_i} w_i^{r_i}. -/
noncomputable def stateFiberIdeal : Ideal (analyticGerms V) :=
  Ideal.span (Set.range (G.powerMapGerm S))

/-- The special fiber ideal is the truncation ideal (w_i^{r_i}) of ℂ{w}. -/
theorem stateFiberIdeal_eq : G.stateFiberIdeal S = truncGermIdeal (G.rS S) := by
  rw [stateFiberIdeal, ← truncGermIdealOn_univ, ← span_image_unit_mul (G.powerMapUnit S),
    Set.image_univ]
  rfl

/-- **`sf:boundary-algebra`, analytic form.** The local algebra ℂ{w}/(p_i) of the special fiber
p = 0 of the state chart is isomorphic to 𝓑_{S,0} = ℂ[w]/(w_i^{r_i}), by an algebra isomorphism
induced by polynomial evaluation (`stateFiberEquiv_mk_coord`). -/
noncomputable def stateFiberEquiv :
    (analyticGerms V ⧸ G.stateFiberIdeal S) ≃ₐ[ℂ] G.boundaryAlgebra S :=
  (Ideal.quotientEquivAlgOfEq ℂ (G.stateFiberIdeal_eq S)).trans (truncQuotEquiv (G.rS S))

/-- The isomorphism sends the class of the coordinate germ w_i to the class of X_i. -/
theorem stateFiberEquiv_mk_coord (i : V) :
    G.stateFiberEquiv S (Ideal.Quotient.mk _ (coord i)) = Ideal.Quotient.mk _ (X i) := by
  rw [stateFiberEquiv, AlgEquiv.trans_apply, Ideal.quotientEquivAlgOfEq_mk,
    truncQuotEquiv_mk_coord]

/-- **Dimension.** The special fiber algebra has dimension wt(S). -/
theorem finrank_stateFiber :
    Module.finrank ℂ (analyticGerms V ⧸ G.stateFiberIdeal S) = G.wt phi S :=
  (G.stateFiberEquiv S).toLinearEquiv.finrank_eq.trans (G.finrank_boundaryAlgebra S)

/-- **Length.** The special fiber algebra has length wt(S) over itself. -/
theorem length_stateFiber :
    Module.length (analyticGerms V ⧸ G.stateFiberIdeal S) (analyticGerms V ⧸ G.stateFiberIdeal S) =
      G.wt phi S := by
  rw [← G.length_boundaryAlgebra S]
  exact length_self_eq_of_ringEquiv (G.stateFiberEquiv S).toRingEquiv

/-- **Local ring.** For a state, the special fiber algebra is local. -/
theorem isLocalRing_stateFiber (hS : IsState G S) :
    IsLocalRing (analyticGerms V ⧸ G.stateFiberIdeal S) := by
  have := G.isLocalRing_boundaryAlgebra S hS
  have : Nontrivial (analyticGerms V ⧸ G.stateFiberIdeal S) :=
    (G.stateFiberEquiv S).symm.injective.nontrivial
  exact IsLocalRing.of_surjective' (G.stateFiberEquiv S).symm.toRingEquiv.toRingHom
    (G.stateFiberEquiv S).symm.toRingEquiv.surjective

/-- **Complete intersection.** For a state, the parameter germs p_i = (−1)^{k_i} w_i^{r_i}, each
vertex listed once, form a regular sequence in ℂ{w}; they generate the special fiber ideal by
definition. -/
theorem isRegular_powerMapGerm (hS : IsState G S) :
    RingTheory.Sequence.IsRegular (analyticGerms V)
      ((Finset.univ : Finset V).toList.map (G.powerMapGerm S)) :=
  isRegular_unit_mul_coord_pow (G.powerMapUnit S) (G.rS_pos S hS) (Finset.nodup_toList _)

/-- **Ramification index (`sf:boundary-algebra`).** Along the i-th boundary direction t ↦ t e_i of
the chart coordinate, the i-th parameter p_i = (−1)^{k_i} t^{r_i} vanishes to analytic order
exactly r_i at t = 0. -/
theorem analyticOrderAt_powerMap_single (i : V) :
    analyticOrderAt (fun t : ℂ => G.powerMap S (Pi.single i t) i) 0 = G.rS S i := by
  have ha : AnalyticAt ℂ (fun t : ℂ => G.powerMap S (Pi.single i t) i) 0 := by
    simp only [powerMap, Pi.single_eq_same]
    exact analyticAt_const.fun_mul (analyticAt_id.pow _)
  rw [ha.analyticOrderAt_eq_natCast]
  refine ⟨fun _ => (-1) ^ G.deg S i, analyticAt_const,
    pow_ne_zero _ (neg_ne_zero.2 one_ne_zero), Eventually.of_forall fun t => ?_⟩
  simp [powerMap, mul_comm]

end StateChart

section PowerMapChart

variable {G} {S : Finset E} {a : E → ℂ} {ω : V → ℂ} {Q : (V → ℂ) → Dart E → ℂ}
  {W : (V → ℂ) → V → ℂ} {Φ : OpenPartialHomeomorph (V → ℂ) (V → ℂ)}

/-- The origin lies in the target of a power-map chart. -/
theorem IsPowerMapChart.zero_mem_target (hc : G.IsPowerMapChart S a ω Q W Φ) :
    (0 : V → ℂ) ∈ Φ.target := by
  have h := Φ.map_source hc.zero_mem
  rwa [hc.map_zero] at h

/-- The inverse chart fixes the origin. -/
theorem IsPowerMapChart.symm_zero (hc : G.IsPowerMapChart S a ω Q W Φ) : Φ.symm 0 = 0 := by
  have h := Φ.left_inv hc.zero_mem
  rwa [hc.map_zero] at h

/-- The chart is analytic at the origin. -/
theorem IsPowerMapChart.analyticAt_zero (hc : G.IsPowerMapChart S a ω Q W Φ) :
    AnalyticAt ℂ Φ 0 :=
  hc.analyticOnNhd 0 hc.zero_mem

/-- The inverse chart is analytic at the origin. -/
theorem IsPowerMapChart.analyticAt_symm_zero (hc : G.IsPowerMapChart S a ω Q W Φ) :
    AnalyticAt ℂ Φ.symm 0 :=
  hc.analyticOnNhd_symm 0 hc.zero_mem_target

/-- **Analytic coordinate change on germs.** A power-map chart π ↦ f = Φ(π) induces the algebra
isomorphism ℂ{f} ≃ ℂ{w}, φ ↦ φ ∘ Φ, from germs in the vertex coordinate to germs in the chart
coordinate. -/
noncomputable def IsPowerMapChart.germEquiv (hc : G.IsPowerMapChart S a ω Q W Φ) :
    analyticGerms V ≃ₐ[ℂ] analyticGerms V :=
  pullbackEquiv hc.analyticAt_zero hc.analyticAt_symm_zero hc.map_zero hc.symm_zero
    (Φ.eventually_left_inverse hc.zero_mem) (Φ.eventually_right_inverse hc.zero_mem_target)

/-- The parameter germ p_i ∘ Φ⁻¹ in the vertex coordinate f. -/
noncomputable def IsPowerMapChart.vertexParamGerm (hc : G.IsPowerMapChart S a ω Q W Φ) (i : V) :
    analyticGerms V :=
  germOf (fun f => G.powerMap S (Φ.symm f) i)
    (analyticAt_comp_zero (G.analyticAt_powerMap S i 0) hc.analyticAt_symm_zero hc.symm_zero)

/-- The ideal (p_i : i ∈ V) of the special fiber p = 0, in the vertex coordinate f. -/
noncomputable def IsPowerMapChart.vertexFiberIdeal (hc : G.IsPowerMapChart S a ω Q W Φ) :
    Ideal (analyticGerms V) :=
  Ideal.span (Set.range hc.vertexParamGerm)

/-- The coordinate change sends the vertex-coordinate parameter germs to the chart ones. -/
theorem IsPowerMapChart.germEquiv_vertexParamGerm (hc : G.IsPowerMapChart S a ω Q W Φ) (i : V) :
    hc.germEquiv (hc.vertexParamGerm i) = G.powerMapGerm S i := by
  rw [IsPowerMapChart.germEquiv, pullbackEquiv_apply, IsPowerMapChart.vertexParamGerm,
    pullback_germOf, powerMapGerm, germOf_eq_iff]
  filter_upwards [Φ.eventually_left_inverse hc.zero_mem] with π hπ
  rw [hπ]

/-- The coordinate change maps the vertex-coordinate fiber ideal onto the chart one. -/
theorem IsPowerMapChart.map_vertexFiberIdeal (hc : G.IsPowerMapChart S a ω Q W Φ) :
    hc.vertexFiberIdeal.map (hc.germEquiv : analyticGerms V →+* analyticGerms V) =
      G.stateFiberIdeal S := by
  have h : (hc.germEquiv : analyticGerms V → analyticGerms V) ∘ hc.vertexParamGerm =
      G.powerMapGerm S := funext hc.germEquiv_vertexParamGerm
  rw [IsPowerMapChart.vertexFiberIdeal, Ideal.map_span, ← Set.range_comp, stateFiberIdeal]
  exact congrArg (fun s => Ideal.span (Set.range s)) h

/-- **`sf:boundary-algebra` in vertex coordinates.** For a power-map chart, the local algebra
ℂ{f}/(p_i ∘ Φ⁻¹) of the special fiber p = 0 in the vertex coordinate f is isomorphic to
𝓑_{S,0} = ℂ[w]/(w_i^{r_i}). -/
noncomputable def IsPowerMapChart.vertexFiberEquiv (hc : G.IsPowerMapChart S a ω Q W Φ) :
    (analyticGerms V ⧸ hc.vertexFiberIdeal) ≃ₐ[ℂ] G.boundaryAlgebra S :=
  (Ideal.quotientEquivAlg _ _ hc.germEquiv hc.map_vertexFiberIdeal.symm).trans
    (G.stateFiberEquiv S)

/-- **Dimension in vertex coordinates.** -/
theorem IsPowerMapChart.finrank_vertexFiber (hc : G.IsPowerMapChart S a ω Q W Φ) :
    Module.finrank ℂ (analyticGerms V ⧸ hc.vertexFiberIdeal) = G.wt phi S :=
  hc.vertexFiberEquiv.toLinearEquiv.finrank_eq.trans (G.finrank_boundaryAlgebra S)

/-- **Length in vertex coordinates.** -/
theorem IsPowerMapChart.length_vertexFiber (hc : G.IsPowerMapChart S a ω Q W Φ) :
    Module.length (analyticGerms V ⧸ hc.vertexFiberIdeal) (analyticGerms V ⧸ hc.vertexFiberIdeal) =
      G.wt phi S := by
  rw [← G.length_boundaryAlgebra S]
  exact length_self_eq_of_ringEquiv hc.vertexFiberEquiv.toRingEquiv

/-- **Local ring in vertex coordinates.** -/
theorem IsPowerMapChart.isLocalRing_vertexFiber (hS : IsState G S)
    (hc : G.IsPowerMapChart S a ω Q W Φ) : IsLocalRing (analyticGerms V ⧸ hc.vertexFiberIdeal) := by
  have := G.isLocalRing_boundaryAlgebra S hS
  have : Nontrivial (analyticGerms V ⧸ hc.vertexFiberIdeal) :=
    hc.vertexFiberEquiv.symm.injective.nontrivial
  exact IsLocalRing.of_surjective' hc.vertexFiberEquiv.symm.toRingEquiv.toRingHom
    hc.vertexFiberEquiv.symm.toRingEquiv.surjective

/-- **Ramification index in vertex coordinates.** Along the i-th boundary direction t ↦ t e_i of
the vertex coordinate f, the parameter p_i(Φ⁻¹(t e_i)) vanishes to analytic order exactly r_i at
t = 0. The i-th coordinate of Φ⁻¹(t e_i) vanishes to order 1, since the derivative of Φ⁻¹ at 0 is
diag(ω)⁻¹. -/
theorem IsPowerMapChart.analyticOrderAt_vertexParam_single (hc : G.IsPowerMapChart S a ω Q W Φ)
    (i : V) :
    analyticOrderAt (fun t : ℂ => G.powerMap S (Φ.symm (Pi.single i t)) i) 0 = G.rS S i := by
  have hω : ∀ j, ω j ≠ 0 := fun j => by
    have := hc.W_ne 0 hc.zero_mem j
    rwa [hc.W_zero] at this
  have hd : HasFDerivAt Φ.symm ((diagEquiv ω hω).symm : (V → ℂ) →L[ℂ] (V → ℂ)) 0 := by
    refine HasFDerivAt.of_local_left_inverse hc.analyticAt_symm_zero.continuousAt ?_
      (Φ.eventually_right_inverse hc.zero_mem_target)
    rw [hc.symm_zero, coe_diagEquiv]
    exact hc.hasFDerivAt
  set L := ContinuousLinearMap.single ℂ (fun _ : V => ℂ) i with hL
  have hL0 : L 0 = 0 := _root_.map_zero L
  have hd' : HasFDerivAt Φ.symm ((diagEquiv ω hω).symm : (V → ℂ) →L[ℂ] (V → ℂ)) (L 0) := by
    rwa [hL0]
  have hcomp : HasDerivAt (fun t : ℂ => Φ.symm (L t)) ((diagEquiv ω hω).symm (L 1)) 0 :=
    hd'.comp_hasDerivAt 0 L.hasDerivAt
  have hh : HasDerivAt (fun t : ℂ => Φ.symm (L t) i) (ω i)⁻¹ 0 := by
    have h2 := (hasFDerivAt_apply (𝕜 := ℂ) (F' := fun _ : V => ℂ) i
      (Φ.symm (L 0))).comp_hasDerivAt 0 hcomp
    refine h2.congr_deriv ?_
    simp [hL, diagEquiv, diagCLM_apply]
  have hha : AnalyticAt ℂ (fun t : ℂ => Φ.symm (L t) i) 0 := by
    have h1 : AnalyticAt ℂ (fun t : ℂ => Φ.symm (L t)) 0 :=
      hc.analyticAt_symm_zero.comp_of_eq (L.analyticAt 0) hL0
    exact (ContinuousLinearMap.proj (R := ℂ) (φ := fun _ : V => ℂ) i).analyticAt _ |>.comp h1
  have hh0 : Φ.symm (L 0) i = 0 := by rw [hL0, hc.symm_zero]; rfl
  have hord : analyticOrderAt (fun t : ℂ => Φ.symm (L t) i) 0 = (1 : ℕ) :=
    hha.analyticOrderAt_eq_one_of_zero_deriv_ne_zero hh0
      (by rw [hh.deriv]; exact inv_ne_zero (hω i))
  obtain ⟨g, hga, hg0, hgh⟩ := hha.analyticOrderAt_eq_natCast.1 hord
  have hfa : AnalyticAt ℂ (fun t : ℂ => G.powerMap S (Φ.symm (Pi.single i t)) i) 0 :=
    analyticAt_const.fun_mul (hha.pow _)
  rw [hfa.analyticOrderAt_eq_natCast]
  refine ⟨fun t => (-1) ^ G.deg S i * g t ^ G.rS S i, analyticAt_const.fun_mul (hga.pow _),
    mul_ne_zero (pow_ne_zero _ (neg_ne_zero.2 one_ne_zero)) (pow_ne_zero _ hg0), ?_⟩
  filter_upwards [hgh] with t ht
  change (-1) ^ G.deg S i * Φ.symm (L t) i ^ G.rS S i = _
  rw [ht, sub_zero, pow_one, smul_eq_mul, smul_eq_mul, mul_pow]
  ring

end PowerMapChart

end Multigraph

end BPFixedPoints
