import Mathlib.RingTheory.AlgebraicIndependent.TranscendenceBasis
import Mathlib.RingTheory.Ideal.MinimalPrime.Noetherian
import Mathlib.RingTheory.Localization.Away.Basic
import Mathlib.RingTheory.Polynomial.Basic

/-!
# Algebraic dependence from a dimension count, uniformly over all points

This file contains the commutative algebra behind the generic statements of
`supp:nonnormalizable-dim`.

* `exists_ne_zero_aeval_eq_zero_of_isAlgebraic`: in a domain D that is algebraic over the
  ℤ-subalgebra generated by κ-indexed elements, every family indexed by ι with |κ| < |ι| is
  algebraically dependent over ℤ (transcendence degree count).
* `isAlgebraic_of_surjective_localizationAway`: a domain D receiving a surjection from
  ℤ[X_σ][1/den] is algebraic over a subalgebra once the images of the variables are.
* `exists_poly_forall_ringHom_eq_zero`: if R is Noetherian and every prime quotient of R is
  algebraic over the subalgebra generated by the images of t : κ → R, then any f : ι → R with
  |κ| < |ι| satisfies a nonzero integer polynomial relation P(ψ ∘ f) = 0 after *every* ring
  homomorphism ψ from R to a domain. The proof takes one relation on each of the finitely many
  irreducible components (minimal primes) and multiplies them.

In geometric language: the image of an algebraic set of dimension < |ι| under |ι| polynomial
functions lies in a hypersurface P = 0, with P independent of the point.
-/

namespace BPFixedPoints

open MvPolynomial Cardinal

universe u u₁ u₂

/-- In a domain algebraic over the subalgebra generated by κ-indexed elements, any family
indexed by ι with |κ| < |ι| is algebraically dependent over ℤ. -/
theorem exists_ne_zero_aeval_eq_zero_of_isAlgebraic {D : Type u} [CommRing D] [NoZeroDivisors D]
    [Algebra ℤ D] {ι : Type u₁} {κ : Type u₂} [Fintype ι] [Fintype κ] (t : κ → D) (f : ι → D)
    (halg : Algebra.IsAlgebraic (Algebra.adjoin ℤ (Set.range t)) D)
    (hcard : Fintype.card κ < Fintype.card ι) :
    ∃ P : MvPolynomial ι ℤ, P ≠ 0 ∧ aeval f P = 0 := by
  by_contra h
  push Not at h
  have hind : AlgebraicIndependent ℤ f := by
    rw [algebraicIndependent_iff]
    intro P hP
    by_contra hne
    exact h P hne hP
  have h1 := hind.lift_cardinalMk_le_trdeg
  have h2 := Algebra.IsAlgebraic.trdeg_le_cardinalMk ℤ (Set.range t) (A := D)
  have h3 : lift.{u₂} #(Set.range t) ≤ lift.{u} #κ := Cardinal.mk_range_le_lift
  rw [Cardinal.mk_fintype κ, Cardinal.lift_natCast, Cardinal.lift_le_nat_iff] at h3
  rw [Cardinal.mk_fintype ι, Cardinal.lift_natCast] at h1
  have h4 : lift.{u₁} (Algebra.trdeg ℤ D) ≤ (Fintype.card κ : Cardinal) :=
    Cardinal.lift_le_nat_iff.mpr (h2.trans h3)
  have h5 := h1.trans h4
  rw [Nat.cast_le] at h5
  omega

/-- A domain receiving a surjection from ℤ[X_σ][1/den] is algebraic over a subalgebra
`adjoin ℤ s` as soon as the images of all variables are algebraic over it. -/
theorem isAlgebraic_of_surjective_localizationAway {σ : Type*} {den : MvPolynomial σ ℤ}
    {D : Type*} [CommRing D] [IsDomain D] [Algebra ℤ D] (g : Localization.Away den →+* D)
    (hg : Function.Surjective g) (s : Set D)
    (hX : ∀ z, IsAlgebraic (Algebra.adjoin ℤ s)
      (g (algebraMap (MvPolynomial σ ℤ) (Localization.Away den) (X z)))) :
    Algebra.IsAlgebraic (Algebra.adjoin ℤ s) D := by
  set A0 := Algebra.adjoin ℤ s
  let T := Subalgebra.algebraicClosure A0 D
  set φ0 := g.comp (algebraMap (MvPolynomial σ ℤ) (Localization.Away den))
  have hpoly : ∀ p : MvPolynomial σ ℤ, φ0 p ∈ T := by
    intro p
    induction p using MvPolynomial.induction_on with
    | C n =>
      have : φ0 (C n) = algebraMap A0 D (n : A0) := by
        simp only [φ0, map_intCast, eq_intCast]
      rw [this]
      exact T.algebraMap_mem _
    | add p q hp hq => rw [map_add]; exact T.add_mem hp hq
    | mul_X p z hp => rw [map_mul]; exact T.mul_mem hp (hX z)
  have hu : IsUnit (φ0 den) :=
    (IsLocalization.Away.algebraMap_isUnit den).map g
  let _ : Invertible (φ0 den) := hu.invertible
  have hinv : ⅟(φ0 den) ∈ T := (hpoly den : IsAlgebraic A0 (φ0 den)).invOf
  refine ⟨fun y => ?_⟩
  obtain ⟨z, rfl⟩ := hg y
  obtain ⟨n, p, hn⟩ := IsLocalization.Away.surj den z
  have hz : g z = φ0 p * (⅟(φ0 den)) ^ n := by
    have := congrArg g hn
    rw [map_mul, map_pow] at this
    change g z * φ0 den ^ n = φ0 p at this
    rw [← this, mul_assoc, ← mul_pow, mul_invOf_self, one_pow, mul_one]
  change g z ∈ T
  rw [hz]
  exact T.mul_mem (hpoly p) (T.pow_mem hinv n)

/-- Ring homomorphisms commute with evaluation of integer polynomials (for any ℤ-algebra
structures). -/
theorem ringHom_aeval_int {R L : Type*} [CommRing R] [CommRing L] [Algebra ℤ R] [Algebra ℤ L]
    (ψ : R →+* L) {ι : Type*} (f : ι → R) (Q : MvPolynomial ι ℤ) :
    ψ (aeval f Q) = aeval (ψ ∘ f) Q := by
  induction Q using MvPolynomial.induction_on with
  | C n => simp only [eq_intCast, map_intCast]
  | add p q hp hq => rw [map_add, map_add, map_add, hp, hq]
  | mul_X p z hp => rw [map_mul, map_mul, map_mul, hp, aeval_X, aeval_X, Function.comp_apply]

/-- **Uniform algebraic dependence.** Let R be Noetherian, t : κ → R and f : ι → R with
|κ| < |ι|, and suppose every prime quotient R/p is algebraic over the subalgebra generated by the
image of t. Then some nonzero P ∈ ℤ[X_ι] satisfies P(ψ ∘ f) = 0 for every ring homomorphism ψ
from R to a domain. -/
theorem exists_poly_forall_ringHom_eq_zero {R : Type u} [CommRing R] [IsNoetherianRing R]
    [Algebra ℤ R] {ι : Type u₁} {κ : Type u₂} [Fintype ι] [Fintype κ] (t : κ → R) (f : ι → R)
    (hcard : Fintype.card κ < Fintype.card ι)
    (halg : ∀ (p : Ideal R) [p.IsPrime],
      Algebra.IsAlgebraic (Algebra.adjoin ℤ (Set.range (Ideal.Quotient.mk p ∘ t))) (R ⧸ p)) :
    ∃ P : MvPolynomial ι ℤ, P ≠ 0 ∧
      ∀ (L : Type*) [CommRing L] [IsDomain L] [Algebra ℤ L] (ψ : R →+* L),
        aeval (ψ ∘ f) P = 0 := by
  classical
  have hfin : (minimalPrimes R).Finite := minimalPrimes.finite_of_isNoetherianRing R
  have hrel : ∀ p ∈ minimalPrimes R, ∃ P : MvPolynomial ι ℤ, P ≠ 0 ∧ aeval f P ∈ p := by
    intro p hp
    have : p.IsPrime := hp.isPrime
    obtain ⟨P, hP, hPf⟩ := exists_ne_zero_aeval_eq_zero_of_isAlgebraic
      (Ideal.Quotient.mk p ∘ t) (Ideal.Quotient.mk p ∘ f) (halg p) hcard
    refine ⟨P, hP, ?_⟩
    rw [← Ideal.Quotient.eq_zero_iff_mem, ringHom_aeval_int]
    exact hPf
  choose! Pp hPp using hrel
  refine ⟨∏ p ∈ hfin.toFinset, Pp p, ?_, ?_⟩
  · rw [Finset.prod_ne_zero_iff]
    intro p hp
    exact (hPp p (hfin.mem_toFinset.mp hp)).1
  · intro L _ _ _ ψ
    have : (RingHom.ker ψ).IsPrime := RingHom.ker_isPrime ψ
    obtain ⟨p, hp, hle⟩ := Ideal.exists_minimalPrimes_le (bot_le : ⊥ ≤ RingHom.ker ψ)
    have hp' : p ∈ minimalPrimes R := hp
    rw [← ringHom_aeval_int, map_prod, map_prod]
    apply Finset.prod_eq_zero (hfin.mem_toFinset.mpr hp')
    exact hle (hPp p hp').2
