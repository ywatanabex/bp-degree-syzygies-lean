import BPFixedPoints.Incidence.DimensionTools
import BPFixedPoints.Incidence.DimensionUpper
import BPFixedPoints.Incidence.DimensionLower
import BPFixedPoints.Incidence.Finite

/-!
# Krull dimension of the universal incidence ring

Contain the coefficient image in a subalgebra generated by d_G elements.
Conversely Hall matching and the inverse function theorem produce d_G
algebraically independent coefficients. Finiteness over the coefficient ring
and Noether normalization convert transcendence degree to Krull dimension.
-/

namespace BPFixedPoints.Multigraph

open MvPolynomial

variable {V E : Type} [DecidableEq V] [Fintype V] [DecidableEq E] [Fintype E]
variable (G : Multigraph V E)

/-- Coefficients selected by the matching remain algebraically independent in the incidence ring. -/
theorem incidenceCoefficients_algebraicIndependent :
    AlgebraicIndependent ℂ
      (fun i : G.IncIndependentVar => G.coeffHom (X (G.incIndependentCoeff i))) := by
  apply AlgebraicIndependent.of_comp G.incidenceToFree
  convert G.incIndependentFamily_algebraicIndependent using 1
  funext i
  rw [G.incIndependentFamily_eq_coeff i]
  exact G.incidenceToFree_coeffHom_X (G.incIndependentCoeff i).1
    (G.incIndependentCoeff i).2.1 (G.incIndependentCoeff i).2.2

theorem trdeg_incidenceRing_eq : Algebra.trdeg ℂ G.IncidenceRing = (G.dG : Cardinal) := by
  apply le_antisymm G.trdeg_incidenceRing_le
  have h := G.incidenceCoefficients_algebraicIndependent.cardinalMk_le_trdeg
  simpa only [Cardinal.mk_fintype, G.card_incIndependentVar] using h

/-- dim 𝒰_G = d_G = 3m + n − τ。 -/
theorem incidenceRing_krullDim :
    ringKrullDim G.IncidenceRing = (G.dG : WithBot ℕ∞) := by
  let := G.coeffHom.toRingHom.toAlgebra
  have : IsScalarTower ℂ (IncCoeffRing E) G.IncidenceRing :=
    IsScalarTower.of_algHom G.coeffHom
  have : Algebra.FiniteType (IncCoeffRing E) G.IncidenceRing :=
    G.coeffHom_finite.finiteType
  have : Algebra.FiniteType ℂ G.IncidenceRing :=
    Algebra.FiniteType.trans (R := ℂ) (S := IncCoeffRing E) (A := G.IncidenceRing)
      inferInstance inferInstance
  have : IsDomain G.IncidenceRing := G.incidenceRing_isDomain
  rw [ringKrullDim_eq_trdeg_toNat ℂ G.IncidenceRing, G.trdeg_incidenceRing_eq,
    Cardinal.toNat_natCast]

end BPFixedPoints.Multigraph
