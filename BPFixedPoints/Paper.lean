/-! ## §5 Real sign sectors and the minimum real count -/

/-- **`real:sign-sectors`** Proved. For an admissible real solution with a, b > 0, every total
field satisfies F_i > 0, the two messages of an edge have the same sign, and the set of edges
with negative messages is Eulerian. -/
alias real_sign_sectors := Multigraph.real_sign_sectors

/-- **`real:edge-branches`** Proved, with `real_edge_branches_analytic`. Given F_i, F_j > 0, the positive branch `posMsg` and
the negative branch −F/`posMsg` are proved to satisfy the edge equations and the product
identity y⁺y⁻ = −F_i (`real:edge-product`). Uniqueness under the lemma's hypotheses and
smoothness are also proved in `Real/EdgeBranches.lean`; real analyticity and invertibility
of the edge Jacobian are `real_edge_branches_analytic`. -/
theorem real_edge_branches {a Fh Ft : ℝ} (ha : 0 < a) (hFh : 0 < Fh) (hFt : 0 < Ft) :
    (posMsg a Fh Ft * (Ft + a * posMsg a Ft Fh) = a * Ft + posMsg a Ft Fh ∧
      posMsg a Ft Fh * (Fh + a * posMsg a Fh Ft) = a * Fh + posMsg a Fh Ft) ∧
    ((-Fh / posMsg a Fh Ft) * (Ft + a * (-Ft / posMsg a Ft Fh)) = a * Ft + (-Ft / posMsg a Ft Fh) ∧
      (-Ft / posMsg a Ft Fh) * (Fh + a * (-Fh / posMsg a Fh Ft)) =
        a * Fh + (-Fh / posMsg a Fh Ft)) ∧
    0 < posMsg a Fh Ft ∧ posMsg a Fh Ft * (-Fh / posMsg a Fh Ft) = -Fh := by
  refine ⟨posMsg_edge ha hFh hFt, negMsg_edge ha hFh hFt, posMsg_pos ha hFh hFt, ?_⟩
  rw [mul_div_assoc', mul_comm, mul_div_assoc, div_self (posMsg_pos ha hFh hFt).ne', mul_one]

/-- **`real:edge-branches` (uniqueness of the branches)** Proved. A solution with positive
(negative) messages lies on the positive (negative) branch. -/
alias real_edge_branches_unique_pos := BP.eq_posMsg_of_pos

/-- **`real:edge-branches` (uniqueness of the negative branch)** Proved. A solution with negative
messages lies on the negative branch. -/
alias real_edge_branches_unique_neg := BP.eq_negMsg_of_neg

/-- **(`real:edge-bound`)** Proved (strict form). For a_e ≠ 1, |z⁺| < |J_e| = |½ log a_e|; the
non-strict bound for every a_e > 0 is `BP.abs_zPlus_le`. -/
alias real_edge_bound := BP.abs_zPlus_lt

/-- **`real:vertex-map`** Proved, with `real_vertex_map_analytic`. A solution of
𝔥_S(u) = h gives an admissible real solution (`isAdmissibleSolution_sectorMsg`, with negative
edge set S by `negSupport_sectorMsg`), and conversely every admissible real solution is of this
form (`eq_sectorMsg`). That nondegeneracy of the BP system implies nondegeneracy of the vertex
map is `det_fderiv_sectorField_ne_zero`. The local real-analytic equivalence and the converse
direction of nondegeneracy are `real_vertex_map_analytic` and `real_vertex_map_nondegeneracy`. -/
alias real_vertex_map := Multigraph.eq_sectorMsg

/-- **(`real:global-box`)** Proved. -/
alias real_global_box := Multigraph.abs_sub_le_of_sectorField_eq

/-- **`real:sector-degree`** Proved (bounds). The solutions of 𝔥_S(u) = h are bounded. The degree
value is `real_sector_degree`. -/
alias real_sector_degree_bounded := Multigraph.abs_le_of_sectorField_eq

/-- **`real:sector-degree`, `real:degree`** Proved. For a_e > 0 and no vertex of S-degree one (in
particular for Eulerian S), the Brouwer degree of the vertex map 𝔥_S is (−1)^{v(S)}. The degree
is `brouwerDegree`, the signed count of preimages at a regular value; it agrees with the
determinant-integral degree (`proper_degree_integral`). -/
alias real_sector_degree := Multigraph.brouwerDegree_sectorField

/-- **`real:sector-degree`** Proved (Eulerian sectors). -/
alias real_sector_degree_even := Multigraph.brouwerDegree_sectorField_of_isEvenSet

/-- **`real:degree`** Proved (integral form). For every continuous compactly supported ψ,
∫ ψ(𝔥_S u) det D𝔥_S(u) du = (−1)^{v(S)} ∫ ψ, at regular and critical values alike. -/
alias real_sector_degree_integral := Multigraph.integral_sectorField_mul_det

/-- **`real:degree`** Proved (signed count). At every regular value h, the preimages of h under 𝔥_S,
counted with the sign of the Jacobian determinant of 𝔥_S, sum to (−1)^{v(S)}. -/
alias real_sector_signed_count := Multigraph.signedFiberCount_sectorField

/-- **`real:sector-degree`** Proved (homotopy). Every map of the homotopy H_t = D_S − tΨ_S from the
invertible diagonal part to 𝔥_S has degree (−1)^{v(S)}. -/
alias real_sector_degree_homotopy := Multigraph.brouwerDegree_sectorHomotopy

/-- **`real:sector-degree`** Proved. 𝔥_S is proper. -/
alias real_sector_proper := Multigraph.isCompact_preimage_sectorField

/-- **`real:sector-degree`** Proved (the paper's route to existence). 𝔥_S is surjective because its
degree is nonzero. -/
alias real_sector_surjective_of_degree := Multigraph.surjective_sectorField

/-- **Degree theory** Proved. For a proper C¹ map at bounded distance from an invertible linear map,
∫ ψ(f x) det Df(x) dx = deg f · ∫ ψ for every continuous compactly supported ψ. -/
alias proper_degree_integral := integral_comp_mul_det_eq_brouwerDegree_mul

/-- **Degree theory** Proved. The degree of an invertible linear map is the sign of its
determinant. -/
alias proper_degree_linear := brouwerDegree_continuousLinearEquiv

/-- **Degree theory** Proved. For a C¹ map at bounded distance from an invertible linear map, the
signed count at every regular value equals the degree. -/
alias proper_degree_regular_value := signedFiberCount_eq_brouwerDegree_of_bounded

/-- **`real:sector-parity`** Proved. If every root in an Eulerian sign sector is nondegenerate,
the set of roots is finite and of odd cardinality, by a determinant integral and the inverse
function theorem. -/
alias real_sector_parity := Multigraph.sector_count_odd

/-- **`real:sector-parity` (positive roots)** Proved. If every positive root is nondegenerate,
their number is odd. -/
alias real_positive_parity := Multigraph.positive_count_odd

/-- **`real:strong-field-count`** Proved: `thm_real_ii_strong`, and one root per sector
(`card_sector_strong_field`). -/
alias real_strong_field_count := Multigraph.card_sector_strong_field

/-- **`real:all-real-states`** Partial (the combinatorial part is proved). wt(S) = 1 iff every
degree is 0 or 2 (generator states); wt(S) is odd iff S is Eulerian; an Eulerian state with a vertex of degree at
least 4 has wt ≥ 3. At strong field each Eulerian sector has exactly one real root
(`card_sector_strong_field`). The real count per chart state is `real_all_real_states_chart_counts`. -/
theorem real_all_real_states (S : Finset E) :
    (G.wt phi S = 1 ↔ G.IsCycleUnion S) ∧ (Odd (G.wt phi S) ↔ G.IsEvenSet S) ∧
      (G.IsEvenSet S → ∀ v, 4 ≤ G.deg S v → 3 ≤ G.wt phi S) :=
  ⟨G.wt_eq_one_iff S, G.odd_wt_iff S, fun hS _ hv => G.three_le_wt hS hv⟩

/-- **`real:positive-bound`** Proved. For generically finite étale physical parameters,
2^ν ≤ R ≤ Q and 1 ≤ N₊ ≤ Q − 2^ν + 1 (`real_positive_budget`, with 2^ν = #H₁), and
R ≡ Q (`card_real_admissible_modEq_Q`) ≡ 2^ν (mod 2) (`Q_modEq_two_pow_nu`). -/
theorem real_positive_bound (hG : G.Loopless) :
    ∃ P : MvPolynomial (E ⊕ V) ℤ, P ≠ 0 ∧
      ∀ (a : E → ℝ) (b : V → ℝ), (∀ e, 0 < a e) → (∀ e, a e ≠ 1) → (∀ i, 0 < b i) →
        MvPolynomial.eval (Sum.elim a b) (MvPolynomial.map (Int.castRingHom ℝ) P) ≠ 0 →
          2 ^ G.nu ≤ Nat.card {y : Dart E → ℝ // G.IsAdmissibleSolution a b y} ∧
          Nat.card {y : Dart E → ℝ // G.IsAdmissibleSolution a b y} ≤ G.Q ∧
          1 ≤ Nat.card {y : Dart E → ℝ // G.IsAdmissibleSolution a b y ∧ ∀ α, 0 < y α} ∧
          Nat.card {y : Dart E → ℝ // G.IsAdmissibleSolution a b y ∧ ∀ α, 0 < y α} + 2 ^ G.nu ≤
            G.Q + 1 ∧
          Nat.card {y : Dart E → ℝ // G.IsAdmissibleSolution a b y} ≡ G.Q [MOD 2] ∧
          G.Q ≡ 2 ^ G.nu [MOD 2] := by
  obtain ⟨P₁, hP₁, h₁⟩ := G.real_positive_budget hG
  obtain ⟨P₂, hP₂, h₂⟩ := G.card_real_admissible_modEq_Q hG
  refine ⟨P₁ * P₂, mul_ne_zero hP₁ hP₂, fun a b ha ha1 hb hP => ?_⟩
  rw [map_mul, map_mul] at hP
  obtain ⟨r1, r2, r3, r4⟩ := h₁ a b ha ha1 hb (left_ne_zero_of_mul hP)
  have r5 := h₂ a b (fun e => (ha e).ne') (fun i => (hb i).ne') (right_ne_zero_of_mul hP)
  rw [card_evenSets_eq_two_pow_nu] at r1 r4
  exact ⟨r1, r2, r3, r4, r5, G.Q_modEq_two_pow_nu⟩

/-! ## Supplementary material -/

/-- **`supp:nonnormalizable-dim`** Proved (propagation). 1 + F_i = 0 propagates along edges
(`one_add_totalField_tail_eq_zero_iff`; to a whole connected component,
`one_add_totalField_eq_zero_of_connected`). The generic dimension is
`supp_nonnormalizable_dim_tree` and `supp_nonnormalizable_dim_cyclic`. -/
alias supp_nonnormalizable_propagation := Multigraph.one_add_totalField_tail_eq_zero_iff

/-- **`alg:degree-bounds` (closed form)** Proved. U_ν = (4 + 2√2)^{ν−1} + (4 − 2√2)^{ν−1}
(a negative power when ν = 0). -/
theorem U_eq_zpow (n : ℕ) :
    (U n : ℝ) = (4 + 2 * √2) ^ ((n : ℤ) - 1) + (4 - 2 * √2) ^ ((n : ℤ) - 1) := by
  have hl : (lam : ℝ) ≠ 0 := lam_pos.ne'
  have hm : (mu : ℝ) ≠ 0 := mu_pos.ne'
  have hlm := lam_mul_mu
  rw [U_eq n, show (4 + 2 * √2 : ℝ) = lam from rfl, show (4 - 2 * √2 : ℝ) = mu from rfl,
    zpow_sub_one₀ hl, zpow_sub_one₀ hm, zpow_natCast, zpow_natCast]
  have hli : lam⁻¹ = mu / 8 := by
    rw [eq_div_iff (by norm_num : (8 : ℝ) ≠ 0), inv_mul_eq_iff_eq_mul₀ hl]; linarith
  have hmi : mu⁻¹ = lam / 8 := by
    rw [eq_div_iff (by norm_num : (8 : ℝ) ≠ 0), inv_mul_eq_iff_eq_mul₀ hm]; linarith [mul_comm lam mu]
  rw [hli, hmi]
  ring

/-- **`alg:degree-bounds` (supplement)** Proved. For a connected loopless G with at least one
vertex, (ν − 1)2^ν + 2 ≤ N(G) = Q(G) ≤ (4 + 2√2)^{ν−1} + (4 − 2√2)^{ν−1}, with equality in the
upper bound iff the 2-core has maximum degree ≤ 3 (the 2-core is the union of generalized loops,
`core`; agreement with iterated leaf removal is `isPruned_iff`). Simple graphs attaining the two
bounds are `triFlower` and `ladder` (`Q_triFlower`, `Q_ladder`). -/
theorem alg_degree_bounds (hG : G.Loopless) (hc : G.Connected) :
    G.HasGenericDegree G.Q ∧
    ((G.cycleRank : ℤ) - 1) * 2 ^ G.cycleRank + 2 ≤ (G.Q : ℤ) ∧
    (G.Q : ℝ) ≤ (4 + 2 * √2) ^ ((G.cycleRank : ℤ) - 1) + (4 - 2 * √2) ^ ((G.cycleRank : ℤ) - 1) ∧
    ((G.Q : ℤ) = U G.cycleRank ↔ ∀ v, G.deg (G.core Finset.univ) v ≤ 3) ∧
    G.nu = G.cycleRank := by
  obtain ⟨h1, h2⟩ := G.sharp_bounds_of_connected hc
  refine ⟨G.hasGenericDegree_Q hG, h1, ?_, ?_, G.nu_eq_cycleRank_of_connected hc⟩
  · rw [← U_eq_zpow]; exact_mod_cast h2
  · rw [← G.theta_eq_U_of_connected hc, ← G.thetaOn_eq_QOn_iff Finset.univ]
    constructor
    · intro h; exact (Nat.cast_injective h).symm
    · intro h; unfold Q theta; rw [h]

/- **`alg:pencil-sections` (remark)** Proved. The section Hilbert series are
`alg_parameter_section_hilbert` and `alg_pencil_hilbert`; parameter base changes and actual
parameter quotients are finite free (`alg_parameter_finite_free`, `alg_parameter_cut`). After
every successive cut the coefficient resolution is exact and minimal
(`alg_parameter_resolution_exact`, `alg_parameter_resolution_minimal`), also in every internal
degree (`alg_parameter_resolution_graded_exact`, `alg_parameter_augmentation_graded_exact`); the
homological and bigraded Tor dimensions, the total Betti number Q(G) and the Tor products are
preserved (`alg_parameter_section_tor`, `alg_parameter_section_bigraded`,
`alg_parameter_section_total_betti`, `alg_parameter_section_tor_product`). The pencil section is
a one-dimensional Cohen--Macaulay algebra finite over a polynomial ring in ρ + 1 variables
(`alg_pencil_cohenMacaulay_over_coefficients`); no comparison between different parameter tuples
is claimed. -/

/-- **`sf:serre-comparison` (remark)** Proved. On B = K[w]/(w^r) the residue pairing
(f, g) ↦ [w^{r−1}](fg) takes w^i, w^j to 1 if i + j = r − 1 and to 0 otherwise. -/
alias sf_serre_residue_pairing := SerreComparison.truncLinePairing_gen_pow

/-- **`sf:serre-comparison` (remark)** Proved. The residue pairing on B is perfect. -/
alias sf_serre_residue_pairing_perfect := SerreComparison.truncLinePairing_isPerfPair

/-- **`sf:serre-comparison` (remark)** Proved. (w^a B)^⊥ = w^{r−a} B for 0 ≤ a ≤ r. -/
alias sf_serre_residue_orthogonal := SerreComparison.truncLinePairing_orthogonal_powSubmodule

/-- **`sf:serre-comparison` (remark)** Proved. The one-vertex boundary algebra of
`BoundaryAlgebra.lean` is B = K[w]/(w^r). -/
noncomputable alias sf_serre_boundary_algebra := SerreComparison.truncEquivTruncLine

/-- **`sf:serre-comparison` (remark)** Proved. The cup product
H^1(ℙ¹, O(−k)) × H^0(ℙ¹, O(k − 2)) → H^1(ℙ¹, O(−2)) followed by the trace H^1(ℙ¹, O(−2)) ≅ K
(the coordinate of z^{−1}), with k = s + 2, is the residue pairing on B with r = k − 1 under the
coordinate identifications of H^1 and H^0 with B through the affine coordinate z. -/
alias sf_serre_cup_eq_residue := SerreComparison.serreCupLinear_eq_truncLinePairing

/-- **`sf:serre-comparison` (remark)** Proved. The cup pairing into H^1(ℙ¹, O(−2)) ≅ K is perfect. -/
alias sf_serre_cup_perfect := SerreComparison.serreCupLinear_isPerfPair

/-- **`sf:serre-comparison` (remark)** Proved. H^1(ℙ¹, O(−k)) ≅ H^0(ℙ¹, O(k − 2))^*, through
the cup pairing. -/
noncomputable alias sf_serre_duality := SerreComparison.serreDualityEquiv

/-- **`sf:serre-comparison` (remark)** Proved. The dual filtrations: a class pairs to zero with
every section whose coordinate lies in w^a B iff its own coordinate lies in w^{r−a} B. -/
alias sf_serre_cup_orthogonal := SerreComparison.serreCup_orthogonal_iff

/-- **`sf:serre-comparison` (remark)** Proved. The trace H^1(ℙ¹, O(−2)) → K is bijective. -/
alias sf_serre_minus_two_trace := SerreComparison.minusTwoTrace_bijective


/-- **`alg:scope` (remark)** Proved for the chart-intersection model, with
`alg_k4_artin_exists` and `sum_finrank_incidenceTor`. This declaration proves the numerical
identities ω̃_{K₄}(1) = 30 and Q(K₄) = 48. Their interpretations as the dimension of an actual
linear regular Artin quotient and as the total Tor dimension are `alg_k4_artin_exists` and
`sum_finrank_incidenceTor`. -/
theorem alg_scope : Examples.K4.omegaTilde.eval 1 = 30 ∧ Examples.K4.Q = 48 :=
  ⟨Examples.K4_omegaTilde_eval_one, Examples.K4_Q⟩

/-- **`alg:k4-section` (actual Artin quotient)** Proved. Homogeneous linear cuts
give a nonzero regular Artin quotient of the K4 incidence ring of dimension 30. -/
theorem alg_k4_artin_exists :
    ∃ rs : List Examples.K4.IncidenceRing, rs.length = Examples.K4.dG ∧
      (∀ x ∈ rs, x ∈ Examples.K4.incidenceCoefficientPiece 1) ∧
      RingTheory.Sequence.IsRegular Examples.K4.IncidenceRing rs ∧ Ideal.ofList rs ≠ ⊤ ∧
      IsArtinianRing (Examples.K4.IncidenceRing ⧸ Ideal.ofList rs) ∧
      Module.finrank ℂ (Examples.K4.IncidenceRing ⧸ Ideal.ofList rs) = 30 := by
  obtain ⟨rs, hl, hh, hr, hn, ha, _, _, hd⟩ := Examples.K4.exists_incidence_linear_artin_hilbert
  refine ⟨rs.map Examples.K4.coeffHom, by simpa using hl, ?_, hr, hn, ha, ?_⟩
  · intro x hx
    obtain ⟨r, hm, rfl⟩ := List.mem_map.mp hx
    exact Examples.K4.coeffHom_coefficient_degree (hh r hm)
  · rw [Examples.K4_omegaTilde_eval_one] at hd
    exact_mod_cast hd

