import BPFixedPoints.Incidence.IncidenceTorStateProduct
import BPFixedPoints.Incidence.ResolutionTorAlgebra
import BPFixedPoints.Incidence.Generators
import BPFixedPoints.Incidence.Rows
import BPFixedPoints.Incidence.CechProductCupExamples

/-!
# The cycle-compatibility algebra (`alg:cycle-product`, `alg:cycle-algebra`)

Degree-zero Tor `incidenceTor 0` of the incidence ring over the coefficient ring, Mathlib's
left derived extension of scalars along the coefficient origin (so `U_G ⊗_{S_G} ℂ`), is a
commutative complex algebra under the standard Tor product `incidenceTorProduct 0 0` with unit
`incidenceTorOne`: graded commutativity carries the sign `(-1)^(0·0) = 1`
(`incidenceTorZeroCommRing`, `incidenceTorZeroAlgebra`).

The resolution states of homological degree zero are exactly the states of cycle unions, edge
sets with every vertex degree zero or two, each with its unique twist basis state
(`eq_cycleUnionState`). `cycleUnionClass S` is the Tor class with state coordinate one there.
Under full state coordinates the Tor product is `incStateCup ℂ`
(`incidenceTorFullState_product`), so:
* for cycle unions with disjoint vertex supports the product is
  `cycleUnionSign S T • cycleUnionClass (S ∪ T)`, where the sign is the edge shuffle sign times
  `(-1)^(|S|·|T|)` times the vertex crossing sign `(-1)^cupCrossings` of the state cup
  (`cycleUnionClass_mul_of_disjoint`); it involves the edge order and the enumeration
  `Fintype.equivFin V` of the vertices, and is symmetric in `S, T` (`cycleUnionSign_comm`);
* if the supports meet, the product is zero: on a shared edge by the exterior factor, at a
  shared vertex by the vanishing of the state cup (`cycleUnionClass_mul_of_not_disjoint`).

The cycle-compatibility algebra `CycleAlgebra` is `MvPolynomial (SimpleCycle) ℂ` modulo the
ideal generated by `z_C z_D` for simple cycles whose vertex sets meet, `C = D` included, so
`z_C² = 0`; its weight pieces for `deg z_C = |C|` form an internal direct sum
(`isInternal_cycleAlgebraPiece`). Evaluating `z_C` at `cycleClass C = cycleUnionClass C`
needs no sign normalization: Tor in degree zero is commutative, and a product of the
generators of vertex-disjoint cycles is `±` the class of their union (`prod_cycleClass`).
The kernel of the evaluation is the cycle-compatibility ideal, by the monomial-ideal criterion
and the distinct states of distinct cycle collections, and the evaluation is surjective. Hence
`cycleAlgebraEquivTor : CycleAlgebra ≃ₐ[ℂ] incidenceTor 0` with `z_C ↦ cycleClass C`. It is
graded: weight `q` corresponds to internal degree `q` of Tor
(`cycleAlgebraEquivTor_mem_internalPiece_iff`), and the weight pieces have dimension
`β_{0,q}` (`finrank_cycleAlgebraPiece`).

The paper writes the left side as `U_G/(S_G)_+U_G`; here it is degree-zero Tor with its
standard product, `U_G ⊗_{S_G} ℂ` at the coefficient origin. The identification with the
quotient ring is `IncidenceCycleAlgebraQuotient`.
-/

set_option backward.isDefEq.respectTransparency false
set_option synthInstance.maxHeartbeats 100000
set_option maxRecDepth 4096
set_option linter.unusedSectionVars false

namespace BPFixedPoints.Multigraph

open Finsupp CechProduct

variable {V E : Type} [DecidableEq V] [Fintype V] [LinearOrder E] [Fintype E]
  (G : Multigraph V E)

/-! ## Cycle unions -/

/-- A vertex in the support of an edge set is incident to one of its edges. -/
theorem exists_incident_of_mem_support {S : Finset E} {v : V} (hv : v ∈ G.support S) :
    ∃ e ∈ S, G.Incident e v := by
  by_contra h
  push Not at h
  have h0 := (G.deg_eq_zero_iff S v).2 h
  rw [mem_support_iff] at hv
  omega

/-- Edge sets with disjoint vertex supports are edge-disjoint. -/
theorem disjoint_of_disjoint_support {S T : Finset E}
    (h : Disjoint (G.support S) (G.support T)) : Disjoint S T := by
  rw [Finset.disjoint_left]
  intro e heS heT
  exact Finset.disjoint_left.mp h (G.fst_mem_support heS) (G.fst_mem_support heT)

/-- The union of two cycle unions with disjoint vertex supports is a cycle union. -/
theorem isCycleUnion_union {S T : Finset E} (hS : G.IsCycleUnion S) (hT : G.IsCycleUnion T)
    (h : Disjoint (G.support S) (G.support T)) : G.IsCycleUnion (S ∪ T) := by
  intro v
  rw [G.deg_union_of_disjoint (G.disjoint_of_disjoint_support h)]
  have hv : ¬ (0 < G.deg S v ∧ 0 < G.deg T v) := by
    rintro ⟨h1, h2⟩
    exact Finset.disjoint_left.mp h ((G.mem_support_iff).2 h1) ((G.mem_support_iff).2 h2)
  rcases hS v with h1 | h1 <;> rcases hT v with h2 | h2 <;> omega

/-- Twists of cycle unions with disjoint supports carry at every vertex the pair (0,0), (2,0)
or (0,2). -/
theorem cycleUnion_zeroTwo {S T : Finset E} (hS : G.IsCycleUnion S) (hT : G.IsCycleUnion T)
    (h : Disjoint (G.support S) (G.support T)) (v : V) :
    (G.deg S v = 0 ∧ G.deg T v = 0) ∨ (G.deg S v = 2 ∧ G.deg T v = 0) ∨
      (G.deg S v = 0 ∧ G.deg T v = 2) := by
  have hv : ¬ (0 < G.deg S v ∧ 0 < G.deg T v) := by
    rintro ⟨h1, h2⟩
    exact Finset.disjoint_left.mp h ((G.mem_support_iff).2 h1) ((G.mem_support_iff).2 h2)
  rcases hS v with h1 | h1 <;> rcases hT v with h2 | h2 <;> omega

/-- A cycle union has as many edges as support vertices. -/
theorem card_support_of_isCycleUnion {S : Finset E} (hS : G.IsCycleUnion S) :
    (G.support S).card = S.card :=
  (G.wt_eq_one_of_deg hS).2.symm

/-! ## Degree-zero resolution states -/

/-- The resolution state of a cycle union: its edge set with the unique twist basis state. -/
def cycleUnionState (S : Finset E) (hS : G.IsCycleUnion S) : G.IncResolutionBasis :=
  ⟨S, zeroTwoStateIndex (G.deg S) hS⟩

/-- Cycle-union states lie in homological degree zero. -/
theorem incResolutionDegree_cycleUnionState (S : Finset E) (hS : G.IsCycleUnion S) :
    G.incResolutionDegree (G.cycleUnionState S hS) = 0 := by
  simp only [incResolutionDegree, cycleUnionState, G.card_support_of_isCycleUnion hS,
    Nat.sub_self]

/-- The internal degree of a cycle-union state is its number of edges. -/
theorem incResolutionInternalDegree_cycleUnionState (S : Finset E) (hS : G.IsCycleUnion S) :
    G.incResolutionInternalDegree (G.cycleUnionState S hS) = S.card := rfl

/-- The edge set of a resolution state of homological degree zero is a cycle union. -/
theorem isCycleUnion_of_incResolutionDegree_eq_zero (b : G.IncResolutionBasis)
    (hb : G.incResolutionDegree b = 0) : G.IsCycleUnion b.1 := by
  have hc := G.incResolutionBasis_contributing b
  have hle : b.1.card ≤ (G.support b.1).card := by
    unfold incResolutionDegree at hb
    omega
  exact G.deg_eq_two_of_card_le ((G.wt_phi_ne_zero_iff b.1).2 hc) hle

/-- Every resolution state of homological degree zero is the state of its cycle union. -/
theorem eq_cycleUnionState (b : G.IncResolutionBasis) (hb : G.incResolutionDegree b = 0) :
    b = G.cycleUnionState b.1 (G.isCycleUnion_of_incResolutionDegree_eq_zero b hb) := by
  obtain ⟨S, κ⟩ := b
  have hS := G.isCycleUnion_of_incResolutionDegree_eq_zero ⟨S, κ⟩ hb
  unfold cycleUnionState
  congr 1
  exact cupExample_hBasis_eq (fun v => phi_eq_one_of_zeroTwo (hS v)) _ _

/-! ## Degree-zero Tor classes of cycle unions -/

/-- The degree-zero Tor class of an edge set: for a cycle union, the class whose state
coordinates are one at its unique state and zero elsewhere; zero for any other edge set. -/
noncomputable def cycleUnionClass (S : Finset E) : G.incidenceTor 0 :=
  if hS : G.IsCycleUnion S then
    (G.incidenceTorEquivState 0).symm
      (single ⟨G.cycleUnionState S hS, G.incResolutionDegree_cycleUnionState S hS⟩ 1)
  else 0

/-- The full state of the class of a cycle union is its basis state. -/
theorem incidenceTorFullState_cycleUnionClass {S : Finset E} (hS : G.IsCycleUnion S) :
    G.incidenceTorFullState 0 (G.cycleUnionClass S) = single (G.cycleUnionState S hS) 1 := by
  rw [cycleUnionClass, dite_eq_left hS, incidenceTorFullState]
  simp only [LinearMap.coe_comp, LinearEquiv.coe_coe, Function.comp_apply,
    LinearEquiv.apply_symm_apply, lmapDomain_apply, mapDomain_single]

/-- The class of an edge set that is not a cycle union is zero. -/
theorem cycleUnionClass_of_not {S : Finset E} (hS : ¬ G.IsCycleUnion S) :
    G.cycleUnionClass S = 0 := by
  rw [cycleUnionClass, dite_eq_right hS]

/-- The degree-zero Tor basis vector of a degree-zero state is the class of its cycle union. -/
theorem incidenceTorEquivState_symm_single (b : {b : G.IncResolutionBasis //
      G.incResolutionDegree b = 0}) (c : ℂ) :
    (G.incidenceTorEquivState 0).symm (single b c) = c • G.cycleUnionClass b.val.1 := by
  have hS := G.isCycleUnion_of_incResolutionDegree_eq_zero b.val b.property
  have hb : b = ⟨G.cycleUnionState b.val.1 hS, G.incResolutionDegree_cycleUnionState _ hS⟩ :=
    Subtype.ext (G.eq_cycleUnionState b.val b.property)
  rw [cycleUnionClass, dite_eq_left hS, ← map_smul, smul_single, smul_eq_mul, mul_one, ← hb]

/-- Cohomological degree of the twist of a cycle union is its number of edges. -/
theorem cohomologyDegree_deg_of_isCycleUnion {S : Finset E} (hS : G.IsCycleUnion S) :
    cohomologyDegree (G.deg S) = S.card := by
  rw [cohomologyDegree_deg, G.card_support_of_isCycleUnion hS]

/-- The sign of the product of the classes of two cycle unions with disjoint supports: the edge
shuffle sign, the Koszul sign `(-1)^(|S|·|T|)` and the vertex crossing sign of the state cup. -/
noncomputable def cycleUnionSign (S T : Finset E) : ℂ :=
  Koszul.shuffleSign S T * (-1) ^ (S.card * T.card) * (-1) ^ cupCrossings (G.deg S) (G.deg T)

/-- The sign of a product of cycle-union classes is a power of `-1`. -/
theorem cycleUnionSign_eq_pow (S T : Finset E) :
    G.cycleUnionSign S T =
      (-1) ^ (Koszul.shuffleIndex S T + S.card * T.card + cupCrossings (G.deg S) (G.deg T)) := by
  rw [cycleUnionSign, Koszul.shuffleSign, pow_add, pow_add]

/-- **Product of vertex-disjoint cycle unions.** The standard Tor product of the classes of two
cycle unions with disjoint vertex supports is the signed class of their union. -/
theorem incidenceTorProduct_cycleUnionClass_of_disjoint {S T : Finset E} (hS : G.IsCycleUnion S)
    (hT : G.IsCycleUnion T) (h : Disjoint (G.support S) (G.support T)) :
    G.incidenceTorProduct 0 0 (G.cycleUnionClass S) (G.cycleUnionClass T) =
      G.cycleUnionSign S T • G.cycleUnionClass (S ∪ T) := by
  have hST := G.isCycleUnion_union hS hT h
  have hE := G.disjoint_of_disjoint_support h
  apply G.incidenceTorFullState_injective 0
  rw [map_smul]
  change G.incidenceTorFullState (0 + 0) _ = _
  rw [incidenceTorFullState_product, G.incidenceTorFullState_cycleUnionClass hS,
    G.incidenceTorFullState_cycleUnionClass hT, G.incidenceTorFullState_cycleUnionClass hST]
  rw [cycleUnionState, cycleUnionState, incStateCup_single_of_disjoint G ℂ hE,
    cohomologyCup_single_of_zeroTwo ℂ _ _ (G.cycleUnion_zeroTwo hS hT h) _ _
      (cast (congrArg HBasis (G.deg_union_eq_add hE)) (zeroTwoStateIndex (G.deg (S ∪ T)) hST)),
    castH_single, incStateEmbed_single, cast_cast, cast_eq, smul_single, smul_eq_mul,
    G.cohomologyDegree_deg_of_isCycleUnion hT, cycleUnionState, cycleUnionSign, smul_single,
    smul_eq_mul]
  simp only [mul_one]

/-- **Products of meeting cycle unions vanish.** The standard Tor product of the classes of two
edge sets whose vertex supports meet is zero: on a shared edge by the exterior factor, and
otherwise by the vanishing of the state cup at a common vertex. -/
theorem incidenceTorProduct_cycleUnionClass_of_not_disjoint {S T : Finset E}
    (h : ¬ Disjoint (G.support S) (G.support T)) :
    G.incidenceTorProduct 0 0 (G.cycleUnionClass S) (G.cycleUnionClass T) = 0 := by
  by_cases hS : G.IsCycleUnion S
  swap
  · rw [G.cycleUnionClass_of_not hS, map_zero, LinearMap.zero_apply]
  by_cases hT : G.IsCycleUnion T
  swap
  · rw [G.cycleUnionClass_of_not hT, map_zero]
  apply G.incidenceTorFullState_injective 0
  rw [map_zero]
  change G.incidenceTorFullState (0 + 0) _ = _
  rw [incidenceTorFullState_product, G.incidenceTorFullState_cycleUnionClass hS,
    G.incidenceTorFullState_cycleUnionClass hT, cycleUnionState, cycleUnionState]
  by_cases hE : Disjoint S T
  · obtain ⟨v, hvS, hvT⟩ := Finset.not_disjoint_iff.mp h
    rw [incStateCup_single_of_disjoint G ℂ hE,
      cohomologyCup_eq_zero_of_overlap ℂ (G.deg S) (G.deg T) v ((G.mem_support_iff).1 hvS)
        ((G.mem_support_iff).1 hvT)]
    simp only [LinearMap.zero_apply, map_zero, smul_zero]
  · exact incStateCup_single_of_not_disjoint G ℂ hE _ _ 1 1

/-! ## The commutative algebra structure of degree-zero Tor -/

/-- Degree-zero Tor is a commutative ring under the standard Tor product: associativity and
the unit laws of the Tor algebra, and graded commutativity with sign `(-1)^(0·0) = 1`. -/
noncomputable instance incidenceTorZeroCommRing : CommRing (G.incidenceTor 0) where
  __ := (inferInstance : AddCommGroup (G.incidenceTor 0))
  mul x y := G.incidenceTorProduct 0 0 x y
  one := G.incidenceTorOne
  mul_assoc x y z := G.incidenceTorProduct_assoc 0 0 0 x y z
  one_mul x := G.incidenceTorOne_mul 0 x
  mul_one x := G.incidenceTor_mul_one 0 x
  left_distrib x y z := map_add (G.incidenceTorProduct 0 0 x) y z
  right_distrib x y z := by
    change G.incidenceTorProduct 0 0 (x + y) z = _
    rw [map_add, LinearMap.add_apply]
    rfl
  zero_mul x := by
    change G.incidenceTorProduct 0 0 0 x = 0
    rw [map_zero, LinearMap.zero_apply]
  mul_zero x := map_zero (G.incidenceTorProduct 0 0 x)
  mul_comm x y := by
    have h := G.incidenceTorProduct_graded_comm 0 0 x y
    rw [Nat.mul_zero, pow_zero, one_smul] at h
    exact h

/-- Multiplication in degree-zero Tor is the standard Tor product. -/
theorem incidenceTorZero_mul_def (x y : G.incidenceTor 0) :
    x * y = G.incidenceTorProduct 0 0 x y := rfl

/-- The unit of degree-zero Tor is the unit of the Tor algebra. -/
theorem incidenceTorZero_one_def : (1 : G.incidenceTor 0) = G.incidenceTorOne := rfl

/-- Degree-zero Tor is a complex algebra; scalars act through its vector-space structure. -/
noncomputable instance incidenceTorZeroAlgebra : Algebra ℂ (G.incidenceTor 0) :=
  Algebra.ofModule
    (fun r x y => by
      change G.incidenceTorProduct 0 0 (r • x) y = r • G.incidenceTorProduct 0 0 x y
      rw [map_smul, LinearMap.smul_apply])
    (fun r x y => by
      change G.incidenceTorProduct 0 0 x (r • y) = r • G.incidenceTorProduct 0 0 x y
      rw [map_smul])

/-- Full state coordinates of a product in degree-zero Tor are the state product. -/
theorem incidenceTorFullState_mul (x y : G.incidenceTor 0) :
    G.incidenceTorFullState 0 (x * y) =
      G.incStateCup ℂ (G.incidenceTorFullState 0 x) (G.incidenceTorFullState 0 y) :=
  G.incidenceTorFullState_product 0 0 x y

/-- Product of the classes of two cycle unions with disjoint supports, in the ring structure. -/
theorem cycleUnionClass_mul_of_disjoint {S T : Finset E} (hS : G.IsCycleUnion S)
    (hT : G.IsCycleUnion T) (h : Disjoint (G.support S) (G.support T)) :
    G.cycleUnionClass S * G.cycleUnionClass T =
      G.cycleUnionSign S T • G.cycleUnionClass (S ∪ T) :=
  G.incidenceTorProduct_cycleUnionClass_of_disjoint hS hT h

/-- The product of the classes of two edge sets whose supports meet is zero. -/
theorem cycleUnionClass_mul_of_not_disjoint {S T : Finset E}
    (h : ¬ Disjoint (G.support S) (G.support T)) :
    G.cycleUnionClass S * G.cycleUnionClass T = 0 :=
  G.incidenceTorProduct_cycleUnionClass_of_not_disjoint h

/-- The class of a cycle union is nonzero. -/
theorem cycleUnionClass_ne_zero {S : Finset E} (hS : G.IsCycleUnion S) :
    G.cycleUnionClass S ≠ 0 := by
  intro h
  have hs := G.incidenceTorFullState_cycleUnionClass hS
  rw [h, map_zero] at hs
  exact (Finsupp.single_ne_zero.mpr one_ne_zero) hs.symm

/-- **Consistency of the product signs with commutativity.** For cycle unions with disjoint
supports the product sign is symmetric: `shuffleSign`, the Koszul sign and the vertex crossing
sign change together when the factors are exchanged. -/
theorem cycleUnionSign_comm {S T : Finset E} (hS : G.IsCycleUnion S) (hT : G.IsCycleUnion T)
    (h : Disjoint (G.support S) (G.support T)) :
    G.cycleUnionSign S T = G.cycleUnionSign T S := by
  have hc := mul_comm (G.cycleUnionClass S) (G.cycleUnionClass T)
  rw [G.cycleUnionClass_mul_of_disjoint hS hT h, G.cycleUnionClass_mul_of_disjoint hT hS h.symm,
    Finset.union_comm T S] at hc
  exact smul_left_injective ℂ (G.cycleUnionClass_ne_zero (G.isCycleUnion_union hS hT h)) hc

/-! ## Generator classes of simple cycles -/

/-- The simple cycles of the graph, indexing the generators of the cycle-compatibility
algebra. -/
abbrev SimpleCycle : Type := {C : Finset E // G.IsSimpleCycle C}

/-- The degree-zero Tor class of a simple cycle: the class of its edge set, whose state
coordinates are one at its unique state. -/
noncomputable def cycleClass (C : G.SimpleCycle) : G.incidenceTor 0 :=
  G.cycleUnionClass C.val

/-- The vertex support of a simple cycle is nonempty. -/
theorem support_nonempty_of_isSimpleCycle {C : Finset E} (hC : G.IsSimpleCycle C) :
    (G.support C).Nonempty := by
  obtain ⟨e, he⟩ := hC.1
  exact ⟨G.fst e, G.fst_mem_support he⟩

/-- **z_C z_D = 0 for cycles sharing a vertex.** -/
theorem cycleClass_mul_of_not_disjoint {C D : G.SimpleCycle}
    (h : ¬ Disjoint (G.support C.val) (G.support D.val)) :
    G.cycleClass C * G.cycleClass D = 0 :=
  G.cycleUnionClass_mul_of_not_disjoint h

/-- **z_C² = 0.** -/
theorem cycleClass_mul_self (C : G.SimpleCycle) : G.cycleClass C * G.cycleClass C = 0 := by
  apply G.cycleClass_mul_of_not_disjoint
  rw [Finset.disjoint_self_iff_empty]
  exact (G.support_nonempty_of_isSimpleCycle C.property).ne_empty

/-- Collections of pairwise vertex-disjoint simple cycles, as finite sets of simple cycles. -/
def IsVertexDisjoint (s : Finset G.SimpleCycle) : Prop :=
  ∀ C ∈ s, ∀ D ∈ s, C ≠ D → Disjoint (G.support C.val) (G.support D.val)

/-- The edge sets of a vertex-disjoint family of simple cycles form a cycle collection. -/
theorem isCycleCollection_map {s : Finset G.SimpleCycle} (hs : G.IsVertexDisjoint s) :
    G.IsCycleCollection (s.map (Function.Embedding.subtype _)) := by
  refine ⟨fun C hC => ?_, fun C hC D hD hCD => ?_⟩
  · obtain ⟨C, _, rfl⟩ := Finset.mem_map.mp hC
    exact C.property
  · obtain ⟨C', hC', rfl⟩ := Finset.mem_map.mp hC
    obtain ⟨D', hD', rfl⟩ := Finset.mem_map.mp hD
    exact hs C' hC' D' hD' (fun h => hCD (congrArg Subtype.val h))

/-- The union of the edge sets of a vertex-disjoint family of simple cycles. -/
theorem biUnion_map_subtype (s : Finset G.SimpleCycle) :
    (s.map (Function.Embedding.subtype _)).biUnion id = s.biUnion Subtype.val := by
  ext e
  simp only [Finset.mem_biUnion, Finset.mem_map, id, Function.Embedding.coe_subtype]
  constructor
  · rintro ⟨_, ⟨C, hC, rfl⟩, he⟩
    exact ⟨C, hC, he⟩
  · rintro ⟨C, hC, he⟩
    exact ⟨C.val, ⟨C, hC, rfl⟩, he⟩

/-- The union of a vertex-disjoint family of simple cycles is a cycle union. -/
theorem isCycleUnion_biUnion_val {s : Finset G.SimpleCycle} (hs : G.IsVertexDisjoint s) :
    G.IsCycleUnion (s.biUnion Subtype.val) := by
  rw [← biUnion_map_subtype]
  exact G.isCycleUnion_biUnion (G.isCycleCollection_map hs)

/-- A simple cycle lies in the union of a vertex-disjoint family exactly when it belongs to the
family. -/
theorem subset_biUnion_val_iff {s : Finset G.SimpleCycle} (hs : G.IsVertexDisjoint s)
    (C : G.SimpleCycle) : C.val ⊆ s.biUnion Subtype.val ↔ C ∈ s := by
  constructor
  · intro hC
    rw [← biUnion_map_subtype] at hC
    have h := (G.mem_cycleCollection_iff (G.isCycleCollection_map hs)).2 ⟨hC, C.property⟩
    obtain ⟨D, hD, hDC⟩ := Finset.mem_map.mp h
    rw [← Subtype.ext hDC]
    exact hD
  · intro hC e he
    exact Finset.mem_biUnion.mpr ⟨C, hC, he⟩

/-- A vertex-disjoint family of simple cycles is determined by its union. -/
theorem eq_of_biUnion_val_eq {s t : Finset G.SimpleCycle} (hs : G.IsVertexDisjoint s)
    (ht : G.IsVertexDisjoint t) (h : s.biUnion Subtype.val = t.biUnion Subtype.val) : s = t := by
  ext C
  rw [← G.subset_biUnion_val_iff hs, ← G.subset_biUnion_val_iff ht, h]

/-- A simple cycle whose support avoids the supports of all members of a family of simple
cycles has support disjoint from the union of the family. -/
theorem disjoint_support_biUnion_val {s : Finset G.SimpleCycle} {C : G.SimpleCycle}
    (hC : ∀ D ∈ s, Disjoint (G.support C.val) (G.support D.val)) :
    Disjoint (G.support C.val) (G.support (s.biUnion Subtype.val)) := by
  rw [Finset.disjoint_left]
  intro v hvC hv
  obtain ⟨e, he, hev⟩ := G.exists_incident_of_mem_support hv
  obtain ⟨D, hD, heD⟩ := Finset.mem_biUnion.mp he
  exact Finset.disjoint_left.mp (hC D hD) hvC (G.mem_support_of_incident heD hev)

/-- **Products of vertex-disjoint cycle classes.** The product of the classes of a
vertex-disjoint family of simple cycles is a sign times the class of their union. -/
theorem prod_cycleClass {s : Finset G.SimpleCycle} (hs : G.IsVertexDisjoint s) :
    ∃ n : ℕ, ∏ C ∈ s, G.cycleClass C =
      (-1 : ℂ) ^ n • G.cycleUnionClass (s.biUnion Subtype.val) := by
  classical
  induction s using Finset.induction_on with
  | empty =>
    refine ⟨0, ?_⟩
    rw [Finset.prod_empty, pow_zero, one_smul, Finset.biUnion_empty]
    apply G.incidenceTorFullState_injective 0
    rw [G.incidenceTorFullState_cycleUnionClass (fun v => Or.inl (G.deg_empty v))]
    change G.incidenceTorFullState 0 G.incidenceTorOne = _
    rw [incidenceTorFullState_one, G.incStateUnit_eq_single ℂ]
    rfl
  | insert C s hCs ih =>
    have hs' : G.IsVertexDisjoint s := fun D hD D' hD' hDD' =>
      hs D (Finset.mem_insert_of_mem hD) D' (Finset.mem_insert_of_mem hD') hDD'
    have hC : ∀ D ∈ s, Disjoint (G.support C.val) (G.support D.val) := fun D hD =>
      hs C (Finset.mem_insert_self C s) D (Finset.mem_insert_of_mem hD)
        (fun h => hCs (h ▸ hD))
    obtain ⟨n, hn⟩ := ih hs'
    have hdisj := G.disjoint_support_biUnion_val hC
    refine ⟨n + (Koszul.shuffleIndex C.val (s.biUnion Subtype.val) +
      C.val.card * (s.biUnion Subtype.val).card +
        cupCrossings (G.deg C.val) (G.deg (s.biUnion Subtype.val))), ?_⟩
    rw [Finset.prod_insert hCs, hn, mul_smul_comm, cycleClass,
      G.cycleUnionClass_mul_of_disjoint C.property.isCycleUnion (G.isCycleUnion_biUnion_val hs')
        hdisj, smul_smul, Finset.biUnion_insert, cycleUnionSign_eq_pow, ← pow_add]

/-- The members of a vertex-disjoint family of simple cycles are pairwise edge-disjoint. -/
theorem pairwiseDisjoint_val {s : Finset G.SimpleCycle} (hs : G.IsVertexDisjoint s) :
    (s : Set G.SimpleCycle).PairwiseDisjoint Subtype.val := fun C hC D hD hCD =>
  G.disjoint_of_disjoint_support (hs C hC D hD hCD)

/-- The union of a vertex-disjoint family of simple cycles has as many edges as its members. -/
theorem card_biUnion_val {s : Finset G.SimpleCycle} (hs : G.IsVertexDisjoint s) :
    (s.biUnion Subtype.val).card = ∑ C ∈ s, C.val.card :=
  Finset.card_biUnion (G.pairwiseDisjoint_val hs)

/-- The simple cycles contained in a cycle union. -/
def cyclesIn (S : Finset E) : Finset G.SimpleCycle :=
  Finset.univ.filter fun C => C.val ⊆ S

/-- The simple cycles contained in a cycle union are pairwise vertex-disjoint. -/
theorem isVertexDisjoint_cyclesIn {S : Finset E} (hS : G.IsCycleUnion S) :
    G.IsVertexDisjoint (G.cyclesIn S) := by
  classical
  intro C hC D hD hCD
  have hcol := (G.cycleCollection_of_cycleUnion hS).1
  simp only [cyclesIn, Finset.mem_filter, Finset.mem_univ, true_and] at hC hD
  exact hcol.2 C.val (Finset.mem_filter.mpr ⟨Finset.mem_powerset.mpr hC, C.property⟩)
    D.val (Finset.mem_filter.mpr ⟨Finset.mem_powerset.mpr hD, D.property⟩)
    (fun h => hCD (Subtype.ext h))

/-- A cycle union is the union of the simple cycles it contains. -/
theorem biUnion_cyclesIn {S : Finset E} (hS : G.IsCycleUnion S) :
    (G.cyclesIn S).biUnion Subtype.val = S := by
  classical
  have h := (G.cycleCollection_of_cycleUnion hS).2
  ext e
  constructor
  · intro he
    obtain ⟨C, hC, heC⟩ := Finset.mem_biUnion.mp he
    simp only [cyclesIn, Finset.mem_filter, Finset.mem_univ, true_and] at hC
    exact hC heC
  · intro he
    rw [← h] at he
    obtain ⟨C, hC, heC⟩ := Finset.mem_biUnion.mp he
    simp only [Finset.mem_filter, Finset.mem_powerset] at hC
    refine Finset.mem_biUnion.mpr ⟨⟨C, hC.2⟩, ?_, heC⟩
    simp only [cyclesIn, Finset.mem_filter, Finset.mem_univ, true_and]
    exact hC.1

/-! ## The cycle-compatibility algebra -/

open MvPolynomial

/-- The weight of the generator of a simple cycle: its number of edges. -/
def cycleWeight (C : G.SimpleCycle) : ℕ := C.val.card

/-- Exponent vectors `e_C + e_D` of the relations `z_C z_D` for simple cycles sharing a vertex,
including `C = D`. -/
def cycleMeetExponents : Set (G.SimpleCycle →₀ ℕ) :=
  {m | ∃ C D : G.SimpleCycle, ¬ Disjoint (G.support C.val) (G.support D.val) ∧
    m = single C 1 + single D 1}

/-- The cycle-compatibility ideal `(z_C z_D : V(C) ∩ V(D) ≠ ∅)` in the polynomial ring on the
simple cycles. Taking `C = D` puts `z_C²` in the ideal. -/
noncomputable def cycleCompatibilityIdeal : Ideal (MvPolynomial G.SimpleCycle ℂ) :=
  Ideal.span {f | ∃ C D : G.SimpleCycle, ¬ Disjoint (G.support C.val) (G.support D.val) ∧
    f = X C * X D}

/-- The cycle-compatibility algebra `ℂ[z_C : C simple cycle] / (z_C z_D : V(C) ∩ V(D) ≠ ∅)`. -/
abbrev CycleAlgebra : Type := MvPolynomial G.SimpleCycle ℂ ⧸ G.cycleCompatibilityIdeal

/-- The piece of weight `q` of the cycle-compatibility algebra for `deg z_C = |C|`: the image
of the weighted homogeneous polynomials of weight `q`. -/
noncomputable def cycleAlgebraPiece (q : ℕ) : Submodule ℂ G.CycleAlgebra :=
  (weightedHomogeneousSubmodule ℂ G.cycleWeight q).map
    (Ideal.Quotient.mkₐ ℂ G.cycleCompatibilityIdeal).toLinearMap

/-- The relation `z_C z_D` is the monomial with exponent `e_C + e_D`. -/
theorem X_mul_X_eq_monomial (C D : G.SimpleCycle) :
    (X C * X D : MvPolynomial G.SimpleCycle ℂ) = monomial (single C 1 + single D 1) 1 := by
  rw [X, X, monomial_mul_monomial, one_mul]

/-- The cycle-compatibility ideal is the monomial ideal of the exponents `e_C + e_D`. -/
theorem cycleCompatibilityIdeal_eq :
    G.cycleCompatibilityIdeal =
      Ideal.span ((fun m => monomial m (1 : ℂ)) '' G.cycleMeetExponents) := by
  unfold cycleCompatibilityIdeal
  congr 1
  ext f
  constructor
  · rintro ⟨C, D, h, rfl⟩
    exact ⟨_, ⟨C, D, h, rfl⟩, (G.X_mul_X_eq_monomial C D).symm⟩
  · rintro ⟨_, ⟨C, D, h, rfl⟩, rfl⟩
    exact ⟨C, D, h, (G.X_mul_X_eq_monomial C D).symm⟩

/-- `z_C²` lies in the cycle-compatibility ideal. -/
theorem X_mul_self_mem_cycleCompatibilityIdeal (C : G.SimpleCycle) :
    (X C * X C : MvPolynomial G.SimpleCycle ℂ) ∈ G.cycleCompatibilityIdeal := by
  apply Ideal.subset_span
  refine ⟨C, C, ?_, rfl⟩
  rw [Finset.disjoint_self_iff_empty]
  exact (G.support_nonempty_of_isSimpleCycle C.property).ne_empty

/-- Exponent vectors of standard monomials: square-free, with pairwise vertex-disjoint
support. -/
def IsCompatibleExponent (m : G.SimpleCycle →₀ ℕ) : Prop :=
  (∀ C, m C ≤ 1) ∧ G.IsVertexDisjoint m.support

/-- An exponent vector divisible by no relation exponent is compatible. -/
theorem isCompatibleExponent_of_forall_not_le {m : G.SimpleCycle →₀ ℕ}
    (h : ∀ g ∈ G.cycleMeetExponents, ¬ g ≤ m) : G.IsCompatibleExponent m := by
  classical
  constructor
  · intro C
    by_contra hC
    apply h (single C 1 + single C 1)
    · refine ⟨C, C, ?_, rfl⟩
      rw [Finset.disjoint_self_iff_empty]
      exact (G.support_nonempty_of_isSimpleCycle C.property).ne_empty
    · rw [Finsupp.le_def]
      intro D
      rw [Finsupp.add_apply, single_apply]
      split_ifs with hD
      · subst hD
        omega
      · omega
  · intro C hC D hD hCD
    by_contra hmeet
    apply h (single C 1 + single D 1) ⟨C, D, hmeet, rfl⟩
    rw [Finsupp.le_def]
    intro F
    have hC1 := Finsupp.mem_support_iff.mp hC
    have hD1 := Finsupp.mem_support_iff.mp hD
    rw [Finsupp.add_apply, single_apply, single_apply]
    split_ifs with h1 h2 h2
    · exact absurd (h1.trans h2.symm) hCD
    · subst h1
      omega
    · subst h2
      omega
    · omega

variable {G} in
/-- A compatible exponent vector is the indicator of its support. -/
theorem IsCompatibleExponent.apply_eq_one {m : G.SimpleCycle →₀ ℕ}
    (hm : G.IsCompatibleExponent m) {C : G.SimpleCycle} (hC : C ∈ m.support) : m C = 1 :=
  le_antisymm (hm.1 C) (Nat.one_le_iff_ne_zero.mpr (Finsupp.mem_support_iff.mp hC))

variable {G} in
/-- Compatible exponent vectors with the same support are equal. -/
theorem IsCompatibleExponent.eq_of_support_eq {m m' : G.SimpleCycle →₀ ℕ}
    (hm : G.IsCompatibleExponent m) (hm' : G.IsCompatibleExponent m')
    (h : m.support = m'.support) : m = m' := by
  ext C
  by_cases hC : C ∈ m.support
  · rw [hm.apply_eq_one hC, hm'.apply_eq_one (h ▸ hC)]
  · rw [Finsupp.notMem_support_iff.mp hC, Finsupp.notMem_support_iff.mp (h ▸ hC)]

variable {G} in
/-- The weight of a compatible exponent vector is the number of edges of its cycle union. -/
theorem IsCompatibleExponent.weight_eq {m : G.SimpleCycle →₀ ℕ}
    (hm : G.IsCompatibleExponent m) :
    Finsupp.weight G.cycleWeight m = (m.support.biUnion Subtype.val).card := by
  rw [G.card_biUnion_val hm.2, Finsupp.weight_apply, Finsupp.sum]
  refine Finset.sum_congr rfl fun C hC => ?_
  rw [hm.apply_eq_one hC, one_smul]
  rfl

/-! ## Evaluation of cycle polynomials in degree-zero Tor -/

/-- The algebra map from the polynomial ring on the simple cycles to degree-zero Tor sending
`z_C` to the class of the cycle `C`. -/
noncomputable def cyclePolynomialToTor : MvPolynomial G.SimpleCycle ℂ →ₐ[ℂ] G.incidenceTor 0 :=
  aeval G.cycleClass

/-- The generator `z_C` goes to the class of `C`. -/
theorem cyclePolynomialToTor_X (C : G.SimpleCycle) :
    G.cyclePolynomialToTor (X C) = G.cycleClass C :=
  aeval_X _ _

/-- The relations `z_C z_D` for cycles sharing a vertex go to zero. -/
theorem cyclePolynomialToTor_eq_zero_of_mem {f : MvPolynomial G.SimpleCycle ℂ}
    (hf : f ∈ G.cycleCompatibilityIdeal) : G.cyclePolynomialToTor f = 0 := by
  have hle : G.cycleCompatibilityIdeal ≤ RingHom.ker G.cyclePolynomialToTor := by
    apply Ideal.span_le.mpr
    rintro _ ⟨C, D, h, rfl⟩
    rw [SetLike.mem_coe, RingHom.mem_ker, map_mul, cyclePolynomialToTor_X,
      cyclePolynomialToTor_X]
    exact G.cycleClass_mul_of_not_disjoint h
  exact (RingHom.mem_ker).mp (hle hf)

/-- A compatible monomial goes to the product of the classes of the cycles in its support. -/
theorem cyclePolynomialToTor_monomial_of_compatible {m : G.SimpleCycle →₀ ℕ}
    (hm : G.IsCompatibleExponent m) :
    G.cyclePolynomialToTor (monomial m 1) = ∏ C ∈ m.support, G.cycleClass C := by
  rw [cyclePolynomialToTor, aeval_monomial, map_one, one_mul, Finsupp.prod]
  refine Finset.prod_congr rfl fun C hC => ?_
  rw [hm.apply_eq_one hC, pow_one]

/-- A compatible monomial goes to a sign times the class of its cycle union. -/
theorem exists_cyclePolynomialToTor_monomial {m : G.SimpleCycle →₀ ℕ}
    (hm : G.IsCompatibleExponent m) :
    ∃ n : ℕ, G.cyclePolynomialToTor (monomial m 1) =
      (-1 : ℂ) ^ n • G.cycleUnionClass (m.support.biUnion Subtype.val) := by
  rw [G.cyclePolynomialToTor_monomial_of_compatible hm]
  exact G.prod_cycleClass hm.2

/-- A monomial that is not compatible lies in the cycle-compatibility ideal. -/
theorem monomial_mem_cycleCompatibilityIdeal {m : G.SimpleCycle →₀ ℕ}
    (hm : ¬ G.IsCompatibleExponent m) :
    (monomial m 1 : MvPolynomial G.SimpleCycle ℂ) ∈ G.cycleCompatibilityIdeal := by
  classical
  rw [cycleCompatibilityIdeal_eq, mem_ideal_span_monomial_image]
  intro xi hxi
  rw [support_monomial, ite_eq_right one_ne_zero, Finset.mem_singleton] at hxi
  subst hxi
  by_contra h
  push Not at h
  exact hm (G.isCompatibleExponent_of_forall_not_le h)

/-- A monomial that is not compatible goes to zero. -/
theorem cyclePolynomialToTor_monomial_of_not_compatible {m : G.SimpleCycle →₀ ℕ}
    (hm : ¬ G.IsCompatibleExponent m) : G.cyclePolynomialToTor (monomial m 1) = 0 :=
  G.cyclePolynomialToTor_eq_zero_of_mem (G.monomial_mem_cycleCompatibilityIdeal hm)

/-- A monomial with coefficient `a` is `a` times the monic monomial. -/
theorem monomial_eq_smul_monomial_one (m : G.SimpleCycle →₀ ℕ) (a : ℂ) :
    (monomial m a : MvPolynomial G.SimpleCycle ℂ) = a • monomial m 1 := by
  rw [smul_monomial, smul_eq_mul, mul_one]

/-- The coordinate of the image of a monomial at the state of the cycle union of a compatible
exponent vector: nonzero for that exponent vector and zero for every other monomial. -/
theorem exists_cyclePolynomialToTor_monomial_coord {m₀ : G.SimpleCycle →₀ ℕ}
    (hm₀ : G.IsCompatibleExponent m₀) :
    ∃ c : ℂ, c ≠ 0 ∧ ∀ m : G.SimpleCycle →₀ ℕ,
      G.incidenceTorFullState 0 (G.cyclePolynomialToTor (monomial m 1))
          (G.cycleUnionState _ (G.isCycleUnion_biUnion_val hm₀.2)) =
        if m = m₀ then c else 0 := by
  classical
  obtain ⟨n, hn⟩ := G.exists_cyclePolynomialToTor_monomial hm₀
  have hS₀ := G.isCycleUnion_biUnion_val hm₀.2
  refine ⟨(-1) ^ n, pow_ne_zero n (neg_ne_zero.mpr one_ne_zero), fun m => ?_⟩
  split_ifs with hm
  · subst hm
    rw [hn, map_smul, G.incidenceTorFullState_cycleUnionClass hS₀, Finsupp.smul_apply,
      single_eq_same, smul_eq_mul, mul_one]
  by_cases hc : G.IsCompatibleExponent m
  · obtain ⟨n', hn'⟩ := G.exists_cyclePolynomialToTor_monomial hc
    have hS := G.isCycleUnion_biUnion_val hc.2
    rw [hn', map_smul, G.incidenceTorFullState_cycleUnionClass hS, Finsupp.smul_apply,
      single_apply, ite_eq_right, smul_zero]
    intro hst
    apply hm
    have h1 : m.support.biUnion Subtype.val = m₀.support.biUnion Subtype.val :=
      congrArg Sigma.fst hst
    exact hc.eq_of_support_eq hm₀ (G.eq_of_biUnion_val_eq hc.2 hm₀.2 h1)
  · rw [G.cyclePolynomialToTor_monomial_of_not_compatible hc, map_zero, Finsupp.zero_apply]

/-- **The kernel is the cycle-compatibility ideal.** A cycle polynomial goes to zero in
degree-zero Tor exactly when it lies in the ideal generated by `z_C z_D` for cycles sharing a
vertex. -/
theorem cyclePolynomialToTor_eq_zero_iff (f : MvPolynomial G.SimpleCycle ℂ) :
    G.cyclePolynomialToTor f = 0 ↔ f ∈ G.cycleCompatibilityIdeal := by
  classical
  refine ⟨fun hf => ?_, G.cyclePolynomialToTor_eq_zero_of_mem⟩
  rw [cycleCompatibilityIdeal_eq, mem_ideal_span_monomial_image]
  intro m₀ hm₀
  by_contra h
  push Not at h
  have hc := G.isCompatibleExponent_of_forall_not_le h
  obtain ⟨c, hc0, hcoord⟩ := G.exists_cyclePolynomialToTor_monomial_coord hc
  set b := G.cycleUnionState _ (G.isCycleUnion_biUnion_val hc.2)
  let L : MvPolynomial G.SimpleCycle ℂ →ₗ[ℂ] ℂ :=
    (Finsupp.lapply b).comp ((G.incidenceTorFullState 0).comp G.cyclePolynomialToTor.toLinearMap)
  have hL : ∀ p, L p = G.incidenceTorFullState 0 (G.cyclePolynomialToTor p) b := fun _ => rfl
  have hsum : L f = f.coeff m₀ * c := by
    conv_lhs => rw [f.as_sum, map_sum]
    rw [Finset.sum_eq_single m₀]
    · rw [monomial_eq_smul_monomial_one, map_smul, hL, hcoord, ite_eq_left rfl, smul_eq_mul]
    · intro m _ hm
      rw [monomial_eq_smul_monomial_one, map_smul, hL, hcoord, ite_eq_right hm, smul_zero]
    · intro hm
      exact absurd hm₀ hm
  have h0 : L f = 0 := by rw [hL, hf, map_zero, Finsupp.zero_apply]
  rw [h0] at hsum
  exact (MvPolynomial.mem_support_iff.mp hm₀) ((mul_eq_zero.mp hsum.symm).resolve_right hc0)

/-- The class of a cycle union is a sign times the image of the product of the generators of
its simple cycles. -/
theorem exists_cycleUnionClass_eq {S : Finset E} (hS : G.IsCycleUnion S) :
    ∃ n : ℕ, G.cycleUnionClass S =
      (-1 : ℂ) ^ n • G.cyclePolynomialToTor (∏ C ∈ G.cyclesIn S, X C) := by
  obtain ⟨n, hn⟩ := G.prod_cycleClass (G.isVertexDisjoint_cyclesIn hS)
  refine ⟨n, ?_⟩
  rw [map_prod]
  simp only [cyclePolynomialToTor_X]
  rw [hn, G.biUnion_cyclesIn hS, smul_smul, ← pow_add, ← two_mul, pow_mul, neg_one_sq, one_pow,
    one_smul]

/-- The class of every cycle union lies in the image of the cycle polynomials. -/
theorem cycleUnionClass_mem_range (S : Finset E) :
    G.cycleUnionClass S ∈ G.cyclePolynomialToTor.range := by
  by_cases hS : G.IsCycleUnion S
  · obtain ⟨n, hn⟩ := G.exists_cycleUnionClass_eq hS
    rw [hn]
    exact Subalgebra.smul_mem _ (G.cyclePolynomialToTor.mem_range_self _) _
  · rw [G.cycleUnionClass_of_not hS]
    exact zero_mem _

/-- **Surjectivity.** Every degree-zero Tor class is the image of a cycle polynomial. -/
theorem cyclePolynomialToTor_surjective : Function.Surjective G.cyclePolynomialToTor := by
  intro x
  suffices hx : x ∈ G.cyclePolynomialToTor.range from hx
  rw [← (G.incidenceTorEquivState 0).symm_apply_apply x]
  induction G.incidenceTorEquivState 0 x using Finsupp.induction_linear with
  | zero => rw [map_zero]; exact zero_mem _
  | add y z hy hz => rw [map_add]; exact add_mem hy hz
  | single b c =>
    rw [incidenceTorEquivState_symm_single]
    exact Subalgebra.smul_mem _ (G.cycleUnionClass_mem_range _) c

/-! ## The isomorphism -/

/-- The algebra map from the cycle-compatibility algebra to degree-zero Tor. -/
noncomputable def cycleAlgebraToTor : G.CycleAlgebra →ₐ[ℂ] G.incidenceTor 0 :=
  Ideal.Quotient.liftₐ G.cycleCompatibilityIdeal G.cyclePolynomialToTor
    (fun _ hf => G.cyclePolynomialToTor_eq_zero_of_mem hf)

/-- The map from the cycle-compatibility algebra on the class of a polynomial. -/
theorem cycleAlgebraToTor_mk (f : MvPolynomial G.SimpleCycle ℂ) :
    G.cycleAlgebraToTor (Ideal.Quotient.mk G.cycleCompatibilityIdeal f) =
      G.cyclePolynomialToTor f :=
  rfl

/-- The map from the cycle-compatibility algebra to degree-zero Tor is bijective. -/
theorem cycleAlgebraToTor_bijective : Function.Bijective G.cycleAlgebraToTor := by
  constructor
  · rw [injective_iff_map_eq_zero]
    intro a ha
    obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective a
    rw [cycleAlgebraToTor_mk, cyclePolynomialToTor_eq_zero_iff] at ha
    exact Ideal.Quotient.eq_zero_iff_mem.mpr ha
  · intro x
    obtain ⟨f, rfl⟩ := G.cyclePolynomialToTor_surjective x
    exact ⟨_, G.cycleAlgebraToTor_mk f⟩

/-- **The cycle-compatibility algebra (`alg:cycle-product`, `alg:cycle-algebra`).** Degree-zero
Tor of the incidence ring over the coefficient ring at the coefficient origin, with the standard
Tor product, is isomorphic as a complex algebra to
`ℂ[z_C : C simple cycle] / (z_C z_D : V(C) ∩ V(D) ≠ ∅)`, by `z_C ↦ cycleClass C`. -/
noncomputable def cycleAlgebraEquivTor : G.CycleAlgebra ≃ₐ[ℂ] G.incidenceTor 0 :=
  AlgEquiv.ofBijective G.cycleAlgebraToTor G.cycleAlgebraToTor_bijective

/-- The isomorphism on the class of a polynomial. -/
theorem cycleAlgebraEquivTor_mk (f : MvPolynomial G.SimpleCycle ℂ) :
    G.cycleAlgebraEquivTor (Ideal.Quotient.mk G.cycleCompatibilityIdeal f) =
      G.cyclePolynomialToTor f :=
  rfl

/-- The isomorphism sends the generator `z_C` to the class of the cycle `C`. -/
theorem cycleAlgebraEquivTor_X (C : G.SimpleCycle) :
    G.cycleAlgebraEquivTor (Ideal.Quotient.mk G.cycleCompatibilityIdeal (X C)) =
      G.cycleClass C :=
  G.cyclePolynomialToTor_X C

/-- The full state of the image of `z_C`: coefficient one at the unique state of the cycle `C`
and zero elsewhere. -/
theorem incidenceTorFullState_cycleAlgebraEquivTor_X (C : G.SimpleCycle) :
    G.incidenceTorFullState 0
        (G.cycleAlgebraEquivTor (Ideal.Quotient.mk G.cycleCompatibilityIdeal (X C))) =
      single (G.cycleUnionState C.val C.property.isCycleUnion) 1 := by
  rw [cycleAlgebraEquivTor_X, cycleClass, G.incidenceTorFullState_cycleUnionClass]

/-- The isomorphism is multiplicative for the standard Tor product. -/
theorem cycleAlgebraEquivTor_mul (a b : G.CycleAlgebra) :
    G.cycleAlgebraEquivTor (a * b) =
      G.incidenceTorProduct 0 0 (G.cycleAlgebraEquivTor a) (G.cycleAlgebraEquivTor b) :=
  map_mul G.cycleAlgebraEquivTor a b

/-- The isomorphism sends the unit to the unit of the Tor algebra. -/
theorem cycleAlgebraEquivTor_one : G.cycleAlgebraEquivTor 1 = G.incidenceTorOne :=
  map_one G.cycleAlgebraEquivTor

/-- The isomorphism sends the monomial of a vertex-disjoint family of simple cycles to a sign
times the class of their union. -/
theorem exists_cycleAlgebraEquivTor_prod {s : Finset G.SimpleCycle} (hs : G.IsVertexDisjoint s) :
    ∃ n : ℕ, G.cycleAlgebraEquivTor
        (Ideal.Quotient.mk G.cycleCompatibilityIdeal (∏ C ∈ s, X C)) =
      (-1 : ℂ) ^ n • G.cycleUnionClass (s.biUnion Subtype.val) := by
  rw [cycleAlgebraEquivTor_mk, map_prod]
  simp only [cyclePolynomialToTor_X]
  exact G.prod_cycleClass hs

/-! ## Grading -/

/-- The class of an edge set lies in internal degree its number of edges. -/
theorem cycleUnionClass_mem_internalPiece (S : Finset E) :
    G.cycleUnionClass S ∈ G.incidenceTorInternalPiece 0 S.card := by
  by_cases hS : G.IsCycleUnion S
  · rw [mem_incidenceTorInternalPiece_iff, cycleUnionClass, dite_eq_left hS,
      LinearEquiv.apply_symm_apply]
    exact Finsupp.single_mem_supported ℂ 1
      (show G.incResolutionInternalDegree (G.cycleUnionState S hS) = S.card from rfl)
  · rw [G.cycleUnionClass_of_not hS]
    exact zero_mem _

/-- Weighted homogeneous cycle polynomials of weight `q` go to internal degree `q`. -/
theorem cyclePolynomialToTor_mem_internalPiece {q : ℕ} {f : MvPolynomial G.SimpleCycle ℂ}
    (hf : f ∈ weightedHomogeneousSubmodule ℂ G.cycleWeight q) :
    G.cyclePolynomialToTor f ∈ G.incidenceTorInternalPiece 0 q := by
  rw [f.as_sum, map_sum]
  refine Submodule.sum_mem _ fun m hm => ?_
  have hw : Finsupp.weight G.cycleWeight m = q := hf (MvPolynomial.mem_support_iff.mp hm)
  rw [monomial_eq_smul_monomial_one, map_smul]
  refine Submodule.smul_mem _ _ ?_
  by_cases hc : G.IsCompatibleExponent m
  · obtain ⟨n, hn⟩ := G.exists_cyclePolynomialToTor_monomial hc
    rw [hn]
    refine Submodule.smul_mem _ _ ?_
    rw [← hw, hc.weight_eq]
    exact G.cycleUnionClass_mem_internalPiece _
  · rw [G.cyclePolynomialToTor_monomial_of_not_compatible hc]
    exact zero_mem _

/-- The product of the generators of the simple cycles in a cycle union is weighted homogeneous
of weight its number of edges. -/
theorem prod_X_cyclesIn_mem {S : Finset E} (hS : G.IsCycleUnion S) :
    (∏ C ∈ G.cyclesIn S, X C : MvPolynomial G.SimpleCycle ℂ) ∈
      weightedHomogeneousSubmodule ℂ G.cycleWeight S.card := by
  have h := IsWeightedHomogeneous.prod (G.cyclesIn S) (fun C => (X C : MvPolynomial _ ℂ))
    G.cycleWeight (fun C _ => isWeightedHomogeneous_X ℂ G.cycleWeight C)
  have hcard : ∑ C ∈ G.cyclesIn S, G.cycleWeight C = S.card := by
    conv_rhs => rw [← G.biUnion_cyclesIn hS]
    rw [G.card_biUnion_val (G.isVertexDisjoint_cyclesIn hS)]
    rfl
  rw [hcard] at h
  exact h

/-- Every degree-zero Tor class of internal degree `q` is the image of a weighted homogeneous
cycle polynomial of weight `q`. -/
theorem exists_cyclePolynomialToTor_eq_of_mem_internalPiece {q : ℕ} {x : G.incidenceTor 0}
    (hx : x ∈ G.incidenceTorInternalPiece 0 q) :
    ∃ f ∈ weightedHomogeneousSubmodule ℂ G.cycleWeight q, G.cyclePolynomialToTor f = x := by
  suffices h : x ∈ (weightedHomogeneousSubmodule ℂ G.cycleWeight q).map
      G.cyclePolynomialToTor.toLinearMap by
    obtain ⟨f, hf, hfx⟩ := Submodule.mem_map.mp h
    exact ⟨f, hf, hfx⟩
  rw [mem_incidenceTorInternalPiece_iff] at hx
  rw [← (G.incidenceTorEquivState 0).symm_apply_apply x,
    ← (G.incidenceTorEquivState 0 x).sum_single, Finsupp.sum, map_sum]
  refine Submodule.sum_mem _ fun b hb => ?_
  rw [incidenceTorEquivState_symm_single]
  refine Submodule.smul_mem _ _ ?_
  have hS := G.isCycleUnion_of_incResolutionDegree_eq_zero b.val b.property
  have hq : b.val.1.card = q := (Finsupp.mem_supported ℂ _).mp hx hb
  obtain ⟨n, hn⟩ := G.exists_cycleUnionClass_eq hS
  rw [hn]
  refine Submodule.smul_mem _ _ ⟨_, ?_, rfl⟩
  rw [← hq]
  exact G.prod_X_cyclesIn_mem hS

/-- **The isomorphism is graded.** An element of the cycle-compatibility algebra has weight `q`
(with `deg z_C = |C|`) exactly when its image lies in internal degree `q` of degree-zero Tor. -/
theorem cycleAlgebraEquivTor_mem_internalPiece_iff (q : ℕ) (a : G.CycleAlgebra) :
    G.cycleAlgebraEquivTor a ∈ G.incidenceTorInternalPiece 0 q ↔ a ∈ G.cycleAlgebraPiece q := by
  constructor
  · intro ha
    obtain ⟨f, hf, hfa⟩ := G.exists_cyclePolynomialToTor_eq_of_mem_internalPiece ha
    refine ⟨f, hf, G.cycleAlgebraEquivTor.injective ?_⟩
    change G.cycleAlgebraEquivTor (Ideal.Quotient.mk _ f) = _
    rw [cycleAlgebraEquivTor_mk, hfa]
  · rintro ⟨f, hf, rfl⟩
    change G.cycleAlgebraEquivTor (Ideal.Quotient.mk _ f) ∈ _
    rw [cycleAlgebraEquivTor_mk]
    exact G.cyclePolynomialToTor_mem_internalPiece hf

/-- The isomorphism maps the weight-`q` piece of the cycle-compatibility algebra onto internal
degree `q` of degree-zero Tor. -/
theorem map_cycleAlgebraPiece (q : ℕ) :
    (G.cycleAlgebraPiece q).map G.cycleAlgebraEquivTor.toLinearEquiv.toLinearMap =
      G.incidenceTorInternalPiece 0 q := by
  ext x
  rw [Submodule.mem_map]
  constructor
  · rintro ⟨a, ha, rfl⟩
    exact (G.cycleAlgebraEquivTor_mem_internalPiece_iff q a).2 ha
  · intro hx
    obtain ⟨a, rfl⟩ := G.cycleAlgebraEquivTor.surjective x
    exact ⟨a, (G.cycleAlgebraEquivTor_mem_internalPiece_iff q a).1 hx, rfl⟩

/-- The weight-`q` piece of the cycle-compatibility algebra has dimension `β_{0,q}`. -/
theorem finrank_cycleAlgebraPiece (q : ℕ) :
    Module.finrank ℂ (G.cycleAlgebraPiece q) = G.betti 0 q := by
  rw [← G.finrank_incidenceTorInternalPiece 0 q, ← G.map_cycleAlgebraPiece q]
  exact (G.cycleAlgebraEquivTor.toLinearEquiv.submoduleMap _).finrank_eq

/-- The cycle-compatibility algebra has dimension the number of cycle unions, that is, of edge
sets with every vertex degree zero or two. -/
theorem finrank_cycleAlgebra :
    Module.finrank ℂ G.CycleAlgebra = (Finset.univ.filter G.IsCycleUnion).card := by
  rw [G.cycleAlgebraEquivTor.toLinearEquiv.finrank_eq]
  exact (G.finrank_incidenceTor 0).trans G.sum_betti_zero_eq_card

/-- The cycle-compatibility algebra has dimension the number of collections of vertex-disjoint
simple cycles, the empty collection included. -/
theorem finrank_cycleAlgebra_eq_card_cycleCollections [DecidablePred G.IsCycleCollection] :
    Module.finrank ℂ G.CycleAlgebra = (Finset.univ.filter G.IsCycleCollection).card := by
  rw [G.finrank_cycleAlgebra, G.card_cycleCollections]

/-! ## The grading of the cycle-compatibility algebra -/

/-- The relation `z_C z_D = 0` for simple cycles sharing a vertex, in the cycle-compatibility
algebra. -/
theorem cycleAlgebra_X_mul_X_eq_zero {C D : G.SimpleCycle}
    (h : ¬ Disjoint (G.support C.val) (G.support D.val)) :
    (Ideal.Quotient.mk G.cycleCompatibilityIdeal (X C) *
      Ideal.Quotient.mk G.cycleCompatibilityIdeal (X D) : G.CycleAlgebra) = 0 := by
  rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem]
  exact Ideal.subset_span ⟨C, D, h, rfl⟩

/-- The relation `z_C² = 0` in the cycle-compatibility algebra. -/
theorem cycleAlgebra_X_mul_self (C : G.SimpleCycle) :
    (Ideal.Quotient.mk G.cycleCompatibilityIdeal (X C) *
      Ideal.Quotient.mk G.cycleCompatibilityIdeal (X C) : G.CycleAlgebra) = 0 := by
  rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem]
  exact G.X_mul_self_mem_cycleCompatibilityIdeal C

/-- The generator `z_C` has weight `|C|`. -/
theorem mk_X_mem_cycleAlgebraPiece (C : G.SimpleCycle) :
    Ideal.Quotient.mk G.cycleCompatibilityIdeal (X C) ∈ G.cycleAlgebraPiece C.val.card :=
  ⟨X C, isWeightedHomogeneous_X ℂ G.cycleWeight C, rfl⟩

/-- The unit has weight zero. -/
theorem one_mem_cycleAlgebraPiece : (1 : G.CycleAlgebra) ∈ G.cycleAlgebraPiece 0 :=
  ⟨1, isWeightedHomogeneous_one ℂ G.cycleWeight,
    map_one (Ideal.Quotient.mkₐ ℂ G.cycleCompatibilityIdeal)⟩

/-- Weights add under multiplication. -/
theorem mul_mem_cycleAlgebraPiece {p q : ℕ} {a b : G.CycleAlgebra}
    (ha : a ∈ G.cycleAlgebraPiece p) (hb : b ∈ G.cycleAlgebraPiece q) :
    a * b ∈ G.cycleAlgebraPiece (p + q) := by
  obtain ⟨f, hf, rfl⟩ := ha
  obtain ⟨g, hg, rfl⟩ := hb
  exact ⟨f * g, IsWeightedHomogeneous.mul hf hg,
    map_mul (Ideal.Quotient.mkₐ ℂ G.cycleCompatibilityIdeal) f g⟩

/-- The weight pieces span the cycle-compatibility algebra. -/
theorem iSup_cycleAlgebraPiece : ⨆ q, G.cycleAlgebraPiece q = ⊤ := by
  rw [eq_top_iff]
  rintro a -
  obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective a
  rw [f.as_sum, map_sum]
  exact Submodule.sum_mem _ fun m _ => Submodule.mem_iSup_of_mem (Finsupp.weight G.cycleWeight m)
    ⟨monomial m (f.coeff m), isWeightedHomogeneous_monomial _ _ _ rfl, rfl⟩

/-- The weight pieces of the cycle-compatibility algebra are independent. -/
theorem iSupIndep_cycleAlgebraPiece : iSupIndep G.cycleAlgebraPiece := by
  apply (iSupIndep_iff_finsetSum_eq_zero_imp_eq_zero G.cycleAlgebraPiece).mpr
  intro s a ha hs q hq
  apply G.cycleAlgebraEquivTor.injective
  rw [map_zero]
  refine G.incidenceTorInternalPiece_sum_unique 0 s (fun n => G.cycleAlgebraEquivTor (a n))
    (fun n hn => (G.cycleAlgebraEquivTor_mem_internalPiece_iff n (a n)).2 (ha n hn)) ?_ hq
  rw [← map_sum, hs, map_zero]

/-- **The cycle-compatibility algebra is graded by `deg z_C = |C|`.** It is the internal direct
sum of its weight pieces. -/
theorem isInternal_cycleAlgebraPiece : DirectSum.IsInternal G.cycleAlgebraPiece :=
  (DirectSum.isInternal_submodule_iff_iSupIndep_and_iSup_eq_top _).mpr
    ⟨G.iSupIndep_cycleAlgebraPiece, G.iSup_cycleAlgebraPiece⟩

end BPFixedPoints.Multigraph
