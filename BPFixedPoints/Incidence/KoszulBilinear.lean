import BPFixedPoints.Incidence.KoszulAffine

/-!
# Local Koszul contraction for four-coefficient edge equations

Independently eliminate the constant coefficient of every edge over any
commutative coefficient ring. Vertex coordinates may be arbitrary ring elements,
so this applies to every polynomial/Laurent Čech face.
-/

namespace BPFixedPoints.Koszul

set_option linter.unusedSectionVars false

open MvPolynomial

variable {E R : Type*} [CommRing R]

def pivotIndex (e : E) : E × Fin 2 × Fin 2 := (e, 0, 0)

theorem pivotIndex_injective : Function.Injective (pivotIndex (E := E)) := by
  intro e f h
  exact congrArg Prod.fst h

/-- Split each edge's four coefficients into its constant pivot and three remaining coefficients. -/
def coeffSplit : (E × Fin 2 × Fin 2) ≃ E ⊕ (E × Fin 3) where
  toFun := fun (e, α, β) =>
    if α = 0 then if β = 0 then Sum.inl e else Sum.inr (e, 0)
    else if β = 0 then Sum.inr (e, 1) else Sum.inr (e, 2)
  invFun := Sum.elim (fun e => (e, 0, 0))
    (fun (e, k) => (e, if k = 0 then 0 else 1, if k = 1 then 0 else 1))
  left_inv := by
    rintro ⟨e, α, β⟩
    fin_cases α <;> fin_cases β <;> rfl
  right_inv := by
    rintro (e | ⟨e, k⟩)
    · rfl
    · fin_cases k <;> rfl

/-- The three nonpivot terms. -/
noncomputable def bilinearTail (x y : E → R) (e : E) : MvPolynomial (E × Fin 3) R :=
  X (e, 0) * C (y e) + X (e, 1) * C (x e) + X (e, 2) * C (x e) * C (y e)

/-- Four-term edge equation on the zero chart. -/
noncomputable def bilinearEquation (x y : E → R) (e : E) :
    MvPolynomial (E × Fin 2 × Fin 2) R :=
  X (e, 0, 0) + X (e, 0, 1) * C (y e) + X (e, 1, 0) * C (x e) +
    X (e, 1, 1) * C (x e) * C (y e)

/-- Triangular isomorphism sending each pivot coefficient to its edge equation. -/
noncomputable def bilinearEquiv (x y : E → R) :
    MvPolynomial (E × Fin 2 × Fin 2) R ≃ₐ[R] MvPolynomial (E × Fin 2 × Fin 2) R :=
  (renameEquiv R coeffSplit).trans
    ((triangularEquiv (bilinearTail x y)).trans (renameEquiv R coeffSplit.symm))

@[simp] theorem bilinearEquiv_X_pivot (x y : E → R) (e : E) :
    bilinearEquiv x y (X (e, 0, 0)) = bilinearEquation x y e := by
  simp [bilinearEquiv, coeffSplit, bilinearTail, bilinearEquation, add_assoc]

/-- Permutation of the two coefficient indices for each edge. -/
def coeffFlip (τ₁ τ₂ : E → Fin 2 ≃ Fin 2) :
    (E × Fin 2 × Fin 2) ≃ (E × Fin 2 × Fin 2) where
  toFun := fun (e, α, β) => (e, τ₁ e α, τ₂ e β)
  invFun := fun (e, α, β) => (e, (τ₁ e).symm α, (τ₂ e).symm β)
  left_inv := by rintro ⟨e, α, β⟩; simp
  right_inv := by rintro ⟨e, α, β⟩; simp

/-- Edge equation adapted to any zero/infinity chart choice. -/
noncomputable def flippedBilinearEquation (τ₁ τ₂ : E → Fin 2 ≃ Fin 2)
    (x y : E → R) (e : E) : MvPolynomial (E × Fin 2 × Fin 2) R :=
  rename (coeffFlip τ₁ τ₂) (bilinearEquation x y e)

noncomputable def flippedBilinearEquiv (τ₁ τ₂ : E → Fin 2 ≃ Fin 2) (x y : E → R) :
    MvPolynomial (E × Fin 2 × Fin 2) R ≃ₐ[R] MvPolynomial (E × Fin 2 × Fin 2) R :=
  (bilinearEquiv x y).trans (renameEquiv R (coeffFlip τ₁ τ₂))

@[simp] theorem flippedBilinearEquiv_X_pivot (τ₁ τ₂ : E → Fin 2 ≃ Fin 2)
    (x y : E → R) (e : E) :
    flippedBilinearEquiv τ₁ τ₂ x y (X (e, 0, 0)) =
      flippedBilinearEquation τ₁ τ₂ x y e := by
  simp [flippedBilinearEquiv, flippedBilinearEquation]

section Contraction

variable [LinearOrder E] [Fintype E]

/-- Ideal generated by the actual edge equations on a face. -/
noncomputable def bilinearIdeal (τ₁ τ₂ : E → Fin 2 ≃ Fin 2) (x y : E → R) :
    Ideal (MvPolynomial (E × Fin 2 × Fin 2) R) :=
  Ideal.span (Set.range (flippedBilinearEquation τ₁ τ₂ x y))

theorem transportedIdeal_bilinear (τ₁ τ₂ : E → Fin 2 ≃ Fin 2) (x y : E → R) :
    transportedIdeal pivotIndex (flippedBilinearEquiv τ₁ τ₂ x y) =
      bilinearIdeal τ₁ τ₂ x y := by
  simp [transportedIdeal, bilinearIdeal, pivotIndex]

/-- Contract the four-coefficient edge Koszul complex to its actual degree-zero quotient. -/
noncomputable def bilinearContraction (τ₁ τ₂ : E → Fin 2 ≃ Fin 2) (x y : E → R) :
    IncidencePerturbation.Contraction R (Space E (MvPolynomial (E × Fin 2 × Fin 2) R))
      (MvPolynomial (E × Fin 2 × Fin 2) R ⧸ bilinearIdeal τ₁ τ₂ x y) :=
  (transportedContraction pivotIndex
    pivotIndex_injective (flippedBilinearEquiv τ₁ τ₂ x y)).congr
      (LinearEquiv.refl R _) (Ideal.quotientEquivAlgOfEq R
        (transportedIdeal_bilinear τ₁ τ₂ x y)).toLinearEquiv

theorem bilinearContraction_d (τ₁ τ₂ : E → Fin 2 ≃ Fin 2) (x y : E → R) :
    (bilinearContraction τ₁ τ₂ x y).d =
      (differential (flippedBilinearEquation τ₁ τ₂ x y)).restrictScalars R := by
  rw [bilinearContraction, IncidencePerturbation.Contraction.congr_refl_d]
  exact (transportedContraction_d pivotIndex pivotIndex_injective
    (flippedBilinearEquiv τ₁ τ₂ x y)).trans (by simp [pivotIndex])

theorem bilinearContraction_p (τ₁ τ₂ : E → Fin 2 ≃ Fin 2) (x y : E → R)
    (z : Space E (MvPolynomial (E × Fin 2 × Fin 2) R)) :
    (bilinearContraction τ₁ τ₂ x y).p z =
      Ideal.Quotient.mk (bilinearIdeal τ₁ τ₂ x y) (z ∅) := by
  rw [bilinearContraction, IncidencePerturbation.Contraction.congr_refl_p_apply]
  rw [transportedContraction_p]
  exact Ideal.quotientEquivAlgOfEq_mk R (transportedIdeal_bilinear τ₁ τ₂ x y) (z ∅)

end Contraction

end BPFixedPoints.Koszul
