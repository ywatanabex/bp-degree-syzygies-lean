alias alg_incidence_projective_refinement := Multigraph.incidenceFaceVertexMorphism_refinement

/-- **`alg:incidence-vector-bundle` (actual chart inverse images)** Proved. The
original incidence chart open is the exact inverse image of the actual projective chart. -/
alias alg_incidence_projective_preimage := Multigraph.incidenceProjectiveMorphism_preimage_chart

/-- **`alg:incidence-vector-bundle` (actual quotient pullbacks)** Proved. The original
quotient chart squares in the actual projective product are scheme pullbacks. -/
alias alg_incidence_projective_chart := Multigraph.incidenceProjectiveChart_isPullback

/-- **`alg:incidence-vector-bundle` (actual closed embedding)** Proved. The original
