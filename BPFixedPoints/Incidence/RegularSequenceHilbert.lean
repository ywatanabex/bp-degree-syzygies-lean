import BPFixedPoints.Incidence.RegularLinearHilbert
import Mathlib.RingTheory.Ideal.Quotient.Operations

/-! # Hilbert series of quotients by homogeneous linear regular sequences -/

namespace BPFixedPoints.ResolutionTools

open RingTheory.Sequence
open scoped PowerSeries
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 800000

universe u v
variable {k : Type v} [Field k]
  {A : Type u} [CommRing A] [Algebra k A]

/-- Passing through an algebra isomorphism does not change the dimensions of the images. -/
theorem gradedHilbertSeries_map_equiv {B : Type*} [CommRing B] [Algebra k B]
    (ℳ : ℕ → Submodule k A) (e : A ≃ₐ[k] B) :
    gradedHilbertSeries (fun q => (ℳ q).map e.toLinearEquiv.toLinearMap) =
      gradedHilbertSeries ℳ := by
  ext q
  simp only [gradedHilbertSeries, PowerSeries.coeff_mk, LinearEquiv.finrank_map_eq]

theorem gradedHilbertSeries_quotient_of_surjective {B : Type*} [CommRing B] [Algebra k B]
    (ℳ : ℕ → Submodule k A) (f : A →ₐ[k] B) (hf : Function.Surjective f)
    (I : Ideal A) (hi : I = RingHom.ker f) :
    gradedHilbertSeries (fun q => (ℳ q).map f.toLinearMap) =
      gradedHilbertSeries (gradedQuotientPiece ℳ I) := by
  let e : (A ⧸ I) ≃ₐ[k] B :=
    (Ideal.quotientEquivAlgOfEq k hi).trans (Ideal.quotientKerAlgEquivOfSurjective hf)
  have he : e.toLinearEquiv.toLinearMap.comp (Ideal.Quotient.mkₐ k I).toLinearMap =
      f.toLinearMap := by ext a; rfl
  have hp (q) : (gradedQuotientPiece ℳ I q).map e.toLinearEquiv.toLinearMap =
      (ℳ q).map f.toLinearMap := by
    change ((ℳ q).map _).map _ = _
    rw [← Submodule.map_comp, he]
  simpa only [hp] using gradedHilbertSeries_map_equiv (gradedQuotientPiece ℳ I) e

theorem gradedHilbertSeries_quotient_nil (ℳ : ℕ → Submodule k A) :
    gradedHilbertSeries (gradedQuotientPiece ℳ (Ideal.ofList [])) =
      gradedHilbertSeries ℳ := by
  have h := gradedHilbertSeries_quotient_of_surjective ℳ (AlgHom.id k A)
    Function.surjective_id (Ideal.ofList []) (by ext a; simp)
  simpa using h.symm

theorem gradedHilbertSeries_quotient_cons (ℳ : ℕ → Submodule k A) (x : A) (rs : List A) :
    gradedHilbertSeries (gradedQuotientPiece ℳ (Ideal.ofList (x :: rs))) =
      gradedHilbertSeries (gradedQuotientPiece (gradedQuotientPiece ℳ (Ideal.span {x}))
        (Ideal.ofList (rs.map (Ideal.Quotient.mk (Ideal.span {x}))))) := by
  let I : Ideal A := Ideal.span {x}
  let J : Ideal (A ⧸ I) := Ideal.ofList (rs.map (Ideal.Quotient.mk I))
  let f := (Ideal.Quotient.mkₐ k J).comp (Ideal.Quotient.mkₐ k I)
  have hf : Function.Surjective f := Ideal.Quotient.mk_surjective.comp Ideal.Quotient.mk_surjective
  have hker : Ideal.ofList (x :: rs) = RingHom.ker f := by
    change _ = RingHom.ker ((Ideal.Quotient.mk J).comp (Ideal.Quotient.mk I))
    rw [← RingHom.comap_ker, Ideal.mk_ker]
    rw [show J = (Ideal.ofList rs).map (Ideal.Quotient.mk I) by rw [Ideal.map_ofList],
      Ideal.comap_map_of_surjective _ Ideal.Quotient.mk_surjective,
      ← RingHom.ker_eq_comap_bot, Ideal.mk_ker]
    exact (Ideal.ofList_cons x rs).trans (sup_comm _ _)
  have h := gradedHilbertSeries_quotient_of_surjective ℳ f hf _ hker
  have hm (q) : gradedQuotientPiece (gradedQuotientPiece ℳ I) J q =
      (ℳ q).map f.toLinearMap := by
    change ((ℳ q).map _).map _ = _
    rw [← Submodule.map_comp]
    rfl
  rw [show gradedQuotientPiece (gradedQuotientPiece ℳ I) J =
    (fun q => (ℳ q).map f.toLinearMap) from funext hm]
  exact h.symm

theorem regular_tail_on_quotient (x : A) (rs : List A) (hr : IsRegular A (x :: rs)) :
    IsRegular (A ⧸ Ideal.span {x}) (rs.map (Ideal.Quotient.mk (Ideal.span {x}))) := by
  let e : QuotSMulTop x A ≃ₗ[A] (A ⧸ Ideal.span {x}) :=
    Submodule.quotEquivOfEq _ _ (by rw [← Submodule.ideal_span_singleton_smul]; simp)
  apply (AddEquiv.isRegular_congr (e := e.toAddEquiv) ?_).mp
    ((isRegular_cons_iff A x rs).mp hr).2
  apply List.forall₂_map_right_iff.mpr
  apply List.forall₂_same.mpr
  intro r _ z
  exact e.map_smul r z

/-- The equality is for the actual quotient by the ideal generated by the given list. -/
theorem gradedHilbertSeries_quotient_regular_sequence
    {A : Type u} [CommRing A] [Algebra k A]
    (𝒜 : ℕ → Submodule k A) [GradedAlgebra 𝒜] [∀ q, Module.Finite k (𝒜 q)]
    (rs : List A) (hh : ∀ x ∈ rs, x ∈ 𝒜 1) (hr : IsRegular A rs) :
    gradedHilbertSeries (gradedQuotientPiece 𝒜 (Ideal.ofList rs)) =
      (1 - PowerSeries.X) ^ rs.length * gradedHilbertSeries 𝒜 := by
  match rs with
  | [] => simpa using gradedHilbertSeries_quotient_nil 𝒜
  | x :: rs =>
    have hx : x ∈ 𝒜 1 := hh x (by simp)
    let I : Ideal A := Ideal.span {x}
    let ℬ := gradedQuotientPiece 𝒜 I
    have hI : I.IsHomogeneous 𝒜 := Ideal.homogeneous_span 𝒜 {x} (by
      intro y hy
      obtain rfl := Set.mem_singleton_iff.mp hy
      exact ⟨1, hx⟩)
    letI : GradedAlgebra ℬ := gradedQuotientAlgebra 𝒜 I hI
    letI : ∀ q, Module.Finite k (ℬ q) := fun q => gradedQuotientPiece_finite 𝒜 I q
    have htail : ∀ y ∈ rs.map (Ideal.Quotient.mk I), y ∈ ℬ 1 := by
      intro y hy
      obtain ⟨z, hz, rfl⟩ := List.mem_map.mp hy
      exact Submodule.mem_map.mpr ⟨z, hh z (by simp [hz]), rfl⟩
    rw [gradedHilbertSeries_quotient_cons,
      gradedHilbertSeries_quotient_regular_sequence ℬ _ htail (regular_tail_on_quotient x rs hr),
      List.length_map]
    rw [gradedHilbertSeries_quotient_linear 𝒜 hx ((isRegular_cons_iff A x rs).mp hr).1]
    simp only [List.length_cons, pow_succ, mul_assoc]
termination_by rs.length

end BPFixedPoints.ResolutionTools
