/-- **`alg:tor-isomorphism` (shared state algebra)** Proved auxiliary.
The ring-generic state product of edge states is associative. -/
alias alg_state_exterior_cup_assoc := Multigraph.incStateCup_assoc

/-- **`alg:tor-isomorphism` (shared state algebra)** Proved auxiliary.
The empty edge set with the twist-zero unit is a two-sided unit. -/
alias alg_state_exterior_cup_unit_left := Multigraph.incStateCup_unit_left

/-- **`alg:tor-isomorphism` (shared state algebra)** Proved auxiliary.
The state product commutes with every change of coefficient ring. -/
alias alg_state_exterior_cup_ring_change := Multigraph.incStateCup_mapRange

/-- **`alg:tor-isomorphism` (exterior signs)** Proved auxiliary.
The project's edge shuffle sign is the sign of Mathlib's disjoint-union permutation of ordered edge sets. -/
alias alg_shuffle_sign_perm := Koszul.shuffleSign_eq_permOfDisjoint_sign

/-- **`alg:tor-isomorphism` (exterior signs)** Proved auxiliary.
The edge exterior space is Mathlib's exterior algebra on the free module of edges, with the edge wedge sent to exterior multiplication. -/
alias alg_exterior_algebra_wedge := Koszul.exteriorAlgebraEquiv_wedge

/-- **`alg:tor-isomorphism` (orientation lines)** Proved auxiliary.
The orientation line of an edge with distinct endpoints is free of rank one, generated by the wedge of its two endpoint coordinates. -/
