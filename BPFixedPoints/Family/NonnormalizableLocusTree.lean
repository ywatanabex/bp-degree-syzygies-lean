import BPFixedPoints.Family.NonnormalizableLocusRing
import BPFixedPoints.Incidence.CycleSpace

/-!
# The non-normalizable locus is generically empty on trees

The chart ring ℤ[a,x][1/D] has 2|E| variables, while the parameter family (a_e, b_i) has
|E| + |V| members. When |E| < |V| these |E| + |V| functions are algebraically dependent on every
irreducible component, so a single nonzero P ∈ ℤ[a,b] vanishes at (a, b(a,x)) for every chart point
x over every field (`exists_poly_forall_chartPoint`). Consequently the chart fiber over (a,b), and
with a_e² ≠ 1 the non-normalizable locus, is empty whenever P(a,b) ≠ 0
(`exists_poly_chartSolution_empty`, `exists_poly_nonnormalizable_empty`).

For a connected graph, |E| < |V| exactly when G is a tree, i.e. ν(G) = 0
(`card_lt_of_connected_nu_eq_zero`). This proves the tree case of `supp:nonnormalizable-dim`
(`nonnormalizable_empty_of_tree`): "generic" means P(a,b) ≠ 0 for one nonzero integer
polynomial P in the |E| + |V| parameters, the same P for every field. The polynomial is proved to
exist (one relation per irreducible component of the chart ring); it is not computed.
-/

namespace BPFixedPoints

set_option linter.unusedSectionVars false

namespace Multigraph

open BP MvPolynomial

variable {V E : Type*} [DecidableEq V] [DecidableEq E] [Fintype V] [Fintype E] (G : Multigraph V E)

/-- Evaluation of an integer polynomial through `aeval` equals evaluation of its image. -/
theorem aeval_int_eq_eval_map {ι K : Type*} [CommRing K] [Algebra ℤ K] (g : ι → K)
    (P : MvPolynomial ι ℤ) : aeval g P = eval g (map (Int.castRingHom K) P) := by
  rw [aeval_def, eval₂_eq_eval_map,
    show algebraMap ℤ K = Int.castRingHom K from RingHom.ext_int _ _]

/-- Every prime quotient of the chart ring is algebraic over the subalgebra generated by the
images of the 2|E| coordinates. -/
theorem chartRing_quotient_isAlgebraic (p : Ideal (ChartRing (E := E) ℤ)) [p.IsPrime] :
    Algebra.IsAlgebraic
      (Algebra.adjoin ℤ (Set.range (Ideal.Quotient.mk p ∘
        fun z : E ⊕ E => algebraMap (MvPolynomial (E ⊕ E) ℤ) (ChartRing (E := E) ℤ) (X z))))
      (ChartRing (E := E) ℤ ⧸ p) := by
  apply isAlgebraic_of_surjective_localizationAway (Ideal.Quotient.mk p)
    Ideal.Quotient.mk_surjective
  intro z
  exact isAlgebraic_algebraMap (⟨_, Algebra.subset_adjoin ⟨z, rfl⟩⟩ :
    Algebra.adjoin ℤ (Set.range (Ideal.Quotient.mk p ∘
      fun z : E ⊕ E => algebraMap (MvPolynomial (E ⊕ E) ℤ) (ChartRing (E := E) ℤ) (X z))))

/-- **Dimension count on the chart.** If |E| < |V|, a nonzero P ∈ ℤ[a,b] vanishes at
(a, −1/Φ(a,x)) for every chart point (a,x) over every field. -/
theorem exists_poly_forall_chartPoint (hcard : Fintype.card E < Fintype.card V) :
    ∃ P : MvPolynomial (E ⊕ V) ℤ, P ≠ 0 ∧
      ∀ (K : Type*) [Field K] (a x : E → K), IsChartPoint a x →
        aeval (Sum.elim a (fun i => -(G.chartField a x i)⁻¹)) P = 0 := by
  have hc : Fintype.card (E ⊕ E) < Fintype.card (E ⊕ V) := by
    simp only [Fintype.card_sum]
    omega
  obtain ⟨P, hP, hPψ⟩ := exists_poly_forall_ringHom_eq_zero
    (fun z : E ⊕ E => algebraMap (MvPolynomial (E ⊕ E) ℤ) (ChartRing (E := E) ℤ) (X z))
    (G.chartRingFamily ℤ) hc (fun p _ => chartRing_quotient_isAlgebraic p)
  refine ⟨P, hP, fun K _ a x hx => ?_⟩
  have h := hPψ K (chartRingEval a x hx)
  rwa [chartRingEval_comp_family] at h

/-- If |E| < |V|, the chart fiber over (a,b) is empty for P(a,b) ≠ 0, for one nonzero
P ∈ ℤ[a,b] and every field. -/
theorem exists_poly_chartSolution_empty (hcard : Fintype.card E < Fintype.card V) :
    ∃ P : MvPolynomial (E ⊕ V) ℤ, P ≠ 0 ∧
      ∀ (K : Type*) [Field K] (a : E → K) (b : V → K),
        eval (Sum.elim a b) (map (Int.castRingHom K) P) ≠ 0 → ∀ x, ¬ G.IsChartSolution a b x := by
  obtain ⟨P, hP, h⟩ := G.exists_poly_forall_chartPoint hcard
  refine ⟨P, hP, fun K _ a b hab x hx => hab ?_⟩
  have h0 := h K a x hx.1
  rw [aeval_int_eq_eval_map] at h0
  have hb : (fun i => -(G.chartField a x i)⁻¹) = b := by
    have := (G.isChartSolution_iff_eval (k := ℤ) hx.1).mp hx
    rw [chartRingEval_comp_family] at this
    funext i
    simpa using congrFun this (Sum.inr i)
  rwa [hb] at h0

/-- If |E| < |V| and a_e² ≠ 1, the non-normalizable locus at (a,b) is empty for P(a,b) ≠ 0,
for one nonzero P ∈ ℤ[a,b] and every field. -/
theorem exists_poly_nonnormalizable_empty (hcard : Fintype.card E < Fintype.card V) :
    ∃ P : MvPolynomial (E ⊕ V) ℤ, P ≠ 0 ∧
      ∀ (K : Type*) [Field K] (a : E → K) (b : V → K), (∀ e, a e ^ 2 ≠ 1) →
        eval (Sum.elim a b) (map (Int.castRingHom K) P) ≠ 0 →
          ∀ y, ¬ G.IsNonnormalizableSolution a b y := by
  obtain ⟨P, hP, h⟩ := G.exists_poly_chartSolution_empty hcard
  refine ⟨P, hP, fun K _ a b ha hab y hy => ?_⟩
  obtain ⟨x, hx⟩ := (G.nonnormalizable_nonempty_iff b ha).mp ⟨y, hy⟩
  exact h K a b hab x hx

/-- A connected graph with ν(G) = 0 (a tree) has fewer edges than vertices. -/
theorem card_lt_of_connected_nu_eq_zero (hc : G.Connected) (hν : G.nu = 0) :
    Fintype.card E < Fintype.card V := by
  have h1 := G.card_le_card_add_numComponents
  have h2 := G.numComponents_eq_one_of_connected hc
  unfold nu at hν
  omega

/-- **`supp:nonnormalizable-dim`, tree case.** Let G be a tree (connected with ν(G) = 0). There
is a nonzero P ∈ ℤ[a,b] such that for every field K and all a, b with a_e² ≠ 1 and P(a,b) ≠ 0, the
non-normalizable locus {y : fixed point, y ≠ 0, X_α + a_e ≠ 0, F_i = −1} is empty. -/
theorem nonnormalizable_empty_of_tree (hc : G.Connected) (hν : G.nu = 0) :
    ∃ P : MvPolynomial (E ⊕ V) ℤ, P ≠ 0 ∧
      ∀ (K : Type*) [Field K] (a : E → K) (b : V → K), (∀ e, a e ^ 2 ≠ 1) →
        eval (Sum.elim a b) (map (Int.castRingHom K) P) ≠ 0 →
          ∀ y, ¬ G.IsNonnormalizableSolution a b y :=
  G.exists_poly_nonnormalizable_empty (G.card_lt_of_connected_nu_eq_zero hc hν)

end Multigraph

end BPFixedPoints
