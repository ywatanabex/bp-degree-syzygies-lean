alias alg_module_generator_number := Multigraph.incidenceModuleGeneratorNumber_eq

/-- **`alg:generator-real-bridge` (minimal family)** Proved. The original augmentation gives
a generating family no larger than any finite coefficient-module generating family. -/
alias alg_module_generators_minimal := Multigraph.incidenceResolutionGenerators_minimal

/-- **`alg:generator-real-bridge` (natural grading)** Proved. These minimal generators are
homogeneous for the natural grading of the original ring. -/
alias alg_module_generators_homogeneous := Multigraph.incidenceResolutionGenerators_homogeneous

/-- **`alg:generator-real-bridge` (generator degrees)** Proved. Their number in degree q is beta_{0,q}. -/
alias alg_module_generator_degrees := Multigraph.card_incidenceResolutionGenerators_degree

/-- **`alg:generator-real-bridge` (cycle count)** Proved for the intrinsic module minimum. -/
alias alg_module_generator_cycles := Multigraph.incidenceModuleGeneratorNumber_eq_cycleCollections

/-- **`alg:generator-real-bridge` (bound)** Proved for the intrinsic module minimum. -/
alias alg_module_generator_bound := Multigraph.incidenceModuleGeneratorNumber_le

/-- **`alg:generator-real-bridge` (sharpness)** Proved with the exact graph cycle criterion. -/
alias alg_module_generator_sharp := Multigraph.incidenceModuleGeneratorNumber_eq_iff

/-- **`alg:generator-real-bridge` (real minimum)** Proved. Under the sharp cycle criterion,
the intrinsic module generator number is a lower bound for every positive external field,
and is attained at a field with finitely many real solutions and exactly one positive solution. -/
theorem alg_module_generator_min_real_count
    {V₀ E₀ : Type} [DecidableEq V₀] [Fintype V₀] [LinearOrder E₀] [Fintype E₀]
    (G₀ : Multigraph V₀ E₀) (hG : G₀.Loopless)
    (hsharp : ∀ C D, G₀.IsSimpleCycle C → G₀.IsSimpleCycle D → Disjoint C D →
      Disjoint (G₀.support C) (G₀.support D))
    {a : E₀ → ℝ} (ha : ∀ e, 0 < a e) (ha1 : ∀ e, a e ≠ 1) :
    (∀ b : V₀ → ℝ, (∀ i, 0 < b i) →
      ((G₀.incidenceModuleGeneratorNumber : ℕ) : ℕ∞) ≤
        ENat.card {y : Dart E₀ → ℝ // G₀.IsAdmissibleSolution a b y}) ∧
      ∃ b : V₀ → ℝ, (∀ i, 0 < b i) ∧
        Finite {y : Dart E₀ → ℝ // G₀.IsAdmissibleSolution a b y} ∧
        Nat.card {y : Dart E₀ → ℝ // G₀.IsAdmissibleSolution a b y} = G₀.incidenceModuleGeneratorNumber ∧
        Nat.card {y : Dart E₀ → ℝ // G₀.IsAdmissibleSolution a b y ∧ ∀ α, 0 < y α} = 1 := by
  rw [G₀.incidenceModuleGeneratorNumber_eq_iff.mpr hsharp]
  exact thm_real_ii_min G₀ hG ha ha1

/-- **`alg:generator-real-bridge`** Proved in state-sum form.
Σ_q β_{0,q} = #{collections of vertex-disjoint simple cycles} ≤ 2^ν, with equality iff any two
edge-disjoint simple cycles are vertex-disjoint; equality holds when the maximum degree is at
most 3. That the common value is the minimum real count is `intro_generator_real_bridge` and
`thm_real_ii_min`. The intrinsic minimum of module generators is identified by
`alg_module_generator_number` and has this same cycle criterion. -/
theorem alg_generator_real_bridge [DecidablePred G.IsCycleCollection] :
    ∑ q ∈ Finset.range (Fintype.card E + 1), G.betti 0 q =
        (Finset.univ.filter G.IsCycleCollection).card ∧
      ∑ q ∈ Finset.range (Fintype.card E + 1), G.betti 0 q ≤ 2 ^ G.nu ∧
      (∑ q ∈ Finset.range (Fintype.card E + 1), G.betti 0 q = 2 ^ G.nu ↔
        ∀ C D, G.IsSimpleCycle C → G.IsSimpleCycle D → Disjoint C D →
          Disjoint (G.support C) (G.support D)) ∧
      ((∀ v, G.deg Finset.univ v ≤ 3) →
        ∑ q ∈ Finset.range (Fintype.card E + 1), G.betti 0 q = 2 ^ G.nu) :=
  ⟨G.sum_betti_zero_eq_card_cycleCollections, G.sum_betti_zero_le, G.sum_betti_zero_eq_iff,
    G.sum_betti_zero_eq_of_deg_le_three⟩

/-- **The table after `alg:generator-real-bridge`** Proved for the chart model. The numerical state-sum values
(Q, Σ_q β_{0,q}, 2^ν) are proved to be (2, 2, 2) for the triangle, (48, 8, 8) for K₄ and
(6, 3, 4) for the bowtie. `alg_module_generator_table` gives the intrinsic generator counts. -/
theorem alg_generator_table :
    (Examples.triangle.Q, ∑ q ∈ Finset.range (Fintype.card (Fin 3) + 1),
        Examples.triangle.betti 0 q, 2 ^ Examples.triangle.nu) = (2, 2, 2) ∧
    (Examples.K4.Q, ∑ q ∈ Finset.range (Fintype.card (Fin 6) + 1), Examples.K4.betti 0 q,
        2 ^ Examples.K4.nu) = (48, 8, 8) ∧
    (Examples.bowtie.Q, ∑ q ∈ Finset.range (Fintype.card (Fin 6) + 1), Examples.bowtie.betti 0 q,
        2 ^ Examples.bowtie.nu) = (6, 3, 4) :=
  ⟨Examples.table_triangle, Examples.table_K4, Examples.table_bowtie⟩

/-- **The table after `alg:generator-real-bridge` (intrinsic counts)** Proved for the
original coefficient modules: triangle 2, K4 8, and bowtie 3. -/
theorem alg_module_generator_table :
    Examples.triangle.incidenceModuleGeneratorNumber = 2 ∧
      Examples.K4.incidenceModuleGeneratorNumber = 8 ∧
      Examples.bowtie.incidenceModuleGeneratorNumber = 3 := by
  rw [Examples.triangle.incidenceModuleGeneratorNumber_eq,
    Examples.K4.incidenceModuleGeneratorNumber_eq, Examples.bowtie.incidenceModuleGeneratorNumber_eq]
  exact ⟨congrArg (fun x : ℕ × ℕ × ℕ => x.2.1) alg_generator_table.1,
    congrArg (fun x : ℕ × ℕ × ℕ => x.2.1) alg_generator_table.2.1,
    congrArg (fun x : ℕ × ℕ × ℕ => x.2.1) alg_generator_table.2.2⟩

/-- **`alg:hilbert`** Proved (polynomial identities). The actual Hilbert series of the natural
chart grading is `alg_hilbert_theta`, `alg_universal_hilbert` and `alg_hilbert_reduced` below.
Linear regular Artin quotients and their Hilbert series are `alg_linear_artin_exists`
and `alg_artin_hilbert`. `alg_artin_parameter_open` proves openness of the finite-quotient
locus; `alg_artin_parameters_regular` proves regularity and its common Hilbert series. -/
theorem alg_hilbert :
    G.thetaTwoI = ∑ p ∈ Finset.range (Fintype.card E + 1),
      ∑ q ∈ Finset.range (Fintype.card E + 1), C ((-1) ^ p * (G.betti p q : ℤ)) * X ^ q ∧
    G.thetaTwoI = (1 - X) ^ G.rho * G.omegaTilde :=
  ⟨G.thetaTwoI_eq_betti, G.thetaTwoI_eq_omegaTilde⟩

/-- **`intro:hilbert`** Proved. The θ numerator of the actual natural graded ring. -/
alias alg_hilbert_theta := Multigraph.incidenceHilbertSeries_eq_theta

/-- **`alg:universal-hilbert`** Proved. The actual Hilbert series ω_G/(1−t)^{3m+n}. -/
alias alg_universal_hilbert := Multigraph.incidenceHilbertSeries_eq_omega

/-- **`alg:hilbert`** Proved. The actual Hilbert series with denominator exponent d_G and
numerator ω̃. -/
alias alg_hilbert_reduced := Multigraph.incidenceHilbertSeries_eq_omegaTilde

/-- **`alg:incidence-vector-bundle`** Proved (the degree-zero clause, for the chart model). -/
alias alg_degree_zero := Multigraph.mem_incidenceCoefficientPiece_zero

/-- **(`alg:k4-resolution`) and the K₄ section** Proved auxiliary (numerical values). They are
the row sums (8, 24, 16) of the state-sum table, the entries β_{0,0} = 1, β_{0,3} = 4,
β_{0,4} = 3, β_{1,5} = 24, β_{2,6} = 16,
θ_{K₄}(t,2i) = (1−t)²(1 + 2t + 3t² + 8t³ + 16t⁴), ω̃ = ω = 1 + 2t + 3t² + 8t³ + 16t⁴,
ω̃(1) = 30 (the value the paper identifies as the Artin length), the state-sum total
48 = N(K₄), d_G = 22 and ρ = 2. The general naturally graded resolution, its Betti identification and the actual
Hilbert series apply to K₄. A linear regular Artin quotient of dimension 30 is
`alg_k4_artin_exists` below. The graded shape of the K₄ resolution is `alg_k4_graded_betti`,
and the generators and the vanishing of products of two nonunit generator classes are
`alg_k4_module_generators` and `alg_k4_generator_products`. -/
theorem alg_k4 :
    (∑ k ∈ Finset.range 7, Examples.K4.betti 0 k, ∑ k ∈ Finset.range 7, Examples.K4.betti 1 k,
      ∑ k ∈ Finset.range 7, Examples.K4.betti 2 k) = (8, 24, 16) ∧
    (Examples.K4.betti 0 0, Examples.K4.betti 0 3, Examples.K4.betti 0 4, Examples.K4.betti 1 5,
      Examples.K4.betti 2 6) = (1, 4, 3, 24, 16) ∧
    Examples.K4.thetaTwoI = (1 - X) ^ 2 * (1 + 2 * X + 3 * X ^ 2 + 8 * X ^ 3 + 16 * X ^ 4) ∧
    Examples.K4.omegaTilde = 1 + 2 * X + 3 * X ^ 2 + 8 * X ^ 3 + 16 * X ^ 4 ∧
    Examples.K4.omega = 1 + 2 * X + 3 * X ^ 2 + 8 * X ^ 3 + 16 * X ^ 4 ∧
    Examples.K4.omegaTilde.eval 1 = 30 ∧ Examples.K4.HasGenericDegree 48 ∧
    Examples.K4.dG = 22 ∧ Examples.K4.rho = 2 :=
  ⟨Examples.K4_betti_rows, Examples.K4_betti_entries, Examples.K4_thetaTwoI,
    Examples.K4_omegaTilde, Examples.K4_omega, Examples.K4_omegaTilde_eval_one, Examples.K4_N,
    Examples.K4_dG, Examples.K4_rho⟩

/-- **`fig:k4-states`** Partial. The proved combinatorial data are the number,
weight, internal degree q and homological degree p of the contributing states of each type
