import BPFixedPoints.StrongField.Chart
import Mathlib.RingTheory.MvPolynomial.Ideal
import Mathlib.RingTheory.MvPolynomial.Basic
import Mathlib.RingTheory.LocalRing.Length
import Mathlib.RingTheory.Regular.RegularSequence

/-!
# The polynomial boundary algebra at a state (`sf:boundary-algebra`, `sf:local-algebra`)

For r : V → ℕ, `truncIdeal R r` is the monomial ideal (w_i^{r_i} : i ∈ V) of R[w_i : i ∈ V].
It is spanned by the powers w_i^{r_i}, and equally by the paper's generators
(−1)^{k_i} w_i^{r_i} (`truncIdeal_eq_span_neg_one_pow_mul_X_pow`). The monomials w^a with
a_i < r_i for all i span a complement of it (`isCompl_truncIdeal`), so their classes form a
basis `truncBasis` of the quotient, indexed by a box equivalent to Π_i Fin r_i
(`truncBoxEquiv`). Hence the quotient is free of rank ∏_i r_i (`finrank_truncIdeal`).
Over a field K with every r_i positive the quotient is local, since every w_i is nilpotent
(`isLocalRing`), and its residue field is K (`residueFieldEquiv`). Its length over itself is
∏_i r_i (`length_truncIdeal`, via `IsLocalRing.length_restrictScalars`; both sides vanish if
some r_i = 0). The powers w_i^{r_i}, each variable listed once, form a regular sequence
(`isRegular_toList_map_X_pow`): the quotient is a complete intersection.

For an edge set S with r_i = `G.rS S i`, `Multigraph.boundaryAlgebra G S` is
ℂ[w]/(w_i^{r_i}). Its dimension and its length are wt(S) = ∏_i φ(d_S(i))
(`finrank_boundaryAlgebra`, `length_boundaryAlgebra`). For a state it is local and its
generators form a regular sequence (`isLocalRing_boundaryAlgebra`, `isRegular_boundaryAlgebra`).

Scope: only the polynomial algebra is formalized here. Its identification with the local algebra
of the special fiber p = 0 of the analytic state chart and the ramification indices are in
`AnalyticBoundary.lean`; the free monomial basis over the convergent parameter ring ℂ{p}
(supplement, `supp:boundary-algebra`) is in `AnalyticFamily.lean`.
-/

namespace BPFixedPoints

set_option linter.unusedSectionVars false

namespace BoundaryAlgebra

open MvPolynomial

section Ideal

variable {V : Type*} (R : Type*) [CommRing R] (r : V → ℕ)

/-- The truncation ideal (w_i^{r_i} : i ∈ V), as the monomial ideal of the exponents r_i e_i. -/
noncomputable def truncIdeal : Ideal (MvPolynomial V R) :=
  Ideal.span ((fun a => monomial a (1 : R)) '' Set.range fun i => Finsupp.single i (r i))

/-- The exponent box {a | ∀ i, a_i < r_i}. -/
def truncBox : Set (V →₀ ℕ) := {a | ∀ i, a i < r i}

/-- The truncation ideal is generated by the powers w_i^{r_i}. -/
theorem truncIdeal_eq_span_X_pow :
    truncIdeal R r = Ideal.span (Set.range fun i => (X i ^ r i : MvPolynomial V R)) := by
  rw [truncIdeal, ← Set.range_comp]
  congr 1
  ext p
  simp [X_pow_eq_monomial]

/-- Multiplying each generator w_i^{r_i} by a unit does not change the ideal. -/
theorem truncIdeal_eq_span_unit_mul_X_pow (u : V → MvPolynomial V R) (hu : ∀ i, IsUnit (u i)) :
    truncIdeal R r = Ideal.span (Set.range fun i => u i * X i ^ r i) := by
  rw [truncIdeal_eq_span_X_pow]
  apply le_antisymm
  · rw [Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    obtain ⟨v, hv⟩ := hu i
    have : X i ^ r i = (↑v⁻¹ : MvPolynomial V R) * (u i * X i ^ r i) := by
      rw [← hv, ← mul_assoc, Units.inv_mul, one_mul]
    change X i ^ r i ∈ _
    rw [this]
    exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨i, rfl⟩)
  · rw [Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨i, rfl⟩)

/-- The paper's generators (−1)^{k_i} w_i^{r_i} span the truncation ideal. -/
theorem truncIdeal_eq_span_neg_one_pow_mul_X_pow (k : V → ℕ) :
    truncIdeal R r =
      Ideal.span (Set.range fun i => ((-1) ^ k i * X i ^ r i : MvPolynomial V R)) :=
  truncIdeal_eq_span_unit_mul_X_pow R r _ fun _ =>
    (isUnit_neg_one (α := MvPolynomial V R)).pow _

/-- **Membership criterion.** A polynomial lies in the truncation ideal iff every monomial of its
support has some exponent a_i ≥ r_i. -/
theorem mem_truncIdeal {x : MvPolynomial V R} :
    x ∈ truncIdeal R r ↔ ∀ a ∈ x.support, ∃ i, r i ≤ a i := by
  rw [truncIdeal, mem_ideal_span_monomial_image]
  simp [Finsupp.single_le_iff]

/-- As an `R`-submodule, the truncation ideal is spanned by the monomials outside the box. -/
theorem restrictScalars_truncIdeal :
    (truncIdeal R r).restrictScalars R = restrictSupport R (truncBox r)ᶜ := by
  ext x
  rw [Submodule.restrictScalars_mem, mem_truncIdeal, mem_restrictSupport_iff]
  simp [Set.subset_def, truncBox]

/-- Monomials supported in a set and in its complement span complementary submodules. -/
theorem isCompl_restrictSupport_compl (s : Set (V →₀ ℕ)) :
    IsCompl (restrictSupport R s) (restrictSupport R sᶜ) := by
  constructor
  · rw [Submodule.disjoint_def]
    intro x hs hc
    rw [mem_restrictSupport_iff] at hs hc
    rw [← support_eq_empty, Finset.eq_empty_iff_forall_notMem]
    intro a ha
    exact hc ha (hs ha)
  · rw [codisjoint_iff, eq_top_iff]
    intro x _
    rw [x.as_sum]
    refine Submodule.sum_mem _ fun a _ => ?_
    by_cases ha : a ∈ s
    · exact Submodule.mem_sup_left ((monomial_mem_restrictSupport R).2 (Or.inl ha))
    · exact Submodule.mem_sup_right ((monomial_mem_restrictSupport R).2 (Or.inl ha))

/-- The box monomials span a complement of the truncation ideal. -/
theorem isCompl_truncIdeal :
    IsCompl ((truncIdeal R r).restrictScalars R) (restrictSupport R (truncBox r)) := by
  rw [restrictScalars_truncIdeal]
  exact (isCompl_restrictSupport_compl R _).symm

/-- The box monomials map isomorphically onto the truncated algebra. -/
noncomputable def truncEquiv :
    restrictSupport R (truncBox r) ≃ₗ[R] MvPolynomial V R ⧸ truncIdeal R r :=
  (Submodule.quotientEquivOfIsCompl _ _ (isCompl_truncIdeal R r)).symm ≪≫ₗ
    Submodule.Quotient.restrictScalarsEquiv R (truncIdeal R r)

/-- The truncated-algebra isomorphism sends a box polynomial to its class. -/
theorem truncEquiv_apply (x : restrictSupport R (truncBox r)) :
    truncEquiv R r x = Ideal.Quotient.mk (truncIdeal R r) (x : MvPolynomial V R) := by
  simp [truncEquiv]

/-- **Monomial basis.** The classes of the monomials w^a with a_i < r_i for all i form a basis of
R[w]/(w_i^{r_i}). -/
noncomputable def truncBasis : Module.Basis (truncBox r) R (MvPolynomial V R ⧸ truncIdeal R r) :=
  (basisRestrictSupport R (truncBox r)).map (truncEquiv R r)

/-- The basis vector indexed by a is the class of the monomial w^a. -/
theorem truncBasis_apply (a : truncBox r) :
    truncBasis R r a = Ideal.Quotient.mk (truncIdeal R r) (monomial (a : V →₀ ℕ) 1) := by
  rw [truncBasis, Module.Basis.map_apply, truncEquiv_apply]
  congr 1
  rw [← Module.Basis.repr_symm_single_one]
  change AddMonoidAlgebra.ofCoeff
    ((Finsupp.supportedEquivFinsupp (M := R) (R := R) (truncBox r)).symm (Finsupp.single a 1) :
      (V →₀ ℕ) →₀ R) = _
  rw [Finsupp.supportedEquivFinsupp_symm_single, AddMonoidAlgebra.ofCoeff_single,
    single_eq_monomial]

end Ideal

section Box

variable {V : Type*} [Finite V] (r : V → ℕ)

/-- The exponent box is the product of the ranges 0 ≤ a_i < r_i. -/
noncomputable def truncBoxEquiv : truncBox r ≃ Π i, Fin (r i) where
  toFun a i := ⟨(a : V →₀ ℕ) i, a.2 i⟩
  invFun f := ⟨Finsupp.equivFunOnFinite.symm fun i => (f i : ℕ), fun i => by simp⟩
  left_inv a := by ext; simp
  right_inv f := by ext; simp

/-- The exponent box is finite. -/
instance instFiniteTruncBox : Finite (truncBox r) := Finite.of_equiv _ (truncBoxEquiv r).symm

/-- The box has ∏_i r_i points. -/
theorem card_truncBox [Fintype V] : Nat.card (truncBox r) = ∏ i, r i := by
  rw [Nat.card_congr (truncBoxEquiv r), Nat.card_pi]
  simp

variable (R : Type*) [CommRing R]

/-- The truncated algebra is a free module. -/
instance instModuleFreeTrunc : Module.Free R (MvPolynomial V R ⧸ truncIdeal R r) :=
  Module.Free.of_basis (truncBasis R r)

/-- The truncated algebra is a finite module. -/
instance instModuleFiniteTrunc : Module.Finite R (MvPolynomial V R ⧸ truncIdeal R r) :=
  Module.Finite.of_basis (truncBasis R r)

/-- **Dimension.** R[w]/(w_i^{r_i}) is free of rank ∏_i r_i. -/
theorem finrank_truncIdeal [Fintype V] [Nontrivial R] :
    Module.finrank R (MvPolynomial V R ⧸ truncIdeal R r) = ∏ i, r i := by
  rw [Module.finrank_eq_nat_card_basis (truncBasis R r), card_truncBox]

end Box

section Nilpotent

variable {V : Type*} (R : Type*) [CommRing R] (r : V → ℕ)

/-- Each w_i is nilpotent in the truncated algebra. -/
theorem isNilpotent_mk_X (i : V) : IsNilpotent (Ideal.Quotient.mk (truncIdeal R r) (X i)) :=
  ⟨r i, by
    rw [← map_pow, Ideal.Quotient.eq_zero_iff_mem, truncIdeal_eq_span_X_pow]
    exact Ideal.subset_span ⟨i, rfl⟩⟩

/-- A polynomial without constant term becomes nilpotent in the truncated algebra. -/
theorem isNilpotent_mk_of_constantCoeff_eq_zero {p : MvPolynomial V R}
    (hp : constantCoeff p = 0) : IsNilpotent (Ideal.Quotient.mk (truncIdeal R r) p) := by
  have hspan : p ∈ Ideal.span (X '' Set.univ : Set (MvPolynomial V R)) := by
    rw [mem_ideal_span_X_image]
    intro m hm
    have hm0 : m ≠ 0 := by
      rintro rfl
      exact (mem_support_iff.1 hm) (by rw [← constantCoeff_eq, hp])
    obtain ⟨i, hi⟩ := Finsupp.ne_iff.1 hm0
    exact ⟨i, Set.mem_univ _, hi⟩
  have hle : Ideal.span (X '' Set.univ : Set (MvPolynomial V R)) ≤
      (nilradical (MvPolynomial V R ⧸ truncIdeal R r)).comap (Ideal.Quotient.mk _) := by
    rw [Ideal.span_le]
    rintro _ ⟨i, -, rfl⟩
    exact mem_nilradical.2 (isNilpotent_mk_X R r i)
  exact mem_nilradical.1 (hle hspan)

/-- Every class is a constant plus a nilpotent: [p] = p(0) + [p − p(0)]. -/
theorem mk_eq_algebraMap_add (p : MvPolynomial V R) :
    Ideal.Quotient.mk (truncIdeal R r) p =
      algebraMap R _ (constantCoeff p) +
        Ideal.Quotient.mk (truncIdeal R r) (p - C (constantCoeff p)) := by
  rw [map_sub, ← algebraMap_eq, Ideal.Quotient.mk_algebraMap, add_sub_cancel]

/-- The nonconstant part p − p(0) of a polynomial is nilpotent in the truncated algebra. -/
theorem isNilpotent_mk_sub_C (p : MvPolynomial V R) :
    IsNilpotent (Ideal.Quotient.mk (truncIdeal R r) (p - C (constantCoeff p))) :=
  isNilpotent_mk_of_constantCoeff_eq_zero R r (by simp)

/-- If every r_i is positive, the truncation ideal is proper. -/
theorem truncIdeal_ne_top [Nontrivial R] (hr : ∀ i, 0 < r i) : truncIdeal R r ≠ ⊤ := by
  rw [Ne, Ideal.eq_top_iff_one, mem_truncIdeal]
  intro h
  obtain ⟨i, hi⟩ := h 0 (mem_support_iff.2 (by simp))
  have := hr i
  simp at hi
  omega

/-- If every r_i is positive, the truncated algebra is nontrivial. -/
theorem nontrivial_quotient [Nontrivial R] (hr : ∀ i, 0 < r i) :
    Nontrivial (MvPolynomial V R ⧸ truncIdeal R r) :=
  Ideal.Quotient.nontrivial_iff.2 (truncIdeal_ne_top R r hr)

end Nilpotent

section Local

variable {V : Type*} (K : Type*) [Field K] (r : V → ℕ)

/-- **Local ring.** If every r_i is positive, K[w]/(w_i^{r_i}) is local: a class is a unit iff its
constant term is nonzero. -/
theorem isLocalRing (hr : ∀ i, 0 < r i) : IsLocalRing (MvPolynomial V K ⧸ truncIdeal K r) := by
  have := nontrivial_quotient K r hr
  refine IsLocalRing.of_isUnit_or_isUnit_one_sub_self fun x => ?_
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective x
  have hn := isNilpotent_mk_sub_C K r p
  rw [mk_eq_algebraMap_add]
  generalize Ideal.Quotient.mk (truncIdeal K r) (p - C (constantCoeff p)) = n at hn ⊢
  by_cases hc : constantCoeff p = 0
  · right
    rw [hc, map_zero, zero_add]
    exact hn.isUnit_one_sub
  · left
    exact hn.isUnit_add_left_of_commute ((isUnit_iff_ne_zero.2 hc).map _) (Commute.all _ _)

variable [IsLocalRing (MvPolynomial V K ⧸ truncIdeal K r)]

/-- The structure map from K is a local homomorphism. -/
theorem isLocalHom_algebraMap : IsLocalHom (algebraMap K (MvPolynomial V K ⧸ truncIdeal K r)) :=
  ⟨fun c hc => by
    by_cases h : c = 0
    · rw [h, map_zero] at hc
      exact absurd hc not_isUnit_zero
    · exact isUnit_iff_ne_zero.2 h⟩

/-- **Residue field.** The structure map K → κ is bijective. -/
theorem bijective_algebraMap_residueField :
    Function.Bijective
      (algebraMap K (IsLocalRing.ResidueField (MvPolynomial V K ⧸ truncIdeal K r))) := by
  refine ⟨(algebraMap K _).injective, fun y => ?_⟩
  obtain ⟨x, rfl⟩ := IsLocalRing.residue_surjective y
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective x
  refine ⟨constantCoeff p, ?_⟩
  have hn : IsLocalRing.residue _ (Ideal.Quotient.mk (truncIdeal K r) (p - C (constantCoeff p))) =
      0 := by
    rw [IsLocalRing.residue_eq_zero_iff, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    exact (isNilpotent_mk_sub_C K r p).not_isUnit
  rw [mk_eq_algebraMap_add, RingHom.map_add, hn, add_zero, IsScalarTower.algebraMap_apply K
    (MvPolynomial V K ⧸ truncIdeal K r), IsLocalRing.ResidueField.algebraMap_eq]

/-- The residue field of K[w]/(w_i^{r_i}) is K. -/
noncomputable def residueFieldEquiv :
    K ≃ₐ[K] IsLocalRing.ResidueField (MvPolynomial V K ⧸ truncIdeal K r) :=
  AlgEquiv.ofBijective (Algebra.ofId _ _) (bijective_algebraMap_residueField K r)

end Local

section Length

variable {V : Type*} (K : Type*) [Field K] (r : V → ℕ)

/-- **Length.** K[w]/(w_i^{r_i}) has length ∏_i r_i as a module over itself. If every r_i is
positive this is the length of a local Artinian ring; otherwise both sides vanish. -/
theorem length_truncIdeal [Fintype V] :
    Module.length (MvPolynomial V K ⧸ truncIdeal K r) (MvPolynomial V K ⧸ truncIdeal K r) =
      ((∏ i, r i : ℕ) : ℕ∞) := by
  by_cases hr : ∀ i, 0 < r i
  · have := isLocalRing K r hr
    have := isLocalHom_algebraMap K r
    have h := IsLocalRing.length_restrictScalars K (MvPolynomial V K ⧸ truncIdeal K r)
      (MvPolynomial V K ⧸ truncIdeal K r)
    have hres : Module.length (IsLocalRing.ResidueField K)
        (IsLocalRing.ResidueField (MvPolynomial V K ⧸ truncIdeal K r)) = 1 := by
      rw [Module.length_eq_of_surjective
        (R := IsLocalRing.ResidueField (MvPolynomial V K ⧸ truncIdeal K r)), Module.length_eq_one]
      intro y
      obtain ⟨c, rfl⟩ := (bijective_algebraMap_residueField K r).2 y
      refine ⟨IsLocalRing.residue K c, ?_⟩
      rw [IsLocalRing.ResidueField.algebraMap_residue, IsScalarTower.algebraMap_apply K
        (MvPolynomial V K ⧸ truncIdeal K r)
        (IsLocalRing.ResidueField (MvPolynomial V K ⧸ truncIdeal K r)),
        IsLocalRing.ResidueField.algebraMap_eq]
    rw [hres, mul_one, Module.length_eq_finrank, finrank_truncIdeal] at h
    rw [← h]
  · obtain ⟨i, hi⟩ := not_forall.1 hr
    have hri : r i = 0 := by omega
    have htop : truncIdeal K r = ⊤ := by
      rw [Ideal.eq_top_iff_one, truncIdeal_eq_span_X_pow]
      have h1 : (X i ^ r i : MvPolynomial V K) = 1 := by rw [hri, pow_zero]
      exact h1 ▸ Ideal.subset_span ⟨i, rfl⟩
    have : Subsingleton (MvPolynomial V K ⧸ truncIdeal K r) :=
      Ideal.Quotient.subsingleton_iff.2 htop
    rw [Module.length_eq_zero, Finset.prod_eq_zero (Finset.mem_univ i) hri, Nat.cast_zero]

end Length

section Regular

variable {V : Type*} (R : Type*) [CommRing R] (r : V → ℕ)

/-- The partial truncation ideal (w_j^{r_j} : j ∈ T) for a set T of variables. -/
noncomputable def truncIdealOn (T : Set V) : Ideal (MvPolynomial V R) :=
  Ideal.span ((fun j => (X j ^ r j : MvPolynomial V R)) '' T)

/-- Membership criterion for the partial truncation ideal. -/
theorem mem_truncIdealOn {T : Set V} {x : MvPolynomial V R} :
    x ∈ truncIdealOn R r T ↔ ∀ a ∈ x.support, ∃ j ∈ T, r j ≤ a j := by
  have hset : (fun j => (X j ^ r j : MvPolynomial V R)) '' T =
      (fun a => monomial a (1 : R)) '' ((fun j => Finsupp.single j (r j)) '' T) := by
    rw [Set.image_image]
    simp [X_pow_eq_monomial]
  rw [truncIdealOn, hset, mem_ideal_span_monomial_image]
  simp [Finsupp.single_le_iff]

/-- The full partial truncation ideal is the truncation ideal. -/
theorem truncIdealOn_univ : truncIdealOn R r Set.univ = truncIdeal R r := by
  rw [truncIdealOn, Set.image_univ, truncIdeal_eq_span_X_pow]

/-- **Colon property.** If j ∉ T, multiplication by w_j^{r_j} is injective modulo
(w_k^{r_k} : k ∈ T). -/
theorem mem_truncIdealOn_of_X_pow_mul_mem {T : Set V} {j : V} (hj : j ∉ T)
    {f : MvPolynomial V R} (h : X j ^ r j * f ∈ truncIdealOn R r T) :
    f ∈ truncIdealOn R r T := by
  classical
  rw [mem_truncIdealOn] at h ⊢
  intro a ha
  have hmem : Finsupp.single j (r j) + a ∈ (X j ^ r j * f).support := by
    rw [mem_support_iff, X_pow_eq_monomial, coeff_monomial_mul, one_mul]
    exact mem_support_iff.1 ha
  obtain ⟨k, hk, hle⟩ := h _ hmem
  have hkj : j ≠ k := fun h => hj (h ▸ hk)
  exact ⟨k, hk, by simpa [Finsupp.single_apply, hkj] using hle⟩

/-- The ideal of the list of powers is the partial truncation ideal of the listed variables. -/
theorem ofList_map_X_pow (l : List V) :
    Ideal.ofList (l.map fun j => (X j ^ r j : MvPolynomial V R)) =
      truncIdealOn R r {j | j ∈ l} := by
  unfold Ideal.ofList truncIdealOn
  congr 1
  ext x
  simp

/-- **Weakly regular sequence.** For a duplicate-free list of variables, the powers
w_j^{r_j} form a weakly regular sequence on the polynomial ring. -/
theorem isWeaklyRegular_X_pow {l : List V} (hl : l.Nodup) :
    RingTheory.Sequence.IsWeaklyRegular (MvPolynomial V R)
      (l.map fun j => (X j ^ r j : MvPolynomial V R)) := by
  classical
  refine ⟨fun i hi => ?_⟩
  have hi' : i < l.length := by simpa using hi
  have hI : (Ideal.ofList ((l.map fun j => (X j ^ r j : MvPolynomial V R)).take i) • ⊤ :
      Submodule (MvPolynomial V R) (MvPolynomial V R)) =
      truncIdealOn R r {j | j ∈ l.take i} := by
    rw [smul_eq_mul, Ideal.mul_top, ← List.map_take, ofList_map_X_pow]
  have hnot : l[i] ∉ {j | j ∈ l.take i} := by
    intro hmem
    have hdrop : l[i] ∈ l.drop i := by
      rw [List.drop_eq_getElem_cons hi']
      exact List.mem_cons_self
    exact List.disjoint_take_drop hl le_rfl hmem hdrop
  rw [hI, List.getElem_map, isSMulRegular_iff_right_eq_zero_of_smul]
  intro x hx
  obtain ⟨f, rfl⟩ := Submodule.Quotient.mk_surjective _ x
  rw [← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero, smul_eq_mul] at hx
  rw [Submodule.Quotient.mk_eq_zero]
  exact mem_truncIdealOn_of_X_pow_mul_mem R r hnot hx

/-- **Complete intersection.** If every r_i is positive and l lists the variables without
repetition, (w_j^{r_j})_{j ∈ l} is a regular sequence. -/
theorem isRegular_X_pow [Nontrivial R] (hr : ∀ i, 0 < r i) {l : List V} (hl : l.Nodup) :
    RingTheory.Sequence.IsRegular (MvPolynomial V R)
      (l.map fun j => (X j ^ r j : MvPolynomial V R)) := by
  refine ⟨isWeaklyRegular_X_pow R r hl, ?_⟩
  rw [smul_eq_mul, Ideal.mul_top, ofList_map_X_pow, ne_comm, Ne, Ideal.eq_top_iff_one,
    mem_truncIdealOn]
  intro h
  obtain ⟨j, -, hj⟩ := h 0 (mem_support_iff.2 (by simp))
  have := hr j
  simp at hj
  omega

/-- With all variables listed once, the regular sequence generates the truncation ideal. -/
theorem ofList_toList_map_X_pow [Fintype V] :
    Ideal.ofList ((Finset.univ : Finset V).toList.map fun j => (X j ^ r j : MvPolynomial V R)) =
      truncIdeal R r := by
  rw [ofList_map_X_pow, ← truncIdealOn_univ]
  congr 1
  ext j
  simp

/-- The paper's complete-intersection statement: the generators w_i^{r_i}, listed once each,
form a regular sequence when every r_i is positive. -/
theorem isRegular_toList_map_X_pow [Fintype V] [Nontrivial R] (hr : ∀ i, 0 < r i) :
    RingTheory.Sequence.IsRegular (MvPolynomial V R)
      ((Finset.univ : Finset V).toList.map fun j => (X j ^ r j : MvPolynomial V R)) :=
  isRegular_X_pow R r hr (Finset.nodup_toList _)

end Regular

end BoundaryAlgebra

namespace Multigraph

open BoundaryAlgebra MvPolynomial

variable {V E : Type*} [DecidableEq V] [DecidableEq E] [Fintype V] [Fintype E] (G : Multigraph V E)

/-- r_i = φ(d_S(i)) for every edge set S; unlike `rS_eq_phi`, no state hypothesis is needed. -/
theorem rS_eq_phi_deg (S : Finset E) (i : V) : G.rS S i = phi (G.deg S i) := by
  unfold rS
  split_ifs with h
  · rw [h]
    rfl
  · rw [phi_of_pos (Nat.pos_of_ne_zero h)]

/-- For a state, every r_i is positive (as `rS_pos`, which lives in a heavier module). -/
private theorem rS_pos_of_isState (S : Finset E) (hS : IsState G S) (i : V) : 0 < G.rS S i := by
  have := hS i
  unfold rS
  split_ifs <;> omega

/-- ∏_i r_i = wt(S) = ∏_i φ(d_S(i)) for every edge set S. -/
theorem prod_rS_eq_wt (S : Finset E) : ∏ i, G.rS S i = G.wt phi S := by
  rw [wt]
  exact Finset.prod_congr rfl fun i _ => G.rS_eq_phi_deg S i

/-- The polynomial boundary algebra 𝓑_{S,0} = ℂ[w_i : i ∈ V]/(w_i^{r_i} : i ∈ V) of a state
(`sf:local-algebra`). This is the algebraic model only; see the module docstring. -/
abbrev boundaryAlgebra (S : Finset E) : Type _ := MvPolynomial V ℂ ⧸ truncIdeal ℂ (G.rS S)

/-- The ideal of 𝓑_{S,0} is generated by the paper's (−1)^{k_i} w_i^{r_i}, k_i = d_S(i). -/
theorem truncIdeal_rS_eq_span_neg_one_pow (S : Finset E) :
    truncIdeal ℂ (G.rS S) =
      Ideal.span (Set.range fun i => ((-1) ^ G.deg S i * X i ^ G.rS S i : MvPolynomial V ℂ)) :=
  truncIdeal_eq_span_neg_one_pow_mul_X_pow ℂ (G.rS S) (G.deg S)

/-- **`sf:boundary-algebra`, dimension.** dim_ℂ 𝓑_{S,0} = wt(S), with the monomial basis
`truncBasis ℂ (G.rS S)`. -/
theorem finrank_boundaryAlgebra (S : Finset E) :
    Module.finrank ℂ (G.boundaryAlgebra S) = G.wt phi S := by
  rw [finrank_truncIdeal, prod_rS_eq_wt]

/-- For a state S, 𝓑_{S,0} is a local ring. -/
theorem isLocalRing_boundaryAlgebra (S : Finset E) (hS : IsState G S) :
    IsLocalRing (G.boundaryAlgebra S) :=
  isLocalRing ℂ (G.rS S) (G.rS_pos_of_isState S hS)

/-- **`sf:boundary-algebra`, length.** 𝓑_{S,0} has length wt(S) over itself. -/
theorem length_boundaryAlgebra (S : Finset E) :
    Module.length (G.boundaryAlgebra S) (G.boundaryAlgebra S) = G.wt phi S := by
  rw [length_truncIdeal, prod_rS_eq_wt]

/-- **`sf:boundary-algebra`, complete intersection.** For a state S, the generators w_i^{r_i},
each variable listed once, form a regular sequence in ℂ[w]; they generate the ideal of 𝓑_{S,0}
(`ofList_toList_map_X_pow`). -/
theorem isRegular_boundaryAlgebra (S : Finset E) (hS : IsState G S) :
    RingTheory.Sequence.IsRegular (MvPolynomial V ℂ)
      ((Finset.univ : Finset V).toList.map fun i => (X i ^ G.rS S i : MvPolynomial V ℂ)) :=
  isRegular_toList_map_X_pow ℂ (G.rS S) (G.rS_pos_of_isState S hS)

end Multigraph

