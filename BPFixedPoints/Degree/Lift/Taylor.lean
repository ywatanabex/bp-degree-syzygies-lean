import Mathlib

/-!
# First-order Taylor expansion for multivariate polynomials

For g over a commutative ring R and x,h:ι→R,
g(x+h)-g(x)-sum_j ∂_j g(x)h_j belongs to the ideal generated by h_j h_k.
This is used in Newton–Hensel iteration and congruence of evaluations.
-/

namespace BPFixedPoints.BP

open MvPolynomial

variable {ι R : Type*} [CommRing R] [Fintype ι] [DecidableEq ι]

/-- Ideal generated by quadratic products of components of h. -/
def quadIdeal (h : ι → R) : Ideal R := Ideal.span (Set.range fun jk : ι × ι => h jk.1 * h jk.2)

theorem mul_mem_quadIdeal (h : ι → R) (j k : ι) : h j * h k ∈ quadIdeal h :=
  Ideal.subset_span ⟨(j, k), rfl⟩

/-- First-order Taylor expansion. -/
theorem taylor_first_order (g : MvPolynomial ι R) (x h : ι → R) :
    eval (x + h) g - eval x g - ∑ j, eval x (pderiv j g) * h j ∈ quadIdeal h := by
  induction g using MvPolynomial.induction_on with
  | C a => simp [pderiv_C]
  | add p q hp hq =>
    have e : eval (x + h) (p + q) - eval x (p + q) - ∑ j, eval x (pderiv j (p + q)) * h j =
        (eval (x + h) p - eval x p - ∑ j, eval x (pderiv j p) * h j) +
        (eval (x + h) q - eval x q - ∑ j, eval x (pderiv j q) * h j) := by
      simp only [eval_add, map_add, add_mul, Finset.sum_add_distrib]; ring
    rw [e]; exact (quadIdeal h).add_mem hp hq
  | mul_X p n hp =>
    have hd : ∀ j, eval x (pderiv j (p * X n)) =
        eval x (pderiv j p) * x n + eval x p * (if n = j then 1 else 0) := by
      intro j
      rw [pderiv_mul, pderiv_X, Pi.single_apply]
      simp only [eval_add, eval_mul, eval_X]
      split_ifs <;> simp
    have hsum : ∑ j, eval x (pderiv j (p * X n)) * h j =
        (∑ j, eval x (pderiv j p) * h j) * x n + eval x p * h n := by
      simp only [hd, add_mul, Finset.sum_add_distrib, Finset.sum_mul]
      congr 1
      · exact Finset.sum_congr rfl fun j _ => by ring
      · rw [Finset.sum_eq_single n]
        · simp
        · intro j _ hj; simp [Ne.symm hj]
        · intro hn; exact absurd (Finset.mem_univ n) hn
    have e : eval (x + h) (p * X n) - eval x (p * X n) - ∑ j, eval x (pderiv j (p * X n)) * h j =
        (∑ j, eval x (pderiv j p) * h j) * h n +
        (eval (x + h) p - eval x p - ∑ j, eval x (pderiv j p) * h j) * (x n + h n) := by
      rw [hsum]
      simp only [eval_mul, eval_X, Pi.add_apply]
      ring
    rw [e]
    refine (quadIdeal h).add_mem ?_ ((quadIdeal h).mul_mem_right _ hp)
    rw [Finset.sum_mul]
    refine Ideal.sum_mem _ fun j _ => ?_
    rw [mul_assoc]
    exact (quadIdeal h).mul_mem_left _ (mul_mem_quadIdeal h j n)

/-- If c divides every h_j, then c² divides every element of the quadratic ideal. -/
theorem dvd_sq_of_mem_quadIdeal {c : R} {h : ι → R} (hc : ∀ j, c ∣ h j) {r : R}
    (hr : r ∈ quadIdeal h) : c ^ 2 ∣ r := by
  have : quadIdeal h ≤ Ideal.span {c ^ 2} := by
    rw [quadIdeal, Ideal.span_le]
    rintro _ ⟨⟨j, k⟩, rfl⟩
    rw [SetLike.mem_coe, Ideal.mem_span_singleton, pow_two]
    exact mul_dvd_mul (hc j) (hc k)
  exact Ideal.mem_span_singleton.1 (this hr)

/-- If x≡x' modulo c, then c divides g(x')-g(x). -/
theorem dvd_eval_sub_eval {c : R} {x x' : ι → R} (hc : ∀ j, c ∣ x' j - x j) (g : MvPolynomial ι R) :
    c ∣ eval x' g - eval x g := by
  have ht := taylor_first_order g x (x' - x)
  rw [add_sub_cancel] at ht
  have h1 : c ∣ ∑ j, eval x (pderiv j g) * (x' - x) j :=
    Finset.dvd_sum fun j _ => Dvd.dvd.mul_left (hc j) _
  have h2 : c ∣ eval x' g - eval x g - ∑ j, eval x (pderiv j g) * (x' - x) j :=
    (Dvd.dvd.trans (dvd_pow_self c two_ne_zero) (dvd_sq_of_mem_quadIdeal hc ht))
  have := dvd_add h2 h1
  rwa [sub_add_cancel] at this

end BPFixedPoints.BP
