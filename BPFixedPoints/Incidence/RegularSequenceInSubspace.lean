import Mathlib.RingTheory.Depth.Basic
import Mathlib.RingTheory.Regular.Category
import Mathlib.RingTheory.Ideal.AssociatedPrime.Finiteness
import Mathlib.Algebra.Module.Submodule.Union

/-! # Choosing a regular sequence from a specified subspace over an infinite field

Finite associated-prime avoidance chooses each element in the given subspace.
The quotient depth inequality supplies the induction on the desired length.
-/

namespace BPFixedPoints.ResolutionTools

open CategoryTheory RingTheory.Sequence IsSMulRegular
open scoped Pointwise
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 800000
universe u

variable {k R : Type u} [Field k] [Infinite k] [CommRing R] [Algebra k R]
  [IsNoetherianRing R]

/-- A regular element belongs to no associated prime. -/
theorem regular_notMem_associatedPrime
    (M : Type u) [AddCommGroup M] [Module R M] {r : R} (hr : IsSMulRegular M r)
    {P : Ideal R} (hP : P ∈ associatedPrimes R M) : r ∉ P := by
  intro h
  have hm : r ∈ ⋃ P ∈ associatedPrimes R M, (P : Set R) :=
    Set.mem_iUnion.mpr ⟨P, Set.mem_iUnion.mpr ⟨hP, h⟩⟩
  rw [biUnion_associatedPrimes_eq_compl_regular R M] at hm
  exact hm hr

/-- If the ideal spanned by a subspace contains a regular element, so does the subspace. -/
theorem exists_regular_in_subspace
    (L : Submodule k R) (M : Type u) [AddCommGroup M] [Module R M] [Module.Finite R M]
    (h : ∃ r ∈ Ideal.span (L : Set R), IsSMulRegular M r) :
    ∃ x ∈ L, IsSMulRegular M x := by
  classical
  have : Finite (associatedPrimes R M) := (associatedPrimes.finite R M).to_subtype
  let Q : associatedPrimes R M → Submodule k L := fun P =>
    (P.val.restrictScalars k).comap L.subtype
  have hQ : ∀ P, Q P ≠ ⊤ := by
    intro P he
    obtain ⟨r, hr, hreg⟩ := h
    have hle : Ideal.span (L : Set R) ≤ P.val := by
      apply Ideal.span_le.mpr
      intro x hx
      have hm : (⟨x, hx⟩ : L) ∈ Q P := he ▸ Submodule.mem_top
      exact hm
    exact regular_notMem_associatedPrime M hreg P.property (hle hr)
  obtain ⟨x, hx⟩ := Submodule.exists_forall_notMem_of_forall_ne_top Q hQ
  refine ⟨x.val, x.property, ?_⟩
  by_contra hn
  have hm : x.val ∈ ⋃ P ∈ associatedPrimes R M, (P : Set R) := by
    rw [biUnion_associatedPrimes_eq_compl_regular R M]
    exact hn
  obtain ⟨P, hm⟩ := Set.mem_iUnion.mp hm
  obtain ⟨hP, hm⟩ := Set.mem_iUnion.mp hm
  exact hx ⟨P, hP⟩ hm

/-- Positive I-depth supplies a regular element in I. -/
theorem exists_regular_of_depth_pos (I : Ideal R) (M : ModuleCat.{u} R)
    [Module.Finite R M] (hproper : I • (⊤ : Submodule R M) < ⊤)
    (hdepth : 0 < I.depth M) : ∃ r ∈ I, IsSMulRegular M r := by
  have hex : ∃ rs : List R, rs.length = 1 ∧ (∀ r ∈ rs, r ∈ I) ∧ IsRegular M rs := by
    apply ((ModuleCat.exists_isRegular_tfae I 1 M hproper).out 2 4).mp
    intro i hi
    have hi0 : i = 0 := by omega
    subst i
    exact ModuleCat.subsingleton_ext_of_lt_depth hdepth
  obtain ⟨rs, hlen, hmem, hreg⟩ := hex
  obtain ⟨r, rfl⟩ := List.length_eq_one_iff.mp hlen
  exact ⟨r, hmem r (by simp), ((isRegular_cons_iff M r []).mp hreg).1⟩

/-- Quotienting by an element of I preserves the properness of the submodule generated by I. -/
theorem ideal_smul_quotient_lt_top
    (I : Ideal R) (M : Type u) [AddCommGroup M] [Module R M] {r : R} (hr : r ∈ I)
    (hproper : I • (⊤ : Submodule R M) < ⊤) :
    I • (⊤ : Submodule R (QuotSMulTop r M)) < ⊤ := by
  apply lt_top_iff_ne_top.mpr
  intro h
  have hc := congrArg (Submodule.comap (Submodule.mkQ (r • (⊤ : Submodule R M)))) h
  have hle : r • (⊤ : Submodule R M) ≤ I • ⊤ := by
    rw [← Submodule.ideal_span_singleton_smul]
    exact Submodule.smul_mono_left ((Ideal.span_singleton_le_iff_mem I).mpr hr)
  rw [Submodule.comap_smul_top_of_surjective I _ (Submodule.mkQ_surjective _),
    Submodule.comap_top, Submodule.ker_mkQ, sup_eq_left.mpr hle] at hc
  exact hproper.ne hc

/-- Quotienting by a regular element lowers I-depth by at most one. -/
theorem depth_quotient_ge (I : Ideal R) (M : ModuleCat.{u} R) {r : R}
    (hr : IsSMulRegular M r) (n : ℕ) (hd : ((n + 1 : ℕ) : ℕ∞) ≤ I.depth M) :
    (n : ℕ∞) ≤ I.depth (ModuleCat.of R (QuotSMulTop r M)) := by
  let N := ModuleCat.of R (Shrink (R ⧸ I))
  have h := ModuleCat.depth_min_snd_fst_sub_one_le_trd_right N (M.smulShortComplex r)
    hr.smulShortComplex_shortExact
  change N.depth M ⊓ (N.depth M - 1) ≤ N.depth (ModuleCat.of R (QuotSMulTop r M)) at h
  change (n : ℕ∞) ≤ N.depth (ModuleCat.of R (QuotSMulTop r M))
  apply le_trans (le_inf ?_ ?_) h
  · exact (show (n : ℕ∞) ≤ ((n + 1 : ℕ) : ℕ∞) by exact_mod_cast Nat.le_succ n).trans hd
  · have ht := tsub_le_tsub_right hd 1
    simpa [Ideal.depth, N] using ht

/-- A subspace spanning I contains a regular sequence of any finite length bounded by I-depth. -/
theorem exists_regular_sequence_in_subspace
    (L : Submodule k R) (I : Ideal R) (hspan : Ideal.span (L : Set R) = I)
    (n : ℕ) (M : ModuleCat.{u} R) [Module.Finite R M]
    (hproper : I • (⊤ : Submodule R M) < ⊤) (hd : (n : ℕ∞) ≤ I.depth M) :
    ∃ rs : List R, rs.length = n ∧ (∀ r ∈ rs, r ∈ L) ∧ IsRegular M rs := by
  induction n generalizing M with
  | zero =>
    have : Nontrivial M := (Submodule.nontrivial_iff R).mp (nontrivial_of_lt _ _ hproper)
    exact ⟨[], rfl, by simp, IsRegular.nil _ _⟩
  | succ n ih =>
    have hpos : 0 < I.depth M := lt_of_lt_of_le (by exact_mod_cast Nat.succ_pos n) hd
    have he := exists_regular_of_depth_pos I M hproper hpos
    rw [← hspan] at he
    obtain ⟨x, hx, hreg⟩ := exists_regular_in_subspace L M he
    have hxI : x ∈ I := hspan ▸ Ideal.subset_span hx
    obtain ⟨rs, hlen, hmem, htail⟩ := ih (ModuleCat.of R (QuotSMulTop x M))
      (ideal_smul_quotient_lt_top I M hxI hproper) (depth_quotient_ge I M hreg n hd)
    refine ⟨x :: rs, by simp [hlen], ?_, IsRegular.cons hreg htail⟩
    intro r hr
    rcases List.mem_cons.mp hr with rfl | hr
    · exact hx
    · exact hmem r hr

end BPFixedPoints.ResolutionTools
