import BPFixedPoints.Incidence.KoszulContraction
import BPFixedPoints.Incidence.PerturbationSum
import Mathlib.RingTheory.Ideal.Quotient.Operations

/-!
# Coefficient change for Koszul contractions

Transfer the polynomial-variable contraction by a ring isomorphism to handle
independent affine equations. Its degree-zero target is the actual quotient
by the ideal generated by the transformed equations.
-/

namespace BPFixedPoints.Koszul

set_option linter.unusedSectionVars false

variable {E R A B : Type*} [LinearOrder E] [Fintype E]
  [CommRing R] [CommRing A] [CommRing B] [Algebra R A] [Algebra R B]

/-- Apply the same algebra isomorphism to every exterior coefficient. -/
noncomputable def coeffEquiv (φ : A ≃ₐ[R] B) : Space E A ≃ₗ[R] Space E B :=
  Finsupp.mapRange.linearEquiv φ.toLinearEquiv

@[simp] theorem coeffEquiv_single (φ : A ≃ₐ[R] B) (S : Finset E) (a : A) :
    coeffEquiv φ (Finsupp.single S a) = Finsupp.single S (φ a) := by
  simp [coeffEquiv, Finsupp.mapRange.linearEquiv_apply]

@[simp] theorem algEquiv_sign (φ : A ≃ₐ[R] B) (S : Finset E) (e : E) :
    φ (sign (A := A) S e) = sign (A := B) S e := by
  simp [sign]

theorem coeffEquiv_differential (φ : A ≃ₐ[R] B) (f : E → A) (x : Space E A) :
    coeffEquiv φ (differential f x) =
      differential (fun e => φ (f e)) (coeffEquiv φ x) := by
  have h : (coeffEquiv (E := E) φ).toLinearMap.comp ((differential f).restrictScalars R) =
      ((differential (fun e => φ (f e))).restrictScalars R).comp
        (coeffEquiv (E := E) φ).toLinearMap := by
    apply Finsupp.lhom_ext
    intro S a
    simp only [LinearMap.comp_apply, LinearMap.restrictScalars_apply,
      differential, LinearMap.sum_apply, LinearMap.smul_apply, erase_single,
      coeffEquiv_single, map_sum]
    apply Finset.sum_congr rfl
    intro e he
    by_cases heS : e ∈ S
    · simp [heS, Finsupp.smul_single]
    · simp [heS]
  exact LinearMap.congr_fun h x

variable {σ : Type*} [DecidableEq σ]

/-- Pivot ideal transferred by an algebra isomorphism. -/
noncomputable def transportedIdeal (ι : E → σ) (φ : MvPolynomial σ R ≃ₐ[R] A) : Ideal A :=
  Ideal.span (Set.range fun e => φ (MvPolynomial.X (ι e)))

theorem transportedIdeal_eq_map (ι : E → σ) (φ : MvPolynomial σ R ≃ₐ[R] A) :
    transportedIdeal ι φ = (variableIdeal (R := R) ι).map φ.toRingHom := by
  rw [variableIdeal, Ideal.map_span, ← Set.range_comp]
  rfl

/-- Isomorphism between the pivot quotient and the quotient by transformed equations. -/
noncomputable def transportedQuotientEquiv (ι : E → σ)
    (φ : MvPolynomial σ R ≃ₐ[R] A) :
    VariableQuotient (R := R) ι ≃ₐ[R] A ⧸ transportedIdeal ι φ :=
  Ideal.quotientEquivAlg _ _ φ (transportedIdeal_eq_map ι φ)

/-- Koszul contraction for equations isomorphic to independent variables. -/
noncomputable def transportedContraction (ι : E → σ) (hι : Function.Injective ι)
    (φ : MvPolynomial σ R ≃ₐ[R] A) :
    IncidencePerturbation.Contraction R (Space E A) (A ⧸ transportedIdeal ι φ) :=
  (variableContraction ι hι).congr (coeffEquiv φ) (transportedQuotientEquiv ι φ).toLinearEquiv

theorem transportedContraction_d (ι : E → σ) (hι : Function.Injective ι)
    (φ : MvPolynomial σ R ≃ₐ[R] A) :
    (transportedContraction ι hι φ).d =
      (differential (fun e => φ (MvPolynomial.X (ι e)))).restrictScalars R := by
  apply LinearMap.ext
  intro x
  change coeffEquiv φ (variableDifferential ι ((coeffEquiv φ).symm x)) = _
  change coeffEquiv φ (differential (fun e => MvPolynomial.X (ι e))
    ((coeffEquiv φ).symm x)) = _
  rw [coeffEquiv_differential, LinearEquiv.apply_symm_apply]
  rfl

theorem transportedContraction_p (ι : E → σ) (hι : Function.Injective ι)
    (φ : MvPolynomial σ R ≃ₐ[R] A) (x : Space E A) :
    (transportedContraction ι hι φ).p x =
      Ideal.Quotient.mk (transportedIdeal ι φ) (x ∅) := by
  change transportedQuotientEquiv ι φ
    (variableAugmentation ι ((coeffEquiv φ).symm x)) = _
  change Ideal.Quotient.mk (transportedIdeal ι φ)
    (φ (((coeffEquiv φ).symm x) ∅)) = _
  congr 1
  have h := congrArg (fun z : Space E A => z ∅) ((coeffEquiv φ).apply_symm_apply x)
  exact h

end BPFixedPoints.Koszul

namespace BPFixedPoints.IncidencePerturbation.Contraction

section Congr

variable {R M H H' : Type*} [CommRing R]
  [AddCommGroup M] [Module R M] [AddCommGroup H] [Module R H]
  [AddCommGroup H'] [Module R H']

theorem congr_refl_d (C : IncidencePerturbation.Contraction R M H) (f : H ≃ₗ[R] H') :
    (C.congr (LinearEquiv.refl R M) f).d = C.d := by
  apply LinearMap.ext
  intro x
  rfl

theorem congr_refl_p_apply (C : IncidencePerturbation.Contraction R M H)
    (f : H ≃ₗ[R] H') (x : M) :
    (C.congr (LinearEquiv.refl R M) f).p x = f (C.p x) := rfl

end Congr

variable {k R M H : Type*} [CommRing k] [CommRing R] [Algebra k R]
  [AddCommGroup M] [Module R M] [Module k M] [IsScalarTower k R M]
  [AddCommGroup H] [Module R H] [Module k H] [IsScalarTower k R H]

/-- Regard a contraction over a local coordinate ring as one over the ground field. -/
noncomputable def restrictScalars (C : IncidencePerturbation.Contraction R M H) :
    IncidencePerturbation.Contraction k M H where
  d := C.d.restrictScalars k
  i := C.i.restrictScalars k
  p := C.p.restrictScalars k
  h := C.h.restrictScalars k
  d_sq := by apply LinearMap.ext; intro x; exact LinearMap.congr_fun C.d_sq x
  d_i := by apply LinearMap.ext; intro x; exact LinearMap.congr_fun C.d_i x
  p_d := by apply LinearMap.ext; intro x; exact LinearMap.congr_fun C.p_d x
  p_i := by apply LinearMap.ext; intro x; exact LinearMap.congr_fun C.p_i x
  homotopy := by apply LinearMap.ext; intro x; exact LinearMap.congr_fun C.homotopy x
  h_sq := by apply LinearMap.ext; intro x; exact LinearMap.congr_fun C.h_sq x
  h_i := by apply LinearMap.ext; intro x; exact LinearMap.congr_fun C.h_i x
  p_h := by apply LinearMap.ext; intro x; exact LinearMap.congr_fun C.p_h x

end BPFixedPoints.IncidencePerturbation.Contraction
