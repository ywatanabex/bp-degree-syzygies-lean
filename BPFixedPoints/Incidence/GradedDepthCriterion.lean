import BPFixedPoints.Incidence.RegularGeneratorChange
import BPFixedPoints.Incidence.RegularLinearCombination
import BPFixedPoints.Incidence.DepthSurjective
import Mathlib.RingTheory.Noetherian.Basic

/-! # The depth criterion for homogeneous linear generators

Prime avoidance chooses a regular combination with nonzero leading coefficient.
Induction in its quotient and graded permutation recover the specified generators.
-/

namespace BPFixedPoints.ResolutionTools

open CategoryTheory RingTheory.Sequence
open scoped Pointwise
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1000000
universe u

variable {k : Type u} [Field k] [Infinite k]

/-- A proper ideal generated by n homogeneous linear elements of depth at least n
has the specified ordered generators as a regular sequence. -/
theorem regular_of_depth_ge_length {R : Type u} [CommRing R] [Algebra k R]
    [IsNoetherianRing R] (𝒜 : ℕ → Submodule k R) [GradedAlgebra 𝒜]
    (rs : List R) (hh : ∀ r ∈ rs, r ∈ 𝒜 1) (hI : Ideal.ofList rs ≠ ⊤)
    (hd : (rs.length : ℕ∞) ≤ (Ideal.ofList rs).depth (ModuleCat.of R R)) :
    IsRegular R rs := by
  classical
  match rs with
  | [] =>
    haveI : Nontrivial R := by
      by_contra hn
      haveI : Subsingleton R := not_nontrivial_iff_subsingleton.mp hn
      exact hI (Subsingleton.elim _ _)
    exact IsRegular.nil R R
  | x :: rs =>
    let I := Ideal.ofList (x :: rs)
    have hp : I • (⊤ : Ideal R) < ⊤ := by
      simpa only [Ideal.smul_eq_mul, Ideal.mul_top] using hI.lt_top
    have hdpos : 0 < I.depth (ModuleCat.of R R) :=
      lt_of_lt_of_le (by exact_mod_cast Nat.succ_pos rs.length) hd
    obtain ⟨c, hc, hreg⟩ := exists_regular_linear_combination (k := k) x rs
      (exists_regular_of_depth_pos I (ModuleCat.of R R) hp hdpos)
    let y : R := ∑ i, c i • (x :: rs).get i
    have hy : y ∈ 𝒜 1 :=
      Submodule.sum_mem _ (fun i _ => Submodule.smul_mem _ _ (hh _ (List.get_mem ..)))
    have he : y - c 0 • x ∈ Ideal.ofList rs := by
      have heq : y = c 0 • x + ∑ i : Fin rs.length, c i.succ • rs.get i := by
        simp [y, Fin.sum_univ_succ]
      rw [heq, add_sub_cancel_left]
      exact Submodule.sum_mem _ (fun i _ =>
        (Ideal.ofList rs).restrictScalars k |>.smul_mem _ (Ideal.subset_span (List.get_mem ..)))
    have hchange : Ideal.ofList (y :: rs) = I := ofList_head_change hc he
    have hyI : y ∈ I := hchange ▸ Ideal.subset_span (by simp)
    let J : Ideal R := Ideal.span {y}
    let S := R ⧸ J
    let q : R →+* S := Ideal.Quotient.mk J
    haveI : IsNoetherianRing S := isNoetherianRing_of_surjective R S q Ideal.Quotient.mk_surjective
    let ℬ := gradedQuotientPiece 𝒜 J
    have hJ : J.IsHomogeneous 𝒜 := Ideal.homogeneous_span 𝒜 {y} (by
      intro z hz
      obtain rfl := Set.mem_singleton_iff.mp hz
      exact ⟨1, hy⟩)
    letI : GradedAlgebra ℬ := gradedQuotientAlgebra 𝒜 J hJ
    have hJI : J ≤ I := (Ideal.span_singleton_le_iff_mem I).mpr hyI
    have hmap : I.map q = Ideal.ofList (rs.map q) := by
      rw [← hchange, Ideal.map_ofList, List.map_cons, Ideal.ofList_cons]
      have hqy : q y = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (by simp))
      simp [hqy]
    have hmapne : I.map q ≠ ⊤ := by
      intro h
      have h' := congrArg (Ideal.comap q) h
      rw [Ideal.comap_map_of_surjective q Ideal.Quotient.mk_surjective,
        Ideal.comap_top, ← RingHom.ker_eq_comap_bot] at h'
      have hk : RingHom.ker q = J := Ideal.mk_ker
      rw [hk, sup_eq_left.mpr hJI] at h'
      exact hI h'
    have hpS : I.map q • (⊤ : Ideal S) < ⊤ := by simpa using hmapne.lt_top
    have hpR : I • (⊤ : Submodule R S) < ⊤ := by
      rw [Ideal.smul_top_eq_map]
      apply lt_top_iff_ne_top.mpr
      intro h
      apply hmapne
      exact (Submodule.restrictScalars_inj R S S).mp h
    let e : QuotSMulTop y R ≃ₗ[R] S :=
      Submodule.quotEquivOfEq _ _ (by rw [← Submodule.ideal_span_singleton_smul]; simp [J])
    have hdR : (rs.length : ℕ∞) ≤ I.depth (ModuleCat.of R S) := by
      rw [← I.depth_eq_of_iso e.toModuleIso]
      exact depth_quotient_ge I (ModuleCat.of R R) hreg rs.length hd
    have hdS : ((rs.map q).length : ℕ∞) ≤
        (Ideal.ofList (rs.map q)).depth (ModuleCat.of S S) := by
      rw [List.length_map, ← hmap]
      change (rs.length : ℕ∞) ≤ (I.map (algebraMap R S)).depth (ModuleCat.of S S)
      rw [← depth_map_of_surjective (M := S) Ideal.Quotient.mk_surjective I hpR hpS]
      exact hdR
    have hhh : ∀ z ∈ rs.map q, z ∈ ℬ 1 := by
      intro z hz
      obtain ⟨w, hw, rfl⟩ := List.mem_map.mp hz
      exact Submodule.mem_map.mpr ⟨w, hh w (by simp [hw]), rfl⟩
    have htail := regular_of_depth_ge_length (R := S) ℬ (rs.map q) hhh (hmap ▸ hmapne) hdS
    have hyr : IsRegular R (y :: rs) := by
      apply IsRegular.cons hreg
      apply (e.isRegular_congr rs).mpr
      exact (regular_map_algebraMap_iff (S := S) (M := S) rs).mpr htail
    exact regular_of_homogeneous_head_change 𝒜 hh hy hyr hI he
termination_by rs.length

end BPFixedPoints.ResolutionTools
