import BPFixedPoints.Family.NonnormalizableLocusTree

/-!
# Generic smoothness of the non-normalizable locus

Let G be connected. A chart point x over (a,b) is *critical* when the Jacobian J = ∂Φ/∂x of the
chart equations has rank < |V| (`IsRegularChartPoint` fails). Then some w ≠ 0 has w·J = 0, and
u_i = w_i Φ_i satisfies, on every edge e,

  u_{fst e} (1 − a_e x_e)(a_e − x_e) + u_{snd e} x_e (a_e² − 1) = 0.

On a connected graph u vanishes nowhere, so it can be normalized to u_r = 1 at a root r
(`exists_critical_weights`). Hence critical points are points of the *critical ring*

  ℤ[a, x, w][1/(∏ a_e x_e (a_e − x_e)(1 − a_e x_e) ∏ w_v)] / (Q_e, w_r − 1)

(`CritRing`, `critRingEval`). In each prime quotient of this ring every x_e is a root of the
quadratic Q_e, whose leading coefficient w_{fst e} a_e is a unit, so the quotient is algebraic over
the subalgebra generated by the |E| + |V| − 1 elements a_e and w_v (v ≠ r)
(`critRing_quotient_isAlgebraic`). The |E| + |V| parameter functions (a, b) are therefore
algebraically dependent on every component, and one nonzero P ∈ ℤ[a,b] vanishes at the parameters
of every critical point over every field (`exists_poly_critical`).

Main result (`exists_poly_regular`): for connected G there is a nonzero P ∈ ℤ[a,b] such that for
every field K and all a, b with a_e² ≠ 1 and P(a,b) ≠ 0, every point of the chart fiber over (a,b)
is regular: the |V| × |E| Jacobian of the chart equations has rank |V|. Together with the edge
chart this is the smoothness half of `supp:nonnormalizable-dim`: the locus is the zero set of |V|
equations in an open subset of K^E with Jacobian of full rank |V| at every point, i.e. smooth of
pure dimension |E| − |V| = ν(G) − 1 by the Jacobian criterion. (No hypothesis on ν is needed here;
for trees the fiber is generically empty.)
-/

namespace BPFixedPoints

set_option linter.unusedSectionVars false

namespace Multigraph

open BP MvPolynomial

variable {V E : Type*} [DecidableEq V] [DecidableEq E] [Fintype V] [Fintype E] (G : Multigraph V E)

section Weights

variable {K : Type*} [Field K]

/-- Entry e of w·J. -/
theorem vecMul_chartJac_apply (a x : E → K) (w : V → K) (e : E) :
    Matrix.vecMul w (G.chartJac a x) e =
      w (G.fst e) * (G.chartField a x (G.fst e) / x e) +
        w (G.snd e) * (G.chartField a x (G.snd e) * (a e ^ 2 - 1) /
          ((1 - a e * x e) * (a e - x e))) := by
  simp only [Matrix.vecMul, dotProduct, chartJac, mul_add, Finset.sum_add_distrib, mul_ite,
    mul_zero, Finset.sum_ite_eq, Finset.mem_univ, ite_true]

/-- **Critical weights.** If G is connected, x is a chart point with all Φ_i ≠ 0, a_e² ≠ 1, and
w ≠ 0 satisfies w·J = 0, then some u with u_r = 1 and no zero entry satisfies the edge relations
u_{fst e}(1 − a_e x_e)(a_e − x_e) + u_{snd e} x_e (a_e² − 1) = 0. -/
theorem exists_critical_weights (hc : G.Connected) {a x : E → K} (hx : IsChartPoint a x)
    (ha : ∀ e, a e ^ 2 ≠ 1) {w : V → K} (hw0 : w ≠ 0)
    (hw : Matrix.vecMul w (G.chartJac a x) = 0) (r : V) :
    ∃ u : V → K, u r = 1 ∧ (∀ v, u v ≠ 0) ∧
      ∀ e, u (G.fst e) * (1 - a e * x e) * (a e - x e) + u (G.snd e) * x e * (a e ^ 2 - 1) = 0 := by
  set u : V → K := fun i => w i * G.chartField a x i with hu
  have hΦ := G.chartField_ne_zero hx
  have hrel : ∀ e, u (G.fst e) * (1 - a e * x e) * (a e - x e) +
      u (G.snd e) * x e * (a e ^ 2 - 1) = 0 := by
    intro e
    have h := congrFun hw e
    rw [vecMul_chartJac_apply] at h
    obtain ⟨h0, h1, h2⟩ := hx e
    have h1' : a e - x e ≠ 0 := sub_ne_zero.mpr (Ne.symm h1)
    have h2' := one_sub_mul_ne_zero h2
    simp only [Pi.zero_apply] at h
    rw [mul_div_assoc', mul_div_assoc', div_add_div _ _ h0 (mul_ne_zero h2' h1'),
      div_eq_zero_iff] at h
    have h' := h.resolve_right (mul_ne_zero h0 (mul_ne_zero h2' h1'))
    simp only [hu]
    linear_combination h'
  have hstep : ∀ e, u (G.fst e) ≠ 0 ↔ u (G.snd e) ≠ 0 := by
    intro e
    obtain ⟨h0, h1, h2⟩ := hx e
    have h1' : a e - x e ≠ 0 := sub_ne_zero.mpr (Ne.symm h1)
    have h2' := one_sub_mul_ne_zero h2
    have ha' : a e ^ 2 - 1 ≠ 0 := sub_ne_zero.mpr (ha e)
    have h := hrel e
    constructor
    · intro hf hs
      rw [hs, zero_mul, zero_mul, add_zero] at h
      exact hf (by simpa [h1', h2'] using h)
    · intro hs hf
      rw [hf, zero_mul, zero_mul, zero_add] at h
      exact hs (by simpa [h0, ha'] using h)
  obtain ⟨i₀, hi₀⟩ : ∃ i, w i ≠ 0 := by
    by_contra h
    push Not at h
    exact hw0 (funext h)
  have hu₀ : u i₀ ≠ 0 := mul_ne_zero hi₀ (hΦ i₀)
  have hall : ∀ v, u v ≠ 0 := by
    intro v
    have hpath := hc.2.2 i₀ (Finset.mem_univ _) v (Finset.mem_univ _)
    induction hpath with
    | refl => exact hu₀
    | @tail c d _ hcd ih =>
      obtain ⟨e, -, he⟩ := hcd
      rcases he with ⟨h1, h2⟩ | ⟨h1, h2⟩
      · rw [← h2]; rw [← h1] at ih; exact (hstep e).1 ih
      · rw [← h1]; rw [← h2] at ih; exact (hstep e).2 ih
  refine ⟨fun v => u v / u r, div_self (hall r), fun v => div_ne_zero (hall v) (hall r),
    fun e => ?_⟩
  have := hrel e
  calc u (G.fst e) / u r * (1 - a e * x e) * (a e - x e) +
        u (G.snd e) / u r * x e * (a e ^ 2 - 1) =
      (u r)⁻¹ * (u (G.fst e) * (1 - a e * x e) * (a e - x e) +
        u (G.snd e) * x e * (a e ^ 2 - 1)) := by ring
    _ = 0 := by rw [this, mul_zero]

end Weights

section CritRing

/-- Variables of the critical ring: inl e = a_e, inr (inl e) = x_e, inr (inr v) = w_v. -/
abbrev CritVar (E V : Type*) := E ⊕ E ⊕ V

/-- The coordinate a_e. -/
noncomputable def critA (e : E) : MvPolynomial (CritVar E V) ℤ := X (Sum.inl e)

/-- The coordinate x_e. -/
noncomputable def critX (e : E) : MvPolynomial (CritVar E V) ℤ := X (Sum.inr (Sum.inl e))

/-- The weight coordinate w_v. -/
noncomputable def critW (v : V) : MvPolynomial (CritVar E V) ℤ := X (Sum.inr (Sum.inr v))

/-- Denominator ∏_e a_e x_e (a_e − x_e)(1 − a_e x_e) · ∏_v w_v. -/
noncomputable def critDen : MvPolynomial (CritVar E V) ℤ :=
  (∏ e, critA (V := V) e * critX e * (critA e - critX e) * (1 - critA e * critX e)) *
    ∏ v, critW (E := E) v

/-- The edge relation Q_e = w_{fst e}(1 − a_e x_e)(a_e − x_e) + w_{snd e} x_e (a_e² − 1). -/
noncomputable def critRel (e : E) : MvPolynomial (CritVar E V) ℤ :=
  critW (G.fst e) * (1 - critA e * critX e) * (critA e - critX e) +
    critW (G.snd e) * critX e * (critA e ^ 2 - 1)

/-- The localized ring ℤ[a,x,w][1/critDen]. -/
abbrev CritLoc (E V : Type*) [Fintype E] [Fintype V] :=
  Localization.Away (critDen (E := E) (V := V))

/-- The ideal generated by the edge relations and w_r − 1. -/
noncomputable def critIdeal (r : V) : Ideal (CritLoc E V) :=
  Ideal.span (Set.range (fun e => algebraMap (MvPolynomial (CritVar E V) ℤ) (CritLoc E V)
    (G.critRel e)) ∪ {algebraMap (MvPolynomial (CritVar E V) ℤ) (CritLoc E V) (critW r - 1)})

/-- The critical ring ℤ[a,x,w][1/critDen]/(Q_e, w_r − 1): its points are the critical chart
points with normalized weights. -/
def CritRing (r : V) : Type _ := CritLoc E V ⧸ G.critIdeal r

noncomputable instance (r : V) : CommRing (G.CritRing r) :=
  inferInstanceAs (CommRing (CritLoc E V ⧸ G.critIdeal r))

instance (r : V) : IsNoetherianRing (G.CritRing r) :=
  inferInstanceAs (IsNoetherianRing (CritLoc E V ⧸ G.critIdeal r))

/-- The quotient map onto the critical ring. -/
noncomputable def critMk (r : V) : CritLoc E V →+* G.CritRing r :=
  Ideal.Quotient.mk (G.critIdeal r)

theorem critMk_surjective (r : V) : Function.Surjective (G.critMk r) :=
  Ideal.Quotient.mk_surjective

theorem critMk_eq_zero_of_mem {r : V} {z : CritLoc E V} (hz : z ∈ G.critIdeal r) :
    G.critMk r z = 0 :=
  Ideal.Quotient.eq_zero_iff_mem.mpr hz

theorem isUnit_critLoc_factors (e : E) :
    IsUnit (algebraMap (MvPolynomial (CritVar E V) ℤ) (CritLoc E V) (critA e)) ∧
      IsUnit (algebraMap (MvPolynomial (CritVar E V) ℤ) (CritLoc E V) (critX e)) ∧
      IsUnit (algebraMap (MvPolynomial (CritVar E V) ℤ) (CritLoc E V) (critA e - critX e)) ∧
      IsUnit (algebraMap (MvPolynomial (CritVar E V) ℤ) (CritLoc E V)
        (1 - critA e * critX e)) := by
  have h0 := IsLocalization.Away.algebraMap_isUnit (S := CritLoc E V) (critDen (E := E) (V := V))
  have h : IsUnit (algebraMap (MvPolynomial (CritVar E V) ℤ) (CritLoc E V)
      ((∏ e, critA (V := V) e * critX e * (critA e - critX e) * (1 - critA e * critX e)) *
        ∏ v, critW (E := E) v)) := h0
  rw [map_mul, IsUnit.mul_iff, map_prod, IsUnit.prod_univ_iff] at h
  have he := h.1 e
  simp only [map_mul, IsUnit.mul_iff] at he
  exact ⟨he.1.1.1, he.1.1.2, he.1.2, he.2⟩

theorem isUnit_critLoc_W (v : V) :
    IsUnit (algebraMap (MvPolynomial (CritVar E V) ℤ) (CritLoc E V) (critW v)) := by
  have h0 := IsLocalization.Away.algebraMap_isUnit (S := CritLoc E V) (critDen (E := E) (V := V))
  have h : IsUnit (algebraMap (MvPolynomial (CritVar E V) ℤ) (CritLoc E V)
      ((∏ e, critA (V := V) e * critX e * (critA e - critX e) * (1 - critA e * critX e)) *
        ∏ v, critW (E := E) v)) := h0
  rw [map_mul, IsUnit.mul_iff] at h
  have h2 := h.2
  rw [map_prod, IsUnit.prod_univ_iff] at h2
  exact h2 v

/-- Chart variables inside the critical variables. -/
def chartToCritVar : E ⊕ E → CritVar E V := Sum.map id Sum.inl

theorem isUnit_rename_chartDen :
    IsUnit (algebraMap (MvPolynomial (CritVar E V) ℤ) (CritLoc E V)
      (rename (chartToCritVar (V := V)) (chartDen (E := E) ℤ))) := by
  rw [chartDen, map_prod, map_prod, IsUnit.prod_univ_iff]
  intro e
  obtain ⟨_, hX, hAX, h1⟩ := isUnit_critLoc_factors (V := V) e
  simp only [map_mul, map_sub, map_one, rename_X, chartToCritVar, Sum.map_inl, Sum.map_inr, id]
  simp only [critA, critX, map_sub, map_mul, map_one] at hX hAX h1
  exact (hX.mul hAX).mul h1

/-- The ring map from the chart ring to the localized critical ring. -/
noncomputable def chartToCrit : ChartRing (E := E) ℤ →+* CritLoc E V :=
  Localization.awayLift ((algebraMap (MvPolynomial (CritVar E V) ℤ) (CritLoc E V)).comp
    (rename (chartToCritVar (V := V))).toRingHom) (chartDen ℤ) isUnit_rename_chartDen

/-- The parameter family (a, b) on the critical ring. -/
noncomputable def critFamily (r : V) : E ⊕ V → G.CritRing r :=
  G.critMk r ∘ chartToCrit ∘ G.chartRingFamily ℤ

end CritRing

section CritEval

variable {K : Type*} [Field K]

/-- Data of a normalized critical chart point. -/
structure IsCriticalData (r : V) (a x : E → K) (u : V → K) : Prop where
  ha : ∀ e, a e ≠ 0
  hx : IsChartPoint a x
  hu : ∀ v, u v ≠ 0
  hr : u r = 1
  hrel : ∀ e, u (G.fst e) * (1 - a e * x e) * (a e - x e) + u (G.snd e) * x e * (a e ^ 2 - 1) = 0

theorem aeval_critDen_ne_zero {r : V} {a x : E → K} {u : V → K} (h : G.IsCriticalData r a x u) :
    aeval (Sum.elim a (Sum.elim x u)) (critDen (E := E) (V := V)) ≠ 0 := by
  rw [critDen, map_mul, map_prod, map_prod]
  refine mul_ne_zero (Finset.prod_ne_zero_iff.mpr fun e _ => ?_)
    (Finset.prod_ne_zero_iff.mpr fun v _ => ?_)
  · obtain ⟨h0, h1, h2⟩ := h.hx e
    simp only [critA, critX, map_mul, map_sub, map_one, aeval_X, Sum.elim_inl, Sum.elim_inr]
    exact mul_ne_zero (mul_ne_zero (mul_ne_zero (h.ha e) h0) (sub_ne_zero.mpr (Ne.symm h1)))
      (one_sub_mul_ne_zero h2)
  · simp only [critW, aeval_X, Sum.elim_inr]
    exact h.hu v

/-- Evaluation of the localized critical ring at a normalized critical point. -/
noncomputable def critLocEval {r : V} {a x : E → K} {u : V → K} (h : G.IsCriticalData r a x u) :
    CritLoc E V →+* K :=
  Localization.awayLift (aeval (Sum.elim a (Sum.elim x u))).toRingHom critDen
    (isUnit_iff_ne_zero.mpr (G.aeval_critDen_ne_zero h))

theorem critLocEval_algebraMap {r : V} {a x : E → K} {u : V → K} (h : G.IsCriticalData r a x u)
    (p : MvPolynomial (CritVar E V) ℤ) :
    G.critLocEval h (algebraMap (MvPolynomial (CritVar E V) ℤ) (CritLoc E V) p) =
      aeval (Sum.elim a (Sum.elim x u)) p :=
  IsLocalization.Away.lift_eq _ (isUnit_iff_ne_zero.mpr (G.aeval_critDen_ne_zero h)) p

/-- Evaluation of the critical ring at a normalized critical point. -/
noncomputable def critRingEval {r : V} {a x : E → K} {u : V → K} (h : G.IsCriticalData r a x u) :
    G.CritRing r →+* K :=
  Ideal.Quotient.lift (G.critIdeal r) (G.critLocEval h) (by
    intro z hz
    have hle : G.critIdeal r ≤ RingHom.ker (G.critLocEval h) := by
      rw [critIdeal, Ideal.span_le]
      rintro _ (⟨e, rfl⟩ | hz')
      · change G.critLocEval h _ = 0
        rw [critLocEval_algebraMap]
        simpa [critRel, critA, critX, critW] using h.hrel e
      · rw [Set.mem_singleton_iff] at hz'
        subst hz'
        change G.critLocEval h _ = 0
        rw [critLocEval_algebraMap]
        simp [critW, h.hr]
    exact hle hz)

theorem critLocEval_comp_chartToCrit {r : V} {a x : E → K} {u : V → K}
    (h : G.IsCriticalData r a x u) :
    (G.critLocEval h).comp (chartToCrit (V := V)) = chartRingEval a x h.hx := by
  apply IsLocalization.ringHom_ext (Submonoid.powers (chartDen (E := E) ℤ))
  apply MvPolynomial.ringHom_ext
  · intro n
    simp
  · intro z
    simp only [RingHom.comp_apply, chartToCrit]
    rw [IsLocalization.Away.lift_eq, chartRingEval_algebraMap]
    simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe, rename_X]
    rw [critLocEval_algebraMap]
    rcases z with e | e <;> simp [chartToCritVar]

/-- At a normalized critical point the critical family evaluates to (a, −1/Φ(a,x)). -/
theorem critRingEval_comp_family {r : V} {a x : E → K} {u : V → K}
    (h : G.IsCriticalData r a x u) :
    G.critRingEval h ∘ G.critFamily r = Sum.elim a (fun i => -(G.chartField a x i)⁻¹) := by
  rw [← chartRingEval_comp_family (k := ℤ) G h.hx, ← G.critLocEval_comp_chartToCrit h]
  rfl

end CritEval


section Algebraic

/-- The |E| + |V| − 1 base elements of the critical ring: a_e and w_v for v ≠ r. -/
noncomputable def critBase (r : V) : E ⊕ {v // v ≠ r} → G.CritRing r
  | Sum.inl e => G.critMk r (algebraMap _ (CritLoc E V) (critA (V := V) e))
  | Sum.inr v => G.critMk r (algebraMap _ (CritLoc E V) (critW (E := E) v.1))

/-- Every prime quotient of the critical ring is algebraic over the subalgebra generated by the
images of a_e and w_v (v ≠ r): w_r = 1 there, and x_e is a root of the edge relation
Q_e = (w_{fst e} a_e) x_e² + (w_{snd e}(a_e² − 1) − w_{fst e}(1 + a_e²)) x_e + w_{fst e} a_e,
whose leading coefficient is a unit. -/
theorem critRing_quotient_isAlgebraic (r : V) (p : Ideal (G.CritRing r)) [p.IsPrime] :
    Algebra.IsAlgebraic (Algebra.adjoin ℤ (Set.range (Ideal.Quotient.mk p ∘ G.critBase r)))
      (G.CritRing r ⧸ p) := by
  set g : CritLoc E V →+* G.CritRing r ⧸ p :=
    (Ideal.Quotient.mk p).comp (G.critMk r) with hg_def
  have hg : Function.Surjective g :=
    Ideal.Quotient.mk_surjective.comp (G.critMk_surjective r)
  set s := Set.range (Ideal.Quotient.mk p ∘ G.critBase r)
  set A0 := Algebra.adjoin ℤ s
  have hgW_r : g (algebraMap _ (CritLoc E V) (critW (E := E) r)) = 1 := by
    have hmem : algebraMap _ (CritLoc E V) (critW (E := E) r - 1) ∈ G.critIdeal r :=
      Ideal.subset_span (Or.inr rfl)
    have h2 : G.critMk r (algebraMap _ (CritLoc E V) (critW (E := E) r)) = 1 := by
      rw [← sub_eq_zero, ← map_one (G.critMk r), ← map_sub]
      apply G.critMk_eq_zero_of_mem
      simpa only [map_sub, map_one] using hmem
    simp only [hg_def, RingHom.comp_apply, h2, map_one]
  have hA : ∀ e : E, g (algebraMap _ (CritLoc E V) (critA (V := V) e)) ∈ A0 :=
    fun e => Algebra.subset_adjoin ⟨Sum.inl e, rfl⟩
  have hW : ∀ v : V, g (algebraMap _ (CritLoc E V) (critW (E := E) v)) ∈ A0 := by
    intro v
    by_cases hv : v = r
    · subst hv
      rw [hgW_r]
      exact A0.one_mem
    · exact Algebra.subset_adjoin ⟨Sum.inr ⟨v, hv⟩, rfl⟩
  have hunitA : ∀ e : E, IsUnit (g (algebraMap _ (CritLoc E V) (critA (V := V) e))) :=
    fun e => (isUnit_critLoc_factors (V := V) e).1.map g
  have hunitW : ∀ v : V, IsUnit (g (algebraMap _ (CritLoc E V) (critW (E := E) v))) :=
    fun v => (isUnit_critLoc_W (E := E) v).map g
  have hrel : ∀ e : E, g (algebraMap _ (CritLoc E V) (G.critRel e)) = 0 := by
    intro e
    simp only [hg_def, RingHom.comp_apply]
    rw [G.critMk_eq_zero_of_mem (Ideal.subset_span (Or.inl ⟨e, rfl⟩)), map_zero]
  apply isAlgebraic_of_surjective_localizationAway g hg s
  intro z
  rcases z with e | e | v
  · exact isAlgebraic_algebraMap (⟨_, hA e⟩ : A0)
  · let α : A0 := ⟨_, hA e⟩
    let ωf : A0 := ⟨_, hW (G.fst e)⟩
    let ωs : A0 := ⟨_, hW (G.snd e)⟩
    refine ⟨Polynomial.C (ωf * α) * Polynomial.X ^ 2 +
      Polynomial.C (ωs * (α ^ 2 - 1) - ωf * (1 + α ^ 2)) * Polynomial.X +
        Polynomial.C (ωf * α), ?_, ?_⟩
    · intro h0
      have h2 := congrArg (fun q => Polynomial.coeff q 2) h0
      simp only [Polynomial.coeff_add, Polynomial.coeff_C_mul, Polynomial.coeff_X_pow,
        Polynomial.coeff_X, Polynomial.coeff_C, Polynomial.coeff_zero] at h2
      norm_num at h2
      rcases h2 with h | h
      · apply (hunitW (G.fst e)).ne_zero
        have := congrArg Subtype.val h
        simpa [ωf] using this
      · apply (hunitA e).ne_zero
        have := congrArg Subtype.val h
        simpa [α] using this
    · have h := hrel e
      simp only [critRel, map_add, map_mul, map_sub, map_pow, map_one] at h
      simp only [map_add, map_mul, Polynomial.aeval_C, Polynomial.aeval_X, map_pow,
        Subalgebra.algebraMap_eq]
      change (g (algebraMap _ (CritLoc E V) (critW (E := E) (G.fst e))) *
          g (algebraMap _ (CritLoc E V) (critA (V := V) e))) * _ ^ 2 +
        (g (algebraMap _ (CritLoc E V) (critW (E := E) (G.snd e))) *
          (g (algebraMap _ (CritLoc E V) (critA (V := V) e)) ^ 2 - 1) -
          g (algebraMap _ (CritLoc E V) (critW (E := E) (G.fst e))) *
            (1 + g (algebraMap _ (CritLoc E V) (critA (V := V) e)) ^ 2)) * _ +
        g (algebraMap _ (CritLoc E V) (critW (E := E) (G.fst e))) *
          g (algebraMap _ (CritLoc E V) (critA (V := V) e)) = 0
      simp only [critX] at h
      linear_combination h
  · exact isAlgebraic_algebraMap (⟨_, hW v⟩ : A0)

end Algebraic

section Main

/-- **Critical values lie on a hypersurface.** For connected G there is a nonzero P ∈ ℤ[a,b]
such that for every field K, every chart point x at parameters a with a_e ≠ 0 and a_e² ≠ 1 at
which the Jacobian of the chart equations has rank < |V| satisfies P(a, −1/Φ(a,x)) = 0. -/
theorem exists_poly_critical (hc : G.Connected) :
    ∃ P : MvPolynomial (E ⊕ V) ℤ, P ≠ 0 ∧
      ∀ (K : Type*) [Field K] (a x : E → K), (∀ e, a e ≠ 0) → (∀ e, a e ^ 2 ≠ 1) →
        IsChartPoint a x → ¬ G.IsRegularChartPoint a x →
          aeval (Sum.elim a (fun i => -(G.chartField a x i)⁻¹)) P = 0 := by
  obtain ⟨r, -⟩ := hc.1
  have hcard : Fintype.card (E ⊕ {v // v ≠ r}) < Fintype.card (E ⊕ V) := by
    simp only [Fintype.card_sum]
    have := Fintype.card_subtype_lt (p := fun v : V => v ≠ r) (x := r) (by simp)
    omega
  obtain ⟨P, hP, hPψ⟩ := exists_poly_forall_ringHom_eq_zero (G.critBase r) (G.critFamily r)
    hcard (fun p _ => G.critRing_quotient_isAlgebraic r p)
  refine ⟨P, hP, fun K _ a x ha0 ha hx hreg => ?_⟩
  rw [isRegularChartPoint_iff] at hreg
  push Not at hreg
  obtain ⟨w, hw, hw0⟩ := hreg
  obtain ⟨u, hur, hu0, hrel⟩ := G.exists_critical_weights hc hx ha hw0 hw r
  have h : G.IsCriticalData r a x u := ⟨ha0, hx, hu0, hur, hrel⟩
  have := hPψ K (G.critRingEval h)
  rwa [critRingEval_comp_family] at this

/-- **Generic regularity of the chart fiber.** For connected G there is a nonzero
P ∈ ℤ[a,b] such that for every field K and all a, b with a_e² ≠ 1 and P(a,b) ≠ 0, the Jacobian
of the chart equations has rank |V| at every point of the chart fiber over (a,b). -/
theorem exists_poly_regular (hc : G.Connected) :
    ∃ P : MvPolynomial (E ⊕ V) ℤ, P ≠ 0 ∧
      ∀ (K : Type*) [Field K] (a : E → K) (b : V → K), (∀ e, a e ^ 2 ≠ 1) →
        eval (Sum.elim a b) (map (Int.castRingHom K) P) ≠ 0 →
          ∀ x, G.IsChartSolution a b x → G.IsRegularChartPoint a x := by
  obtain ⟨P, hP, h⟩ := G.exists_poly_critical hc
  refine ⟨P * ∏ e, X (Sum.inl e), mul_ne_zero hP (Finset.prod_ne_zero_iff.mpr
    fun e _ => X_ne_zero _), fun K _ a b ha hab x hx => ?_⟩
  rw [map_mul, eval_mul, map_prod, eval_prod] at hab
  have ha0 : ∀ e, a e ≠ 0 := by
    intro e h0
    apply hab
    rw [Finset.prod_eq_zero (Finset.mem_univ e) (by simp [h0]), mul_zero]
  by_contra hreg
  have h0 := h K a x ha0 ha hx.1 hreg
  have hb : (fun i => -(G.chartField a x i)⁻¹) = b := by
    have := (G.isChartSolution_iff_eval (k := ℤ) hx.1).mp hx
    rw [chartRingEval_comp_family] at this
    funext i
    simpa using congrFun this (Sum.inr i)
  rw [hb, aeval_int_eq_eval_map] at h0
  exact hab (by rw [h0, zero_mul])

/-- **`supp:nonnormalizable-dim`, smoothness.** For connected G there is a nonzero
P ∈ ℤ[a,b] such that for every field K and all a, b with a_e² ≠ 1 and P(a,b) ≠ 0: every point y
of the non-normalizable locus has regular chart coordinates x_e = y_{(e,false)}, i.e. the locus,
identified with the chart fiber {x ∈ U_a : Φ(a,x) = −1/b} in the open set U_a ⊆ K^E by
`nonnormalizableChartEquiv`, is cut out by |V| equations whose Jacobian has rank |V| at every
point. -/
theorem nonnormalizable_regular (hc : G.Connected) :
    ∃ P : MvPolynomial (E ⊕ V) ℤ, P ≠ 0 ∧
      ∀ (K : Type*) [Field K] (a : E → K) (b : V → K), (∀ e, a e ^ 2 ≠ 1) →
        eval (Sum.elim a b) (map (Int.castRingHom K) P) ≠ 0 →
          ∀ y, G.IsNonnormalizableSolution a b y →
            G.IsRegularChartPoint a (fun e => y (e, false)) := by
  obtain ⟨P, hP, h⟩ := G.exists_poly_regular hc
  exact ⟨P, hP, fun K _ a b ha hab y hy =>
    h K a b ha hab _ (G.chart_of_isNonnormalizableSolution hy).2⟩

